    set_shell_config_value "$f" USE_MEMCACHED yes
    set_shell_config_value "$f" MEMCACHED_SERVERS "127.0.0.1:11211"
    set_shell_config_value "$f" MEMCACHED_PREFIX "koha_"
    set_shell_config_value "$f" ZEBRA_MARC_FORMAT marc21
    set_shell_config_value "$f" ZEBRA_LANGUAGE en
    if [ -f /etc/koha/koha-conf-site.xml.in ]; then
        sed -i 's/__MEMCACHED_SERVERS__/127.0.0.1:11211/g; s/__MEMCACHED_PREFIX__/koha_/g' /etc/koha/koha-conf-site.xml.in
    fi
