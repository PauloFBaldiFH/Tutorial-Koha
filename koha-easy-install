# ======================================================================
# 7. DIMENSIONAMENTO DE SERVIDOR
# ======================================================================
funcao_dimensionar_servidor() {
    RAM_GB=$(awk '/MemTotal:/ { printf "%.1f", $2 / 1024 / 1024 }' /proc/meminfo 2>/dev/null || echo "0")
    RAM_GB_ROUNDED=$(awk '/MemTotal:/ { printf "%d", ($2 / 1024 / 1024) + 0.5 }' /proc/meminfo 2>/dev/null || echo "0")
    
    if systemctl is-active --quiet elasticsearch 2>/dev/null; then TEXTO_ES=$(t "ES: ATIVO" "ES: ACTIVE")
    else TEXTO_ES=$(t "ES: INATIVO" "ES: INACTIVE"); fi

    if [ "$RAM_GB_ROUNDED" -lt 4 ]; then PERFIL_RECOMENDADO=1; elif [ "$RAM_GB_ROUNDED" -lt 8 ]; then PERFIL_RECOMENDADO=2; elif [ "$RAM_GB_ROUNDED" -lt 16 ]; then PERFIL_RECOMENDADO=3; else PERFIL_RECOMENDADO=4; fi

    PERFIL=$(whiptail --title "$(t "Tuning" "Sizing")" \
    --cancel-button "$(t "Voltar" "Back")" \
    --menu "$(t "RAM: ${RAM_GB} GB\n$TEXTO_ES\nRecomendado: $PERFIL_RECOMENDADO" "RAM: ${RAM_GB} GB\n$TEXTO_ES\nRecommended: $PERFIL_RECOMENDADO")" 20 76 5 \
    "1" "< 4GB  - 2 Workers, 64MB Cache, 512MB DB" \
    "2" "4–8GB  - 3 Workers, 128MB Cache, 768MB DB" \
    "3" "8–16GB - 4 Workers, 128MB Cache, 1GB DB" \
    "4" "16GB+  - 6 Workers, 256MB Cache, 2GB DB" 3>&1 1>&2 2>&3) || true

    if [ -z "$PERFIL" ]; then return 0; fi

    case "$PERFIL" in
        1) WK="2"; MEM="64"; DB="512M" ;;
        2) WK="3"; MEM="128"; DB="768M" ;;
        3) WK="4"; MEM="128"; DB="1G" ;;
        4) WK="6"; MEM="256"; DB="2G" ;;
        *) return 0 ;;
    esac

    clear
    if grep -qE '^[[:space:]]*#?[[:space:]]*PLACK_WORKERS=' /etc/default/koha-common 2>/dev/null; then sed -i -E "s|^[[:space:]]*#?[[:space:]]*PLACK_WORKERS=.*|PLACK_WORKERS=$WK|" /etc/default/koha-common; else echo "PLACK_WORKERS=$WK" >> /etc/default/koha-common; fi
    if grep -qE '^[[:space:]]*#?[[:space:]]*PLACK_MAX_REQUESTS=' /etc/default/koha-common 2>/dev/null; then sed -i -E "s|^[[:space:]]*#?[[:space:]]*PLACK_MAX_REQUESTS=.*|PLACK_MAX_REQUESTS=100|" /etc/default/koha-common; else echo "PLACK_MAX_REQUESTS=100" >> /etc/default/koha-common; fi
    if grep -qE '^[[:space:]]*-m[[:space:]]+' /etc/memcached.conf 2>/dev/null; then sed -i -E "s|^[[:space:]]*-m[[:space:]]+.*|-m $MEM|" /etc/memcached.conf; else echo "-m $MEM" >> /etc/memcached.conf; fi

    mkdir -p /etc/mysql/mariadb.conf.d/
    cat > /etc/mysql/mariadb.conf.d/99-koha-tuning.cnf << EOF
[mysqld]
innodb_buffer_pool_size = $DB
EOF

    systemctl restart memcached mariadb koha-common
    koha-plack --restart library

    whiptail --title "$(t "Sucesso" "Success")" --msgbox "$(t "Servidor ajustado (Perfil $PERFIL)!" "Server tuned (Profile $PERFIL)!")" 10 76 || true
}

# ======================================================================
# 8. CONFIGURAR NUVEM (RCLONE OTIMIZADO PARA TERMINAL)
# ======================================================================
funcao_configurar_rclone() {
    ESCOLHA=$(whiptail --title "$(t "Backup em Nuvem" "Cloud Backup")" \
    --cancel-button "$(t "Voltar" "Back")" \
    --menu "$(t "Como deseja configurar o envio automático de Backups?" "How do you want to configure auto cloud backups?")" 15 76 2 \
    "1" "$(t "Expresso (Apenas Google Drive)" "Express (Google Drive only)")" \
    "2" "$(t "Manual (Dropbox, AWS, Outras Nuvens)" "Manual (Dropbox, AWS, Other clouds)")" 3>&1 1>&2 2>&3) || true

    [ -z "$ESCOLHA" ] && return 0

    if [ "$ESCOLHA" = "1" ]; then
        whiptail --title "Google Drive Expresso" --msgbox "$(t "INSTRUÇÕES:\n1. O script vai abrir o terminal puro.\n2. Ele vai gerar um link de autorização.\n3. Copie o link e abra no navegador do seu computador.\n4. Autorize o Google e cole o 'Código de Verificação' de volta aqui." "INSTRUCTIONS:\n1. The script will open the terminal.\n2. It will generate an auth link.\n3. Copy the link and open it in your browser.\n4. Authorize Google and paste the 'Verification Code' back here.")" 15 74 || true
        clear
        echo -e "\e[1;36m$(t "Iniciando configuração expressa do Google Drive..." "Starting express Google Drive setup...")\e[0m\n"
        
        # Roda o rclone em modo interativo direto no terminal
        rclone config create gdrive drive config_is_local false || true
        
        echo -e "\n\e[1;32m$(t "Pressione [ENTER] para voltar ao painel de controle..." "Press [ENTER] to return to the control panel...")\e[0m"
        read -r
        
        NOME_CONEXAO="gdrive"
    else
        clear
        rclone config
        NOME_CONEXAO=$(whiptail --title "$(t "Nome da Conexão" "Remote Name")" --inputbox "$(t "Digite o NOME EXATO que você acabou de criar no Rclone:" "Enter the EXACT NAME you just created in Rclone:")" 10 70 3>&1 1>&2 2>&3) || true
    fi

    if [ -n "$NOME_CONEXAO" ]; then
        if rclone mkdir "$NOME_CONEXAO:Backup_SQL_Koha" 2>/dev/null; then
            sed -i "s|[a-zA-Z0-9_-]\+:Backup_SQL_Koha|$NOME_CONEXAO:Backup_SQL_Koha|g" /root/backup_sql.sh 2>/dev/null || true
            sed -i "s|RCLONE_REMOTE=\".*\"|RCLONE_REMOTE=\"$NOME_CONEXAO\"|g" /root/backup_marc.sh 2>/dev/null || true
            whiptail --title "$(t "Sucesso" "Success")" --msgbox "$(t "Nuvem ativada! Backups serão enviados para a pasta: $NOME_CONEXAO" "Cloud activated! Backups will be sent to: $NOME_CONEXAO")" 8 70 || true
        else
            whiptail --title "$(t "Erro" "Error")" --msgbox "$(t "A conexão com a nuvem falhou ou não foi autorizada." "Cloud connection failed or was not authorized.")" 8 68 || true
        fi
    fi
}

