function_configure_cloudflare() {
    msg_info "$(t "Passo 1" "Step 1" "Paso 1")" "$(t "1. Adicione um domínio no dash.cloudflare.com\n2. Mude os Nameservers no local de registro\n3. Aguarde o DNS propagar.\n\nO restante será feito automaticamente." "1. Add a domain to dash.cloudflare.com\n2. Change Nameservers at your registrar\n3. Wait for DNS propagation.\n\nThe rest is automatic." "1. Añada un dominio en dash.cloudflare.com\n2. Cambie los Nameservers en su registrador\n3. Espere la propagación de DNS.\n\nEl resto es automático.")" 14 74
    clear
    
    if ! command -v cloudflared >/dev/null 2>&1; then
        display_explanation "$(t "Instalando o cloudflared..." "Installing cloudflared..." "Instalando cloudflared...")"
        wait_for_apt_locks || return 1
        mkdir -p /etc/apt/keyrings
        curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg -o /etc/apt/keyrings/cloudflare-main.gpg || return 1
        echo "deb [signed-by=/etc/apt/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main" > /etc/apt/sources.list.d/cloudflared.list
        apt_update_indices && apt_install cloudflared || return 1
    fi

    if [ ! -f "$HOME/.cloudflared/cert.pem" ] && [ ! -f "/root/.cloudflared/cert.pem" ]; then
        msg_info "Cloudflare Tunnel" "$(t "Autorize o túnel acessando o link que aparecerá no console." "Authorize the tunnel by accessing the link in the console." "Autorice el túnel accediendo al enlace que aparecerá en la consola.")" 9 70
        clear; cloudflared tunnel login; echo ""
    fi
    [ ! -f "$HOME/.cloudflared/cert.pem" ] && [ ! -f "/root/.cloudflared/cert.pem" ] && { msg_error "$(t "Erro" "Error" "Error")" "$(t "Autorização não concluída." "Authorization incomplete." "Autorización incompleta.")"; return 1; }

    local tunnel_name="koha-library"
    cloudflared tunnel list 2>/dev/null | grep -q "$tunnel_name" || cloudflared tunnel create "$tunnel_name" >/dev/null 2>&1 || return 1
    local tunnel_id; tunnel_id=$(cloudflared tunnel list 2>/dev/null | awk -v n="$tunnel_name" '$0 ~ n {print $1; exit}')
    local cred_file; cred_file=$(find "$HOME/.cloudflared" /root/.cloudflared -name "${tunnel_id}.json" 2>/dev/null | head -n1)

    local dominio opac_sub staff_sub
    dominio=$(dialog --title "$(t "Domínio" "Domain" "Dominio")" --inputbox "$(t "Domínio ativo na Cloudflare (ex: bibliotecapalotina.org):" "Domain active in Cloudflare:" "Dominio activo en Cloudflare:")" 9 70 3>&1 1>&2 2>&3) || return 0
    opac_sub=$(dialog --title "OPAC" --inputbox "$(t "Subdomínio OPAC:" "OPAC Subdomain:" "Subdominio OPAC:")" 9 60 "catalogo" 3>&1 1>&2 2>&3) || return 0
    staff_sub=$(dialog --title "Staff" --inputbox "$(t "Subdomínio Staff:" "Staff Subdomain:" "Subdominio Staff:")" 9 60 "admin" 3>&1 1>&2 2>&3) || return 0

    mkdir -p /etc/cloudflared
    cat > /etc/cloudflared/config.yml <<EOF
tunnel: ${tunnel_id}
credentials-file: ${cred_file}
ingress:
  - hostname: ${opac_sub}.${dominio}
    service: http://localhost:80
  - hostname: ${staff_sub}.${dominio}
    service: http://localhost:8080
  - service: http_status:404
EOF

    display_explanation "$(t "Registrando DNS e reiniciando serviço..." "Registering DNS and restarting service..." "Registrando DNS y reiniciando servicio...")"
    cloudflared tunnel route dns "$tunnel_name" "${opac_sub}.${dominio}" >/dev/null 2>&1 || true
    cloudflared tunnel route dns "$tunnel_name" "${staff_sub}.${dominio}" >/dev/null 2>&1 || true

    cloudflared service uninstall >/dev/null 2>&1 || true
    cloudflared --config /etc/cloudflared/config.yml service install >/dev/null 2>&1
    systemctl enable --now cloudflared >/dev/null 2>&1
    sleep 3

    if systemctl is-active --quiet cloudflared; then
        msg_ok "$(t "TÚNEL ATIVO!\n\nOPAC: https://${opac_sub}.${dominio}\nStaff: https://${staff_sub}.${dominio}" "TUNNEL ACTIVE!\n\nOPAC: https://${opac_sub}.${dominio}\nStaff: https://${staff_sub}.${dominio}" "¡TÚNEL ACTIVO!\n\nOPAC: https://${opac_sub}.${dominio}\nStaff: https://${staff_sub}.${dominio}")" 10 70
    else
        msg_error "$(t "Erro" "Error" "Error")" "$(t "Falha ao iniciar o serviço cloudflared." "Failed to start cloudflared service." "Fallo al iniciar el servicio cloudflared.")" 9 60
    fi
}

mostrar_links_tailscale() {
