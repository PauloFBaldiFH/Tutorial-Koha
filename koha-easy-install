            "2" " 2. $(t "Checagem de integridade (CHECK)" "Integrity check (CHECK)" "Chequeo de integridad (CHECK)")" \
            "3" " 3. $(t "Análise e estatísticas (ANALYZE)" "Analysis and stats (ANALYZE)" "Análisis y estadísticas (ANALYZE)")" \
            "4" " 4. $(t "Otimização/Reparo Profundo (REPAIR)" "Deep Optimize/Repair (REPAIR)" "Optimización/Reparación profunda (REPAIR)")" 3>&1 1>&2 2>&3) || break
        
        case "$sub" in
            1) function_test_latest_backup ;;
            2|3)
                clear
                local mode="--check" title="CHECK"
                [ "$sub" = "3" ] && { mode="--analyze"; title="ANALYZE"; }
                display_explanation "$(t "Executando mysqlcheck $mode..." "Running mysqlcheck $mode..." "Ejecutando mysqlcheck $mode...")"
                local tlog="/tmp/mariadb_${title}.log"
                mysqlcheck $mode --databases "$DB_NAME" > "$tlog" 2>&1
                dialog --title "$(t "Resultado" "Result" "Resultado")" --scrolltext --textbox "$tlog" 20 80
                rm -f "$tlog"
                ;;
            4)
                prompt_yes_no "$(t "Otimizar Banco" "Optimize DB" "Optimizar Base")" "$(t "Executar REPAIR, OPTIMIZE e limpar sessões velhas?" "Run REPAIR, OPTIMIZE and clear old sessions?" "¿Ejecutar REPAIR, OPTIMIZE y limpiar sesiones viejas?")" 10 70 || continue
                clear
                exec 9>"/var/lock/koha_backup.lock"
                if ! flock -n 9; then msg_error "$(t "Erro" "Error" "Error")" "$(t "Operação bloqueada." "Operation blocked." "Operación bloqueada.")"; continue; fi
                
                display_explanation "$(t "Reparando e otimizando MariaDB..." "Repairing and optimizing MariaDB..." "Reparando y optimizando MariaDB...")"
                local rlog="${LOG_DIR}/mariadb_repair.log"
                {
                    mysqlcheck --repair --databases "$DB_NAME"
                    mysqlcheck --optimize --databases "$DB_NAME"
                    koha-shell "$INSTANCE" -c "/usr/share/koha/bin/cronjobs/cleanup_database.pl --sessions --sessdays 7 --zebraqueue 10"
                    journalctl --vacuum-time=14d
                } > "$rlog" 2>&1
                
                flock -u 9
                systemctl restart memcached >/dev/null 2>&1
                dialog --title "$(t "Otimização" "Optimization" "Optimización")" --scrolltext --textbox "$rlog" 20 80
                ;;
        esac
    done
}

