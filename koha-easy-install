# ======================================================================
# 9. ACESSO EXTERNO (CLOUDFLARE) / EXTERNAL ACCESS (CLOUDFLARE)
# ======================================================================
funcao_configurar_cloudflare() {
    TEXTO_TUTORIAL_CF="
======================================================================
 [POR] GUIA: DOMÍNIO GRÁTIS E CLOUDFLARE TUNNEL
 [EN]  GUIDE: FREE DOMAIN AND CLOUDFLARE TUNNEL
======================================================================

[POR] PARTE 1: OBTER DOMÍNIO GRATUITO (DigitalPlat ou eu.org)
[EN]  PART 1: GETTING A FREE DOMAIN (DigitalPlat or eu.org)
1. Acesse / Visit: domain.digitalplat.org (free registration / registro grátis).
2. Menu: 'Register a domain' > 'Domain registration'.
3. Escolha nome e extensão / Choose name & extension (.dpdns.org, .us.kg, .qzz.io, .xx.kg).
4. Clique 'Check availability'. Deixe os campos Name Server 1 e 2 abertos na tela.

[POR] PARTE 2: VINCULAR NA CLOUDFLARE
[EN]  PART 2: CONNECTING TO CLOUDFLARE
1. Acesse / Access: dash.cloudflare.com > 'Add a site' / 'Adicionar um site'.
2. Cole o domínio / Paste full domain (ex: bibliotecamunicipal.dpdns.org).
3. Selecione o Plano Grátis / Choose Free Plan.
4. Copie os 2 Name Servers autoritativos da Cloudflare (ns1... e ns2...).
5. Cole-os nos campos Name Server 1 e 2 do DigitalPlat e salve.
6. Na Cloudflare, clique 'Check nameservers' / 'Atualizei meus nameservers'.

[POR] PARTE 3: GERAR O TOKEN DO TÚNEL
[EN]  PART 3: GENERATING THE TUNNEL TOKEN
1. Zero Trust Dashboard: one.dash.cloudflare.com
2. Networks > Tunnels > 'Add a tunnel' (Cloudflare managed).
3. Escolha / Choose 'Debian 64-bit'.
4. Copie apenas o TOKEN alfanumérico longo (começando com eyJh...).
   Copy ONLY the long alphanumeric Token (starting with eyJh...).

CLOSE THIS WINDOW TO PASTE YOUR TOKEN AND ACTIVATE THE SERVICE!
(FECHE ESTA JANELA PARA COLAR O TOKEN E ATIVAR O SERVIÇO!)
"
    whiptail --title "Cloudflare & Domain Guide" --scrolltext "$TEXTO_TUTORIAL_CF" 30 85

    CF_TOKEN=$(whiptail --title "Token Cloudflare" --inputbox "[POR] Cole aqui o Token de Instalação (começa com eyJh...):\n[EN] Paste Installation Token here (starts with eyJh...):\n\n(Deixe em branco para cancelar / Leave empty to cancel)" 12 75 3>&1 1>&2 2>&3)

    if [ $? -ne 0 ] || [ -z "$CF_TOKEN" ]; then return; fi

    clear
    caixa_explicacao "Instalando Cloudflare Tunnel (cloudflared)..." "Installing Cloudflare Tunnel (cloudflared)..."
    if ! command -v cloudflared &> /dev/null; then
        mkdir -p --mode=0755 /etc/apt/keyrings
        curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg | tee /etc/apt/keyrings/cloudflare-main.gpg >/dev/null
        echo "deb [signed-by=/etc/apt/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared bullseye main" | tee /etc/apt/sources.list.d/cloudflared.list
        apt-get update && apt-get install -y cloudflared
    fi

    caixa_explicacao "Ativando o serviço do Túnel..." "Activating Tunnel daemon..."
    cloudflared service uninstall 2>/dev/null || true
    cloudflared service install "$CF_TOKEN"
    systemctl enable --now cloudflared

    whiptail --title "Sucesso / Success" --msgbox "[POR] Túnel ativado com sucesso!\nConfigure as rotas públicas (Public Hostnames) no painel web para as portas 80 (OPAC) e 8080 (Staff).\n\n[EN] Tunnel successfully enabled!\nConfigure Public Hostnames on the Cloudflare web dashboard targeting port 80 (OPAC) and port 8080 (Staff)." 11 74
}

