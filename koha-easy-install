# ======================================================================
# 16. CENTRAL DE SEGURANÇA / SECURITY CENTER
# ======================================================================
funcao_central_seguranca() {
    while true; do
        SEC_OPCAO=$(whiptail --title "Central de Segurança / Security Center" \
        --menu "[POR] Escolha uma ação de segurança:\n[EN] Choose a security action:" 20 84 5 \
        "1" "Status de Ameaças (Fail2ban) / Threat Status" \
        "2" "Gerenciar Firewall Staff (Porta 8080) / Manage Staff Firewall" \
        "3" "Rotacionar Senha do Banco / Rotate Database Password" \
        "4" "Voltar ao Menu Principal / Back to Main Menu" 3>&1 1>&2 2>&3) || return

        [ -z "$SEC_OPCAO" ] && return

        case $SEC_OPCAO in
            1)
                clear
                caixa_explicacao "Consultando Fail2ban..." "Querying Fail2ban..."
                F2B_SSH=$(fail2ban-client status sshd 2>/dev/null || echo "sshd jail inativo")
                F2B_APA=$(fail2ban-client status apache-auth 2>/dev/null || echo "apache-auth jail inativo")
                whiptail --title "Fail2ban Status" --msgbox "=== SSHD (Acesso Terminal) ===\n$F2B_SSH\n\n=== APACHE (Acesso Web) ===\n$F2B_APA" 24 80 --scrolltext
                ;;
            2)
                TEXTO_FW="
======================================================================
 [POR] AVISO SOBRE AS PORTAS PRINCIPAIS:
 - Porta 80 (OPAC): Catálogo Público. Deve ficar ABERTA para o mundo.
 - Porta 8080 (Staff): Painel Administrativo. Pode ser BLOQUEADA
   externamente se você usa Cloudflare Tunnel ou rede local.

 Deseja BLOQUEAR a porta 8080 para acesso externo direto (IP público)
 e permitir apenas acesso local/Cloudflare?
======================================================================
"
                if whiptail --title "Firewall Staff (8080)" --yesno "$TEXTO_FW" 18 78; then
                    ufw deny 8080/tcp >/dev/null 2>&1 || true
                    ufw allow from 127.0.0.1 to any port 8080 >/dev/null 2>&1 || true
                    whiptail --title "Firewall" --msgbox "[POR] Porta 8080 BLOQUEADA para acessos externos diretos.\n[EN] Port 8080 BLOCKED for direct external access." 8 68
                else
                    if whiptail --title "Firewall Staff (8080)" --yesno "[POR] Deseja ABRIR a porta 8080 para o mundo?\n[EN] Allow port 8080 to the world?" 8 60; then
                        ufw delete deny 8080/tcp >/dev/null 2>&1 || true
                        ufw allow 8080/tcp >/dev/null 2>&1 || true
                        whiptail --title "Firewall" --msgbox "[POR] Porta 8080 ABERTA.\n[EN] Port 8080 OPENED." 8 60
                    fi
                fi
                ;;
            3)
                if whiptail --title "Senha do Banco / DB Password" --yesno "[POR] ATENÇÃO: Isso irá gerar uma nova senha forte para o banco de dados 'koha_library', atualizar os arquivos de configuração (koha-conf.xml, backups) e reiniciar os serviços.\n\nDeseja continuar?\n\n[EN] WARNING: This will generate a new strong password, update config files, and restart services.\nContinue?" 15 78; then
                    clear
                    caixa_explicacao "Rotacionando senha do MariaDB..." "Rotating MariaDB password..."
                    
                    NOVA_SENHA=$(head /dev/urandom | tr -dc A-Za-z0-9 | head -c 20)
                    ARQUIVO_CONF="/etc/koha/sites/library/koha-conf.xml"
                    
                    if [ -f "$ARQUIVO_CONF" ]; then
                        # Atualiza no MariaDB
                        mysql -e "ALTER USER 'koha_library'@'localhost' IDENTIFIED BY '$NOVA_SENHA'; FLUSH PRIVILEGES;" 2>/dev/null || true
                        
                        # Atualiza no koha-conf.xml (substitui todas as tags <pass>)
                        sed -i "s|<pass>[^<]*</pass>|<pass>$NOVA_SENHA</pass>|g" "$ARQUIVO_CONF"
                        
                        # Atualiza no backup_sql.sh
                        sed -i "s|MYSQL_PWD='[^']*'|MYSQL_PWD='$NOVA_SENHA'|g" /root/backup_sql.sh 2>/dev/null || true
                        
                        # Atualiza credenciais
                        sed -i "s|Setup Password:.*|Setup Password: $NOVA_SENHA|g" /root/credenciais_koha.txt 2>/dev/null || true

                        systemctl restart memcached apache2 koha-common mariadb
                        koha-plack --restart library
                        
                        whiptail --title "Sucesso / Success" --msgbox "[POR] Senha rotacionada com sucesso!\n\nNova Senha: $NOVA_SENHA\n\nTodos os arquivos de configuração e de backup foram atualizados automaticamente.\n\n[EN] Password rotated successfully!" 14 74
                    else
                        whiptail --title "Erro / Error" --msgbox "[POR] Instalação do Koha não encontrada.\n[EN] Koha installation not found." 8 60
                    fi
                fi
                ;;
            4)
                return
                ;;
        esac
    done
}

