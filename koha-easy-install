# ======================================================================
# 6. ALTERNAR MOTOR DE BUSCA / TOGGLE SEARCH ENGINE (BLINDADO)
# ======================================================================
funcao_alternar_motor_busca() {
    if ! mysql -Nse "SELECT 1 FROM information_schema.tables WHERE table_schema='koha_library' AND table_name='systempreferences';" 2>/dev/null | grep -q 1; then
        whiptail --title "Aviso / Warning" --msgbox "[POR] Conclua o Web Installer no navegador antes de trocar o motor de busca.\n\n[EN] Complete the Web Installer in your browser before toggling search engines." 10 70
        return
    fi

    MOTOR_ATUAL=$(mysql -N -e "SELECT value FROM koha_library.systempreferences WHERE variable='SearchEngine';" 2>/dev/null || echo "Zebra")

    if [ "$MOTOR_ATUAL" == "Elasticsearch" ]; then
        if whiptail --title "Motor de Busca / Search Engine" --yesno "[POR] Motor atual: ELASTICSEARCH.\nDeseja voltar para o ZEBRA (Economiza ~1.5GB de RAM)?\n\n[EN] Current engine: ELASTICSEARCH.\nSwitch back to ZEBRA (Saves ~1.5GB RAM)?" 11 72; then
            clear
            caixa_explicacao "Desativando Elasticsearch e koha-worker..." "Disabling Elasticsearch and koha-worker..."
            systemctl stop elasticsearch 2>/dev/null || true
            systemctl disable elasticsearch 2>/dev/null || true
            koha_worker_gerenciar stop

            caixa_explicacao "Removendo bloco <elasticsearch> do koha-conf.xml..." "Removing <elasticsearch> block from koha-conf.xml..."
            if ! xml_set_elasticsearch remover; then
                whiptail --title "Erro / Error" --msgbox "[POR] Falha ao editar koha-conf.xml.\n[EN] Failed to edit koha-conf.xml." 8 60
                return
            fi

            caixa_explicacao "Ativando Zebra..." "Enabling Zebra..."
            koha-zebra --enable library 2>/dev/null || true
            koha-zebra --start library 2>/dev/null || true
            systemctl enable --now koha-zebra-daemon@library 2>/dev/null || true
            mysql -e "UPDATE koha_library.systempreferences SET value='Zebra' WHERE variable='SearchEngine';"
            koha-rebuild-zebra -f -v -b -a library
            koha-plack --restart library
            validar_sistema_completo "troca para Zebra" || true
            whiptail --title "Sucesso / Success" --msgbox "[POR] Sistema operando com ZEBRA!\n[EN] System is now running on ZEBRA!" 8 60
        fi
    else
        if whiptail --title "Motor de Busca / Search Engine" --yesno "[POR] Motor atual: ZEBRA.\nDeseja ativar o ELASTICSEARCH (Busca avançada e Facetas dinâmicas)?\n\n[EN] Current engine: ZEBRA.\nEnable ELASTICSEARCH (Advanced search and dynamic facets)?" 11 72; then
            clear

            caixa_explicacao "Liberando espaço em disco preventivamente..." "Freeing disk space preventively..."
            apt-get clean
            journalctl --vacuum-time=3d >/dev/null 2>&1 || true

            if ! dpkg -s koha-elasticsearch &>/dev/null; then
                caixa_explicacao "Instalando pacotes do Elasticsearch..." "Installing Elasticsearch packages..."
                apt-get update
                if ! DEBIAN_FRONTEND=noninteractive apt-get install -y elasticsearch koha-elasticsearch; then
                    whiptail --title "Erro / Error" --msgbox "[POR] Falha na instalação dos pacotes. Verifique se há espaço suficiente no disco.\n\n[EN] Failed to install packages. Check available disk space." 9 70
                    return
                fi
            fi

            caixa_explicacao "Ajustando configuração e memória do Elasticsearch..." "Tuning Elasticsearch configuration and memory..."
            mkdir -p /etc/elasticsearch/jvm.options.d
            cat << 'JVMEOF' > /etc/elasticsearch/jvm.options.d/koha.options
-Xms1g
-Xmx1g
JVMEOF

            grep -q "^discovery.type: single-node" /etc/elasticsearch/elasticsearch.yml 2>/dev/null || echo "discovery.type: single-node" >> /etc/elasticsearch/elasticsearch.yml
            grep -q "^network.host: 127.0.0.1" /etc/elasticsearch/elasticsearch.yml 2>/dev/null || echo "network.host: 127.0.0.1" >> /etc/elasticsearch/elasticsearch.yml

            /usr/share/elasticsearch/bin/elasticsearch-plugin install --batch analysis-icu 2>/dev/null || true

            caixa_explicacao "Iniciando e aguardando serviço do Elasticsearch..." "Starting and waiting for Elasticsearch service..."
            systemctl daemon-reload
            systemctl enable elasticsearch
            systemctl restart elasticsearch

            ES_OK=false
            for i in {1..45}; do
                if curl -s http://127.0.0.1:9200 >/dev/null 2>&1; then
                    ES_OK=true
                    break
                fi
                sleep 1
            done

            if [ "$ES_OK" = false ]; then
                whiptail --title "Erro / Error" --msgbox "[POR] O serviço Elasticsearch não conseguiu inicializar na porta 9200.\nVerifique o espaço em disco com 'df -h' e os logs com:\njournalctl -u elasticsearch -n 50\n\n[EN] Elasticsearch failed to start on port 9200.\nCheck disk space with 'df -h' and logs with:\njournalctl -u elasticsearch -n 50" 14 74
                systemctl stop elasticsearch 2>/dev/null || true
                systemctl disable elasticsearch 2>/dev/null || true
                return
            fi

            caixa_explicacao "Inserindo bloco <elasticsearch> no koha-conf.xml..." "Inserting <elasticsearch> block into koha-conf.xml..."
            if ! xml_set_elasticsearch inserir; then
                whiptail --title "Erro / Error" --msgbox "[POR] Falha ao editar koha-conf.xml.\n[EN] Failed to edit koha-conf.xml." 8 60
                systemctl stop elasticsearch 2>/dev/null || true
                systemctl disable elasticsearch 2>/dev/null || true
                return
            fi

            caixa_explicacao "Desativando Zebra..." "Disabling Zebra..."
            systemctl stop koha-zebra-daemon@library 2>/dev/null || true
            systemctl disable koha-zebra-daemon@library 2>/dev/null || true
            koha-zebra --stop library 2>/dev/null || true
            koha-zebra --disable library 2>/dev/null || true

            mysql -e "UPDATE koha_library.systempreferences SET value='Elasticsearch' WHERE variable='SearchEngine';"
            mysql -e "UPDATE koha_library.systempreferences SET value='1' WHERE variable='ElasticsearchCommitImmediately';"
            curl -s -X DELETE 'localhost:9200/koha_library_biblios' >/dev/null 2>&1 || true
            curl -s -X DELETE 'localhost:9200/koha_library_authorities' >/dev/null 2>&1 || true
            systemctl restart koha-common

            caixa_explicacao "Ativando koha-worker (processa a fila de background jobs, incluindo indexacao Elasticsearch)..." "Enabling koha-worker (processes the background jobs queue, including Elasticsearch indexing)..."
            koha_worker_gerenciar start

            caixa_explicacao "Reindexando acervo para a nuvem do Elasticsearch..." "Reindexing catalog..."
            if ! koha-elasticsearch --rebuild -d library; then
                whiptail --title "Aviso / Warning" --msgbox "[POR] Reindexação falhou. Rode depois: koha-elasticsearch --rebuild -d library\n[EN] Reindexing failed. Run later: koha-elasticsearch --rebuild -d library" 9 70
            fi

            koha-plack --restart library

            if koha_worker_esta_rodando; then
                MSG_INDEXER_PT="Daemon koha-worker está ativo: registros catalogados a partir de agora serão propagados automaticamente para o índice em segundos a poucos minutos (via fila de background jobs, sem precisar de RabbitMQ)."
                MSG_INDEXER_EN="koha-worker daemon is active: records catalogued from now on will be propagated to the index automatically within seconds to a few minutes (via the background jobs queue, no RabbitMQ required)."
            else
                MSG_INDEXER_PT="ATENÇÃO: koha-worker não foi confirmado rodando. Registros novos podem NÃO aparecer na busca até um novo reindex manual. Verifique com: pgrep -af background_jobs_worker"
                MSG_INDEXER_EN="WARNING: koha-worker could not be confirmed running. New records may NOT appear in search until a manual reindex. Check with: pgrep -af background_jobs_worker"
            fi

            validar_sistema_completo "ativação do Elasticsearch" || true
            whiptail --title "Sucesso / Success" --msgbox "[POR] Sistema operando com ELASTICSEARCH!\n$MSG_INDEXER_PT\n\n[EN] System is now running on ELASTICSEARCH!\n$MSG_INDEXER_EN" 13 78
        fi
    fi
}

# ======================================================================
# 7. DIMENSIONAMENTO DE SERVIDOR / SERVER TUNING
# ======================================================================
funcao_dimensionar_servidor() {
    RAM_GB=$(awk '/MemTotal:/ { printf "%.1f", $2 / 1024 / 1024 }' /proc/meminfo 2>/dev/null || echo "0")
    RAM_GB_ROUNDED=$(awk '/MemTotal:/ { printf "%d", ($2 / 1024 / 1024) + 0.5 }' /proc/meminfo 2>/dev/null || echo "0")
    ES_INSTALADO=false
    ES_ATIVO=false
    if dpkg -s koha-elasticsearch >/dev/null 2>&1 || dpkg -s elasticsearch >/dev/null 2>&1; then
        ES_INSTALADO=true
    fi
    if systemctl is-active --quiet elasticsearch 2>/dev/null; then
        ES_ATIVO=true
    fi

    if [ "$RAM_GB_ROUNDED" -lt 4 ]; then
        PERFIL_RECOMENDADO=1
    elif [ "$RAM_GB_ROUNDED" -lt 8 ]; then
        PERFIL_RECOMENDADO=2
    elif [ "$RAM_GB_ROUNDED" -lt 16 ]; then
        PERFIL_RECOMENDADO=3
    else
        PERFIL_RECOMENDADO=4
    fi

    if [ "$ES_ATIVO" = true ]; then
        TEXTO_ES="Elasticsearch: ATIVO / ACTIVE (mantido)"
    elif [ "$ES_INSTALADO" = true ]; then
        TEXTO_ES="Elasticsearch: instalado, mas inativo / installed, inactive"
    else
        TEXTO_ES="Elasticsearch: não instalado / not installed"
    fi

    PERFIL=$(whiptail --title "Tuning / Sizing" \
    --menu "[POR] RAM detectada: ${RAM_GB} GB\n${TEXTO_ES}\n\nPerfil recomendado automaticamente: ${PERFIL_RECOMENDADO}\n\n[EN] Detected RAM: ${RAM_GB} GB\n${TEXTO_ES}\n\nAutomatically recommended profile: ${PERFIL_RECOMENDADO}" 20 82 5 \
    "1" "Até 4GB  - 2 Plack Workers, 64MB Cache, 512MB DB" \
    "2" "4–8GB   - 3 Plack Workers, 128MB Cache, 768MB DB" \
    "3" "8–16GB  - 4 Plack Workers, 128MB Cache, 1GB DB" \
    "4" "16GB+    - 6 Plack Workers, 256MB Cache, 2GB DB" \
    "5" "Cancelar / Cancel" 3>&1 1>&2 2>&3)

    if [ $? -ne 0 ] || [ "$PERFIL" = "5" ]; then return; fi

    case "$PERFIL" in
        1) WK="2"; MEM="64"; DB="512M" ;;
        2) WK="3"; MEM="128"; DB="768M" ;;
        3) WK="4"; MEM="128"; DB="1G" ;;
        4) WK="6"; MEM="256"; DB="2G" ;;
        *) return ;;
    esac

    if [ "$ES_ATIVO" = true ]; then
        whiptail --title "Elasticsearch ativo / Elasticsearch active" --yesno \
            "[POR] O Elasticsearch está ativo e será mantido.\n\nPerfil escolhido: $PERFIL\nPlack: $WK workers\nMemcached: ${MEM}MB\nMariaDB InnoDB: $DB\n\nAplicar estes valores e reiniciar os serviços?\n\n[EN] Elasticsearch is active and will be kept.\n\nSelected profile: $PERFIL\nPlack: $WK workers\nMemcached: ${MEM}MB\nMariaDB InnoDB: $DB\n\nApply these values and restart the services?" 16 76 || return
    fi

    clear

    if grep -qE '^[[:space:]]*#?[[:space:]]*PLACK_WORKERS=' /etc/default/koha-common 2>/dev/null; then
        sed -i -E "s|^[[:space:]]*#?[[:space:]]*PLACK_WORKERS=.*|PLACK_WORKERS=$WK|" /etc/default/koha-common
    else
        echo "PLACK_WORKERS=$WK" >> /etc/default/koha-common
    fi

    if grep -qE '^[[:space:]]*#?[[:space:]]*PLACK_MAX_REQUESTS=' /etc/default/koha-common 2>/dev/null; then
        sed -i -E "s|^[[:space:]]*#?[[:space:]]*PLACK_MAX_REQUESTS=.*|PLACK_MAX_REQUESTS=100|" /etc/default/koha-common
    else
        echo "PLACK_MAX_REQUESTS=100" >> /etc/default/koha-common
    fi

    if grep -qE '^[[:space:]]*-m[[:space:]]+' /etc/memcached.conf 2>/dev/null; then
        sed -i -E "s|^[[:space:]]*-m[[:space:]]+.*|-m $MEM|" /etc/memcached.conf
    else
        echo "-m $MEM" >> /etc/memcached.conf
    fi

    mkdir -p /etc/mysql/mariadb.conf.d/
    cat > /etc/mysql/mariadb.conf.d/99-koha-tuning.cnf << EOF
[mysqld]
innodb_buffer_pool_size = $DB
EOF

    systemctl restart memcached mariadb koha-common
    koha-plack --restart library

    if validar_sistema_completo "tuning"; then
        whiptail --title "Sucesso / Success" --msgbox \
            "[POR] Servidor ajustado com perfil $PERFIL.\n\nRAM detectada: ${RAM_GB}GB\nPlack: $WK workers\nMemcached: ${MEM}MB\nMariaDB InnoDB: $DB\nElasticsearch: $TEXTO_ES\n\nServiços reiniciados com sucesso.\n\n[EN] Server tuned with profile $PERFIL.\n\nDetected RAM: ${RAM_GB}GB\nPlack: $WK workers\nMemcached: ${MEM}MB\nMariaDB InnoDB: $DB\nElasticsearch: $TEXTO_ES\n\nServices restarted successfully." 16 76
    else
        whiptail --title "Erro / Error" --msgbox \
            "[POR] O tuning foi gravado, mas MariaDB ou Memcached não ficou ativo.\nVerifique: systemctl status mariadb memcached\n\n[EN] Tuning was written, but MariaDB or Memcached is not active.\nCheck: systemctl status mariadb memcached" 12 76
    fi
}

