funcao_backup_manual() {
    TEXTO_DICA=$(t "======================================================================\n DICAS DE ONDE SALVAR:\n - Pendrive/USB: Navegue até as pastas /media ou /mnt\n - SCP: Salve na sua pasta padrão e use: scp root@IP:$REAL_HOME/... .\n======================================================================" "======================================================================\n SAVE DESTINATIONS:\n - USB: Browse to /media or /mnt\n - SCP: Save to your folder and use: scp root@IP:$REAL_HOME/... .\n======================================================================")
    whiptail --title "$(t "Destino do Backup" "Backup Destination")" --msgbox "$TEXTO_DICA" 13 76

    DIR_DESTINO=$(selecionar_diretorio "$REAL_HOME")
    if [ -z "$DIR_DESTINO" ]; then return; fi

    DATA_ATUAL=$(date +%Y-%m-%d_%Hh%M)
    ARQUIVO_DESTINO="$DIR_DESTINO/koha_library_manual_$DATA_ATUAL.sql.gz"

    ARQUIVO_CONF="/etc/koha/sites/library/koha-conf.xml"
    if [ ! -f "$ARQUIVO_CONF" ]; then
        whiptail --title "$(t "Erro" "Error")" --msgbox "$(t "O Koha ainda não foi instalado." "Koha has not been installed yet.")" 8 60
        return
    fi
    DB_PASS=$(grep -oP '(?<=<pass>)[^<]+' "$ARQUIVO_CONF" | head -n 1)
    DB_USER="koha_library"

    clear
    caixa_explicacao "Gerando backup compactado em $ARQUIVO_DESTINO..." "Generating compressed backup..."

    if MYSQL_PWD="$DB_PASS" mysqldump -u"$DB_USER" "koha_library" | gzip > "$ARQUIVO_DESTINO"; then
        whiptail --title "$(t "Sucesso" "Success")" --msgbox "$(t "Backup gerado em:\n$ARQUIVO_DESTINO" "Backup generated in:\n$ARQUIVO_DESTINO")" 10 74
    else
        whiptail --title "$(t "Erro" "Error")" --msgbox "$(t "Falha ao tentar gerar o arquivo de backup." "Failed to generate backup file.")" 8 65
    fi
}

