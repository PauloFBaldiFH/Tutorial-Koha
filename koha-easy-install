# ======================================================================
# 22. DIMENSIONAMENTO DO SERVIDOR (TUNING)
# ======================================================================
function_size_server() {
    local ram_int recommended profile wk mem db
    ram_int=$(awk '/MemTotal:/ {printf "%d", ($2/1024/1024)+0.5}' /proc/meminfo)
    if   [ "$ram_int" -lt 4 ];  then recommended=1
    elif [ "$ram_int" -lt 8 ];  then recommended=2
    elif [ "$ram_int" -lt 16 ]; then recommended=3
    else recommended=4; fi
    
    profile=$(dialog --title "Tuning" --default-item "$recommended" --menu "$(t "Perfil recomendado: $recommended" "Recommended profile: $recommended")" 14 74 4 \
        "1" "< 4 GB  (2 Plack, 64M Memcached, 512M InnoDB)" \
        "2" "4-8 GB  (3 Plack, 128M Memcached, 768M InnoDB)" \
        "3" "8-16 GB (4 Plack, 128M Memcached, 1G InnoDB)" \
        "4" "16 GB+  (6 Plack, 256M Memcached, 2G InnoDB)" 3>&1 1>&2 2>&3) || return 0
    
    case "$profile" in
        1) wk=2; mem=64;  db=512M ;;
        2) wk=3; mem=128; db=768M ;;
        3) wk=4; mem=128; db=1G ;;
        4) wk=6; mem=256; db=2G ;;
        *) return 0 ;;
    esac

    clear
    display_explanation "Aplicando perfil $profile..." "Applying profile $profile..."
    
    set_shell_config_value /etc/default/koha-common PLACK_WORKERS "$wk"
    set_shell_config_value /etc/default/koha-common PLACK_MAX_REQUESTS "100"
    sed -i -E "s/^[[:space:]]*-m[[:space:]]+.*/-m $mem/" /etc/memcached.conf
    
    mkdir -p /etc/mysql/mariadb.conf.d
    local tuning="/etc/mysql/mariadb.conf.d/99-koha-tuning.cnf"
    printf '[mysqld]\ninnodb_buffer_pool_size = %s\n' "$db" > "$tuning"
    
    systemctl restart memcached >/dev/null 2>&1
    if ! systemctl restart mariadb; then
        rm -f "$tuning"; systemctl restart mariadb >/dev/null 2>&1
        msg_error "" "MariaDB não aceitou o ajuste ($db). Revertido." 9 60; return 1
    fi
    
    systemctl restart koha-common >/dev/null 2>&1
    koha-plack --restart "$INSTANCE" >/dev/null 2>&1
    [ "$(get_search_engine)" = "Elasticsearch" ] && { adjust_elasticsearch_heap; systemctl restart elasticsearch >/dev/null 2>&1; }
    
    msg_ok "Tuning aplicado: Plack=$wk | Mem=$mem | MariaDB=$db" 8 60
}

