function_autoupdate() {
    prompt_yes_no "$(t "Atualizar Painel" "Update Panel" "Actualizar Panel")" "$(t "Baixar a última versão do painel do GitHub?" "Download the latest panel version from GitHub?" "¿Descargar la última versión del panel desde GitHub?")" 8 60 || return 0
