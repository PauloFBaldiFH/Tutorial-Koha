# ======================================================================
# 16. CENTRAL DE SEGURANÇA
# ======================================================================
funcao_central_seguranca() {
    while true; do
        SEC_OPCAO=$(whiptail --title "$(t "Segurança" "Security")" \
        --cancel-button "$(t "Voltar" "Back")" \
        --menu "$(t "Ações:" "Actions:")" 16 76 3 \
        "1" "$(t "Status Fail2ban" "Fail2ban Status")" \
        "2" "$(t "Firewall Staff (8080)" "Staff Firewall")" \
        "3" "$(t "Rotacionar Senha do Banco" "Rotate Database Password")" 3>&1 1>&2 2>&3) || true

        if [ -z "$SEC_OPCAO" ]; then return 0; fi

        case $SEC_OPCAO in
            1)
                clear
                F2B_SSH=$(fail2ban-client status sshd 2>/dev/null || echo "sshd inativo")
                whiptail --title "Fail2ban" --msgbox "$F2B_SSH" 15 70 || true
                ;;
            2)
                if whiptail --title "Firewall (8080)" --yesno "$(t "Bloquear acesso externo à porta 8080?" "Block external access to 8080?")" 10 70; then
                    ufw deny 8080/tcp >/dev/null 2>&1 || true
                    ufw allow from 127.0.0.1 to any port 8080 >/dev/null 2>&1 || true
                else
                    ufw delete deny 8080/tcp >/dev/null 2>&1 || true
                    ufw allow 8080/tcp >/dev/null 2>&1 || true
                fi
                ;;
            3)
                if whiptail --title "$(t "Senha" "Password")" --yesno "$(t "Gerar nova senha forte?" "Generate new strong password?")" 10 70; then
                    NOVA_SENHA=$(head /dev/urandom | tr -dc A-Za-z0-9 | head -c 20)
                    ARQUIVO_CONF="/etc/koha/sites/library/koha-conf.xml"
                    mysql -e "ALTER USER 'koha_library'@'localhost' IDENTIFIED BY '$NOVA_SENHA'; FLUSH PRIVILEGES;" 2>/dev/null || true
                    sed -i "s|<pass>[^<]*</pass>|<pass>$NOVA_SENHA</pass>|g" "$ARQUIVO_CONF" 2>/dev/null || true
                    sed -i "s|MYSQL_PWD='[^']*'|MYSQL_PWD='$NOVA_SENHA'|g" /root/backup_sql.sh 2>/dev/null || true
                    systemctl restart memcached apache2 koha-common mariadb
                    koha-plack --restart library
                    whiptail --title "$(t "Sucesso" "Success")" --msgbox "$(t "Nova Senha: $NOVA_SENHA" "New Password: $NOVA_SENHA")" 10 70 || true
                fi
                ;;
        esac
    done
}

