# ======================================================================
# 3. RESTAURAR BANCO DE DADOS
# ======================================================================
funcao_restaurar_banco() {
    TEXTO_DICA=$(t "======================================================================\n DICAS DE TRANSFERÊNCIA (Como colocar o arquivo no servidor):\n - Pendrive/USB: Geralmente aparecem nas pastas /media ou /mnt\n - SCP (Terminal Linux/Mac/Win): scp seu_backup.sql root@$(hostname -I | awk '{print $1}'):$REAL_HOME/\n======================================================================" "======================================================================\n TRANSFER TIPS:\n - USB: Usually in /media or /mnt\n - SCP (Linux/Mac/Win): scp your_backup.sql root@$(hostname -I | awk '{print $1}'):$REAL_HOME/\n======================================================================")
    whiptail --title "$(t "Origem do Arquivo" "File Source")" --msgbox "$TEXTO_DICA" 13 76

    LOCAL_ARQUIVO=$(selecionar_arquivo "$REAL_HOME")
    if [ -z "$LOCAL_ARQUIVO" ]; then return; fi

    if ! whiptail --title "$(t "Confirmar Restauração" "Confirm Restore")" --yesno "$(t "Arquivo selecionado:\n$LOCAL_ARQUIVO\n\nATENÇÃO: O acervo atual será totalmente substituído pelo backup.\nDeseja continuar?" "Selected file:\n$LOCAL_ARQUIVO\n\nWARNING: Current catalog will be replaced by the backup.\nDo you want to proceed?")" 14 74; then
        return
    fi

    clear
    caixa_explicacao "Recriando banco de dados koha_library..." "Recreating koha_library database..."
    mysql -e "DROP DATABASE IF EXISTS koha_library; CREATE DATABASE koha_library;"

    caixa_explicacao "Importando acervo ($LOCAL_ARQUIVO)..." "Importing catalog ($LOCAL_ARQUIVO)..."
    if [[ "$LOCAL_ARQUIVO" == *.gz ]]; then
        zcat "$LOCAL_ARQUIVO" | mysql koha_library
    else
        mysql koha_library < "$LOCAL_ARQUIVO"
    fi

    caixa_explicacao "Atualizando schemas e reiniciando daemons..." "Upgrading schemas and restarting daemons..."
    systemctl restart memcached
    koha-upgrade-schema library

    caixa_explicacao "Sincronizando Motor de Busca..." "Synchronizing Search Engine..."
    if dpkg -s koha-elasticsearch >/dev/null 2>&1 && koha_es_ativo_no_xml; then
        MOTOR_REAL="Elasticsearch"
    else
        MOTOR_REAL="Zebra"
    fi

    mysql -e "UPDATE koha_library.systempreferences SET value='$MOTOR_REAL' WHERE variable='SearchEngine';"
    systemctl restart memcached

    if [ "$MOTOR_REAL" = "Elasticsearch" ]; then
        koha_broker_preparar || true
        systemctl restart koha-common
        koha_indexadores_gerenciar start
        curl -s -X DELETE 'localhost:9200/koha_library_biblios' >/dev/null 2>&1 || true
        curl -s -X DELETE 'localhost:9200/koha_library_authorities' >/dev/null 2>&1 || true
        TS_REBUILD=$(date '+%Y-%m-%d %H:%M:%S')
        koha-elasticsearch --rebuild -d library || true
        mysql -e "UPDATE koha_library.background_jobs SET status='cancelled' WHERE type='update_elastic_index' AND status='new' AND enqueued_on < '$TS_REBUILD';" 2>/dev/null || true
    else
        systemctl enable --now koha-zebra-daemon@library 2>/dev/null || true
        koha-zebra --start library 2>/dev/null || true
        koha-rebuild-zebra -f -v -b -a library
    fi

    koha-plack --restart library
    whiptail --title "$(t "Sucesso" "Success")" --msgbox "$(t "Acervo restaurado e indexado!\nMotor ativado: $MOTOR_REAL." "Database restored and indexed!\nEngine enabled: $MOTOR_REAL.")" 10 74
}

# ======================================================================
# 4. GERAR BACKUP MANUAL DO BANCO
