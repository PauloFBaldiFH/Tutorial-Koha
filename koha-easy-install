# ======================================================================
function_create_superlibrarian() {
    require_database || return 0
    local branch cat_ user pass hash user_sql card_sql hash_sql branch_sql cat_sql cardnumber
    
    branch=$(run_sql_checked "SELECT branchcode FROM ${DB_NAME}.branches LIMIT 1;")
    cat_=$(run_sql_checked "SELECT categorycode FROM ${DB_NAME}.categories WHERE category_type='S' LIMIT 1;")
    [ -z "$cat_" ] && cat_=$(run_sql_checked "SELECT categorycode FROM ${DB_NAME}.categories LIMIT 1;")
    
    if [ -z "$branch" ] || [ -z "$cat_" ]; then
        msg_error "$(t "Erro" "Error" "Error")" "$(t "Conclua o Web Installer primeiro para criar bibliotecas e categorias." "Finish Web Installer first to create branches and categories." "Termine el Web Installer primero para crear bibliotecas y categorías.")" 9 70; return 0
    fi
    
    user=$(dialog --title "$(t "Usuário" "User" "Usuario")" --inputbox "Login:" 9 60 3>&1 1>&2 2>&3) || return 0
    [ -z "$user" ] && return 0
    if [ "$(run_sql_checked "SELECT COUNT(*) FROM ${DB_NAME}.borrowers WHERE userid='${user}';")" -gt 0 ]; then
        msg_error "$(t "Erro" "Error" "Error")" "$(t "Usuário já existe." "User already exists." "El usuario ya existe.")"; return 0
    fi

    cardnumber=$(dialog --title "$(t "Cartão" "Card" "Tarjeta")" --inputbox "$(t "Número do cartão:" "Card number:" "Número de tarjeta:")" 9 60 3>&1 1>&2 2>&3) || return 0
    pass=$(dialog --title "$(t "Senha" "Password" "Contraseña")" --passwordbox "$(t "Senha (mín 8 char):" "Password (min 8 char):" "Contraseña (mín 8 char):")" 9 60 3>&1 1>&2 2>&3) || return 0
    [ "${#pass}" -lt 8 ] && { msg_error "$(t "Erro" "Error" "Error")" "$(t "Senha curta." "Password too short." "Contraseña demasiado corta.")"; return 0; }

    clear
    display_explanation "$(t "Gerando hash da senha e inserindo no banco..." "Hashing password and inserting into database..." "Generando hash y insertando en la base de datos...")"
    cat > /tmp/koha_hash.pl << 'EOF'
use strict; use warnings; use Koha::AuthUtils qw(hash_password);
my $pw = <STDIN>; chomp $pw; print hash_password($pw);
EOF
    hash=$(printf '%s\n' "$pass" | koha-shell "$INSTANCE" -c "perl /tmp/koha_hash.pl" 2>/dev/null)
    rm -f /tmp/koha_hash.pl
    [ -z "$hash" ] && { msg_error "$(t "Erro" "Error" "Error")" "$(t "Falha ao gerar hash." "Failed to generate hash." "Fallo al generar hash.")"; return 1; }

    user_sql=$(sql_escape_literal "$user"); card_sql=$(sql_escape_literal "$cardnumber")
    hash_sql=$(sql_escape_literal "$hash"); branch_sql=$(sql_escape_literal "$branch")
    cat_sql=$(sql_escape_literal "$cat_")

    if mysql -e "INSERT INTO ${DB_NAME}.borrowers (userid, cardnumber, password, surname, firstname, branchcode, categorycode, flags) VALUES ('$user_sql', '$card_sql', '$hash_sql', 'Admin', 'Super', '$branch_sql', '$cat_sql', 1);" 2>/dev/null; then
        msg_ok "$(t "Superbibliotecário $user criado com sucesso!" "Superlibrarian $user created successfully!" "¡Superbibliotecario $user creado con éxito!")" 8 60
    else
        msg_error "$(t "Erro" "Error" "Error")" "$(t "Falha ao inserir usuário no banco." "Failed to insert user into database." "Fallo al insertar usuario en la base de datos.")" 8 60
    fi
}

# ======================================================================
# 27. CENTRAL DE SEGURANÇA E ROTAÇÃO DE SENHAS
# ======================================================================
function_security_center() {
    while true; do
        local opc; opc=$(dialog --title "$(t "Segurança" "Security" "Seguridad")" --no-tags --menu "$(t "Ações:" "Actions:" "Acciones:")" 14 70 4 \
            "1" " 1. $(t "Status Fail2ban" "Fail2ban Status" "Estado Fail2ban")" \
            "2" " 2. $(t "Staff na Internet (8080)" "Staff on the Internet (8080)" "Staff en Internet (8080)")" \
            "3" " 3. $(t "Rotacionar senha do Banco" "Rotate DB Password" "Rotar Contraseña BD")" \
            "4" " 4. $(t "Regras UFW" "UFW Rules" "Reglas UFW")" 3>&1 1>&2 2>&3) || return 0
        
        case "$opc" in
            1)
                local info=""; for j in sshd apache-auth apache-badbots; do info="${info}=== ${j} ===\n$(fail2ban-client status "$j" 2>/dev/null)\n\n"; done
                dialog --title "Fail2ban" --scrolltext --msgbox "$info" 20 70
                ;;
            2)
                if prompt_yes_no "$(t "Staff Externo" "External Staff" "Staff Externo")" "$(t "Liberar a porta 8080 para a internet toda?" "Expose port 8080 to the whole internet?" "¿Exponer el puerto 8080 a toda internet?")" 8 60; then
                    ufw allow 8080/tcp >/dev/null 2>&1; msg_ok "$(t "8080 Exposta." "8080 Exposed." "8080 Expuesta.")" 8 40
                else
                    ufw delete allow 8080/tcp >/dev/null 2>&1; ufw allow from 127.0.0.1 to any port 8080 proto tcp >/dev/null 2>&1; msg_ok "$(t "8080 Restrita à LAN." "8080 Restricted to LAN." "8080 Restringida a LAN.")" 8 40
                fi
                ;;
            3)
                require_koha || continue
                prompt_yes_no "$(t "Rotacionar" "Rotate" "Rotar")" "$(t "Gerar nova senha forte para o banco de dados?" "Generate new strong password for the database?" "¿Generar nueva contraseña fuerte para la base de datos?")" 8 60 || continue
                clear
                local new_pass old_pass xml_bak
                new_pass=$(python3 -c 'import secrets,string; print("".join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))')
                old_pass=$(get_database_password)
                
                xml_bak="${KOHA_CONF}.bak-$(date +%s)"
                cp -f "$KOHA_CONF" "$xml_bak" || continue
                
                if mysql -e "ALTER USER '${DB_NAME}'@'localhost' IDENTIFIED BY '${new_pass}'; FLUSH PRIVILEGES;"; then
                    sed -i "s|<pass>[^<]*</pass>|<pass>${new_pass}</pass>|g" "$KOHA_CONF"
                    systemctl restart memcached koha-common >/dev/null 2>&1
                    koha-plack --restart "$INSTANCE" >/dev/null 2>&1
                    sed -i "s|Senha   / Password    : .*|Senha   / Password    : ${new_pass}|" /root/credenciais_koha.txt 2>/dev/null
                    msg_ok "$(t "Senha do banco alterada: $new_pass" "Database password changed: $new_pass" "Contraseña de la base de datos cambiada: $new_pass")" 8 60
                else
                    msg_error "$(t "Erro" "Error" "Error")" "$(t "Falha ao rotacionar no MariaDB." "Failed to rotate in MariaDB." "Fallo al rotar en MariaDB.")" 8 60
                fi
                ;;
            4) dialog --title "UFW" --scrolltext --msgbox "$(ufw status verbose 2>/dev/null)" 20 70 ;;
        esac
    done
}

