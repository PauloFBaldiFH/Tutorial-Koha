koha-shell "$INSTANCE" -c "perl $EXPORT_SCRIPT --record-type=bibs --format=marc --filename=$BIBLIOS_FILE" >/dev/null 2>&1
koha-shell "$INSTANCE" -c "perl $EXPORT_SCRIPT --record-type=auths --format=marc --filename=$AUTHS_FILE" >/dev/null 2>&1

tar -czf "$ARCHIVE_FILE" -C "$BACKUP_DIR" "$(basename "$BIBLIOS_FILE")" "$(basename "$AUTHS_FILE")"
rm -f "$BIBLIOS_FILE" "$AUTHS_FILE"

if [ -f /root/.config/rclone/rclone.conf ]; then
  /usr/bin/rclone copy "$ARCHIVE_FILE" "$RCLONE_REMOTE:$RCLONE_FOLDER" >/dev/null 2>&1 || true
fi
find "$BACKUP_DIR" -name "koha_marc_*.tar.gz" -mtime "+$KEEP_LOCAL_DAYS" -delete
EOF
    chmod +x /root/backup_sql.sh /root/backup_marc.sh
    chmod 600 /root/backup_sql.sh

    cat << 'EOF' > /etc/cron.d/koha_tasks
# ======================================================================
# KOHA EASY INSTALL - TAREFAS AUTOMÁTICAS (CRONJOBS)
# ======================================================================
# COMO AJUSTAR A HORA / HOW TO CHANGE TIME:
# A ordem das colunas é: MINUTO HORA DIA_MES MES DIA_SEMANA(0=Dom) comando
# Exemplo: "30 01 * * *" significa "Todo dia às 01:30 da madrugada"
# ======================================================================

# 1. Limpeza de logs do sistema a cada 14 dias (Roda meia-noite e meia)
30 0 * * * root /usr/bin/journalctl --vacuum-time=14d >/dev/null 2>&1

# 2. Reparo e otimização de corrupção do banco (Roda às 05:01 da manhã)
0 1 5 * * root /usr/bin/mysqlcheck --check --auto-repair --databases koha_library >/dev/null 2>&1

# 3. Reinício preventivo da interface web/Plack para liberar memória (Roda às 05:00 da manhã)
0 5 * * * root /usr/sbin/koha-plack --restart library >/dev/null 2>&1

# 4. BACKUP AUTOMÁTICO DE SQL E ENVIO PARA NUVEM (Roda às 23:00)
# Altere o "00 23" para o horário que preferir (ex: "30 18" para 18:30)
00 23 * * * root /bin/bash /root/backup_sql.sh >/dev/null 2>&1

# 5. BACKUP DE REGISTROS MARC21 (Roda aos Domingos às 03:00 da manhã)
0 3 * * 0 root /bin/bash /root/backup_marc.sh >/dev/null 2>&1

# 6. Limpeza de sessões travadas e filas antigas do Koha (Roda às 01:30 da manhã)
30 1 * * * root koha-shell library -c "/usr/share/koha/bin/cronjobs/cleanup_database.pl --sessions --zebraqueue 10" >/dev/null 2>&1

# BEGIN KOHA EMAIL NOTICES
# 7. Disparo de e-mails de atraso e envio da fila de mensagens (Roda às 08:00 e 08:05)
00 08 * * * root koha-shell library -c "/usr/share/koha/bin/cronjobs/overdue_notices.pl -v -t" >/dev/null 2>&1
05 08 * * * root koha-shell library -c "/usr/share/koha/bin/cronjobs/process_message_queue.pl -v" >/dev/null 2>&1
# END KOHA EMAIL NOTICES
EOF
    chmod 644 /etc/cron.d/koha_tasks
