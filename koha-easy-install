# ======================================================================
# 8. ACESSO EXTERNO SEGURO (CLOUDFLARE TUNNEL)
# ======================================================================
funcao_configurar_cloudflare() {
    TEXTO_TUTORIAL_CF="
======================================================================
 PASSO A PASSO: ACESSO EXTERNO (CLOUDFLARE + DOMÍNIO GRÁTIS)
======================================================================

Para expor sua biblioteca para a internet sem abrir portas no roteador
e com HTTPS gratuito, você precisa de um Domínio e do Cloudflare Tunnel.

PARTE 1: CONSEGUIR UM DOMÍNIO GRATUITO (DigitalPlat ou eu.org)
O eu.org é muito bom, mas pode demorar a aprovar. O DigitalPlat é imediato:
1. Acesse domain.digitalplat.org e crie uma conta gratuita.
2. No menu lateral esquerdo, clique em 'Register a domain' > 'Domain registration'.
3. Digite o nome escolhido para a biblioteca e escolha uma extensão
   (ex: .dpdns.org, .us.kg, .qzz.io ou .xx.kg).
4. Clique em 'Check availability'. Se estiver disponível, aparecerão os campos
   de Name Server 1 até 4. MANTENHA ESSA PÁGINA ABERTA.

PARTE 2: VINCULAR À CLOUDFLARE
1. Em outra aba, acesse o painel da Cloudflare e clique em 'Adicionar um site'.
2. Cole o nome completo do subdomínio criado (ex: bibliotecamunicipal.dpdns.org).
3. Selecione o Plano Gratuito (Free) no final da página.
4. A Cloudflare fornecerá 2 servidores de nome (ex: ns1.cloudflare.com).
5. Volte à aba do DigitalPlat, cole o 1º no 'Name Server 1' e o 2º no 'Name Server 2'. Salve.
6. De volta à Cloudflare, clique em 'Atualizei meus nameservers'.

PARTE 3: GERAR O TOKEN DO TÚNEL
1. No painel da Cloudflare, vá em Zero Trust > Networks > Tunnels.
2. Clique em 'Create a tunnel' (Cloudflare) e dê um nome.
3. Na tela de instalação, escolha seu ambiente (Debian/64-bit).
4. Copie APENAS o código enorme (Token) que começa com 'eyJh...'

AO FECHAR ESTA TELA, O SCRIPT PEDIRÁ O TOKEN PARA FINALIZAR A INSTALAÇÃO!
"
    whiptail --title "Tutorial Cloudflare & Domínio" --scrolltext "$TEXTO_TUTORIAL_CF" 30 85

    CF_TOKEN=$(whiptail --title "Ativação do Cloudflare Tunnel" --inputbox "[POR] Cole aqui o Token de Instalação (começa com eyJh...):\nDeixe em branco para cancelar." 10 75 3>&1 1>&2 2>&3)

    if [ $? -ne 0 ] || [ -z "$CF_TOKEN" ]; then return; fi

    clear
    caixa_explicacao "Instalando Cloudflare Tunnel (cloudflared)..." "Installing Cloudflare Tunnel (cloudflared)..."
    if ! command -v cloudflared &> /dev/null; then
        mkdir -p --mode=0755 /etc/apt/keyrings
        curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg | tee /etc/apt/keyrings/cloudflare-main.gpg >/dev/null
        echo "deb [signed-by=/etc/apt/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared bullseye main" | tee /etc/apt/sources.list.d/cloudflared.list
        apt-get update && apt-get install -y cloudflared
    fi

    caixa_explicacao "Ativando o Túnel Seguro..." "Activating Secure Tunnel..."
    cloudflared service uninstall 2>/dev/null || true
    cloudflared service install "$CF_TOKEN"
    systemctl enable --now cloudflared

    whiptail --title "Sucesso" --msgbox "[POR] Túnel configurado com sucesso!\nO servidor já está conectado à Cloudflare. Configure as rotas (Public Hostname) no painel web para as portas 80 e 8080." 9 70
}

# ======================================================================
# 9. ATUALIZAR SISTEMA
# ======================================================================
funcao_atualizar_sistema() {
    whiptail --title "Atualização" --msgbox "[POR] Baixando atualizações do Ubuntu e do Koha." 8 60
    clear
    apt-get update -y && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y
    koha-upgrade-schema library || true
    systemctl restart memcached apache2 koha-common mariadb
    koha-plack --restart library
    whiptail --title "Sucesso" --msgbox "Sistema atualizado!" 8 60
}

