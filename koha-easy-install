    [ -z "$ts_hostname" ] && { msg_error "$(t "Erro" "Error" "Error")" "$(t "Tailscale offline ou sem IP." "Tailscale offline or no IP." "Tailscale sin conexión o sin IP.")"; return 1; }
    local funnel_status; funnel_status=$(tailscale funnel status 2>&1)
    local t="$(t "DOMÍNIO TAILSCALE:\nhttps://${ts_hostname}\n\n" "TAILSCALE DOMAIN:\nhttps://${ts_hostname}\n\n" "DOMINIO TAILSCALE:\nhttps://${ts_hostname}\n\n")"
    
    echo "$funnel_status" | grep -q '127\.0\.0\.1:80\b' && t+="✅ OPAC:  https://${ts_hostname}\n" || t+="⬜ OPAC:  $(t "não publicado" "not published" "no publicado")\n"
    echo "$funnel_status" | grep -q '127\.0\.0\.1:8080\b' && t+="✅ Staff: https://${ts_hostname}:8443\n" || t+="⬜ Staff: $(t "não publicado" "not published" "no publicado")\n"
