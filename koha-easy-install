        sed -i "s|[a-zA-Z0-9_-]\+:Backup_SQL_Koha|${REMOTE_ESCOLHIDO}:Backup_SQL_Koha|g" /root/backup_sql.sh 2>/dev/null || true
        sed -i "s|RCLONE_REMOTE=\".*\"|RCLONE_REMOTE=\"${REMOTE_ESCOLHIDO}\"|g" /root/backup_marc.sh 2>/dev/null || true

        whiptail --title "Sucesso / Success" --msgbox "[POR] Nuvem vinculada e testada com sucesso!\nDestino ativo: ${REMOTE_ESCOLHIDO}:\nOs backups diários (SQL) e semanais (MARC) usarão essa pasta automaticamente.\n\n[EN] Cloud linked and tested successfully!\nActive remote: ${REMOTE_ESCOLHIDO}:\nDaily (SQL) and weekly (MARC) backups will use this folder automatically." 13 76
