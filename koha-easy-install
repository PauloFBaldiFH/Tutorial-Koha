# ======================================================================
# 11. CRIAR SUPERBIBLIOTECÁRIO
# ======================================================================
funcao_criar_superbibliotecario() {
    clear
    if ! command -v koha-list >/dev/null 2>&1 || ! koha-list 2>/dev/null | grep -qx library; then
        whiptail --title "$(t "Erro" "Error")" --msgbox "$(t "Instância não encontrada." "Instance not found.")" 8 60; return
    fi

    BRANCH=$(mysql -Nse "SELECT branchcode FROM koha_library.branches LIMIT 1;" 2>/dev/null || true)
    CAT=$(mysql -Nse "SELECT categorycode FROM koha_library.categories LIMIT 1;" 2>/dev/null || true)

    if [ -z "$BRANCH" ] || [ -z "$CAT" ]; then
        whiptail --title "$(t "Erro" "Error")" --msgbox "$(t "Conclua o Web Installer primeiro." "Complete Web Installer first.")" 8 60; return
    fi

    NOVO_USER=$(whiptail --title "$(t "Usuário" "Username")" --inputbox "$(t "NOME DE USUÁRIO (login):" "USERNAME (login):")" 10 60 3>&1 1>&2 2>&3)
    [ -z "$NOVO_USER" ] && return

    NOVA_SENHA=$(whiptail --title "$(t "Senha" "Password")" --inputbox "$(t "SENHA para $NOVO_USER:" "PASSWORD for $NOVO_USER:")" 10 60 3>&1 1>&2 2>&3)
    [ -z "$NOVA_SENHA" ] && return

    cat << 'EOF' > /tmp/hash_pass.pl
use strict;
use warnings;
use Koha::AuthUtils qw(hash_password);
print hash_password($ARGV[0]);
EOF
    HASH=$(koha-shell library -c "perl /tmp/hash_pass.pl '$NOVA_SENHA'" 2>/dev/null)
    rm -f /tmp/hash_pass.pl

    if [ -n "$HASH" ]; then
        mysql -e "INSERT INTO koha_library.borrowers (userid, password, surname, firstname, branchcode, categorycode, flags) VALUES ('$NOVO_USER', '$HASH', 'Admin', 'Super', '$BRANCH', '$CAT', 1);" 2>/dev/null
        whiptail --title "$(t "Sucesso" "Success")" --msgbox "$(t "Superbibliotecário criado!" "Super Librarian created!")" 8 60
    fi
}

# ======================================================================
# 12. ACESSO EXTERNO (CLOUDFLARE TUNNEL)
# ======================================================================
funcao_configurar_cloudflare() {
    local texto_cf=$(t "Para expor seu Koha para a internet com total segurança:\n\n1. Acesse o painel Cloudflare Zero Trust na web.\n2. Vá em Networks > Tunnels > Create a tunnel.\n3. Escolha 'Cloudflared' e avance.\n4. Na tela de instalação (Escolha Debian/Ubuntu), copie o código inteiro gerado lá.\n\nNa próxima tela, você pode colar o comando inteiro ou apenas o token." "To safely expose your Koha to the internet:\n\n1. Access the Cloudflare Zero Trust dashboard.\n2. Go to Networks > Tunnels > Create a tunnel.\n3. Choose 'Cloudflared' and proceed.\n4. On the setup screen (Debian), copy the entire generated command.\n\nPaste the full command or just the token on the next screen.")
    whiptail --title "Cloudflare Tunnel (Zero Trust)" --msgbox "$texto_cf" 16 76

    CF_INPUT=$(whiptail --title "Token Cloudflare" --inputbox "$(t "Cole aqui o Token ou o comando inteiro (sudo cloudflared...):" "Paste the Token or the entire install command here:")" 10 76 3>&1 1>&2 2>&3)
    [ -z "$CF_INPUT" ] && return

    # Extrai inteligentemente apenas a string do token usando regex caso a pessoa tenha copiado o texto completo da web
    CF_TOKEN=$(echo "$CF_INPUT" | grep -oE 'ey[a-zA-Z0-9_-]{40,}' | head -n 1)

    if [ -z "$CF_TOKEN" ]; then
        whiptail --title "$(t "Erro de Validação" "Validation Error")" --msgbox "$(t "Nenhum token válido foi encontrado no texto colado. O token da Cloudflare sempre começa com 'eyJ'." "No valid token found in the pasted text. It must start with 'eyJ'.")" 10 76
        return
    fi

    clear
    caixa_explicacao "Instalando e vinculando o Cloudflare Tunnel..." "Installing and linking Cloudflare Tunnel..."
    if ! command -v cloudflared &> /dev/null; then
        mkdir -p --mode=0755 /etc/apt/keyrings
        curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg | tee /etc/apt/keyrings/cloudflare-main.gpg >/dev/null
        echo "deb [signed-by=/etc/apt/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main" | tee /etc/apt/sources.list.d/cloudflared.list
        apt-get update -y >/dev/null 2>&1 || true
        apt_instalar_com_retry cloudflared
    fi

    cloudflared service uninstall 2>/dev/null || true
    cloudflared service install "$CF_TOKEN"
    systemctl enable --now cloudflared
    whiptail --title "$(t "Sucesso" "Success")" --msgbox "$(t "Túnel ativado! Agora vincule o IP local (127.0.0.1:80 e :8080) lá no painel da Cloudflare." "Tunnel enabled! Now map the local IP (127.0.0.1:80 and :8080) in the Cloudflare dashboard.")" 10 76
}

