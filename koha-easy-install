#!/bin/bash
# ======================================================================
# KOHA EASY INSTALL - ADVANCED MANAGEMENT SUITE
# Suíte completa de implantação, manutenção, tuning e backups.
# ======================================================================

set -e
set -o pipefail

# ======================================================================
# DETECÇÃO AUTOMÁTICA DE IDIOMA
# ======================================================================
if echo "${LANG:-}" | grep -qiE "^pt"; then
    SYS_LANG="pt"
else
    SYS_LANG="en"
fi

t() {
    if [ "$SYS_LANG" = "pt" ]; then
        echo -e "$1"
    else
        echo -e "$2"
    fi
}

# ======================================================================
# ELEVAÇÃO AUTOMÁTICA DE PRIVILÉGIOS
# ======================================================================
if [ "$EUID" -ne 0 ]; then
  echo -e "\n+-----------------------------------------------------------------------------------------+"
  echo -e "| $(t "Privilégios de administrador (root) necessários. Digite sua senha:" "Root privileges required. Please enter your password:")"
  echo -e "+-----------------------------------------------------------------------------------------+\n"
  
  if [ -f "$0" ]; then
    exec sudo bash "$0" "$@"
  else
    echo "$(t "ERRO: Execute como root: 'sudo bash ...'" "ERROR: Run with root privileges: 'sudo bash ...'")"
    exit 1
  fi
fi

REAL_USER="${SUDO_USER:-$USER}"
REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
[ -z "$REAL_HOME" ] && REAL_HOME="/home/$REAL_USER"

# ======================================================================
# IMPORTAÇÃO DE MÓDULOS REMOTOS DO GITHUB
# ======================================================================
source <(curl -s https://raw.githubusercontent.com/PauloFBaldiFH/Tutorial-Koha/refs/heads/main/languages-list)
source <(curl -s https://raw.githubusercontent.com/PauloFBaldiFH/Tutorial-Koha/refs/heads/main/searchengine-swap)

# ======================================================================
# FUNÇÕES DE INTERFACE E EXPLORADOR
# ======================================================================
caixa_explicacao() {
    local msg="$(t "$1" "$2")"
    echo -e "\n+-----------------------------------------------------------------------------------------+"
    echo -e "| $msg"
    echo -e "+-----------------------------------------------------------------------------------------+\n"
}

selecionar_arquivo() {
    local atual="${1:-/}"
    while true; do
        local itens=()
        if [ "$atual" != "/" ]; then
            itens+=(".." "$(t "[Voltar para o diretorio anterior]" "[Back to previous directory]")")
        fi
        
        while IFS= read -r d; do
            [ -z "$d" ] && continue
            itens+=("$d" "$(t "[Pasta]" "[Folder]")")
        done <<< "$(find "$atual" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)"
        
        while IFS= read -r f; do
            [ -z "$f" ] && continue
            itens+=("$f" "Backup Database")
        done <<< "$(find "$atual" -mindepth 1 -maxdepth 1 -type f \( -name "*.sql" -o -name "*.sql.gz" \) -printf '%f\n' 2>/dev/null | sort)"

        if [ ${#itens[@]} -eq 0 ]; then
            itens+=(".." "$(t "[Diretório Vazio - Voltar]" "[Empty Directory - Go back]")")
        fi

        escolha=$(whiptail --title "$(t "Explorador de Arquivos" "File Explorer")" \
        --cancel-button "$(t "Voltar" "Back")" \
        --menu "$(t "Navegando em:\n$atual\n\nSelecione o arquivo de backup (.sql ou .sql.gz):" "Browsing:\n$atual\n\nSelect the backup file:")" 22 76 12 "${itens[@]}" 3>&1 1>&2 2>&3) || true

        if [ -z "$escolha" ]; then return 1; fi

        if [ "$escolha" = ".." ]; then
            atual=$(dirname "$atual")
        elif [ -d "$atual/$escolha" ]; then
            atual="$atual/$escolha"
        elif [ -f "$atual/$escolha" ]; then
            echo "$atual/$escolha"
            return 0
        fi
    done
}

selecionar_diretorio() {
    local atual="${1:-/}"
    while true; do
        local dirs=( ">>> $(t "SALVAR NESTA PASTA" "SAVE IN THIS FOLDER") <<<" "$(t "Destino:" "Target:") $atual" )
        if [ "$atual" != "/" ]; then
            dirs+=( ".." "$(t "[Voltar para o diretorio anterior]" "[Back to previous directory]")" )
        fi
        
        while IFS= read -r d; do
            [ -z "$d" ] && continue
            dirs+=("$d" "$(t "[Pasta]" "[Folder]")")
        done <<< "$(find "$atual" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)"

        escolha=$(whiptail --title "$(t "Seletor de Diretório" "Directory Picker")" \
        --cancel-button "$(t "Voltar" "Back")" \
        --menu "$(t "Navegando em:\n$atual\n\nEntre numa pasta ou escolha salvar aqui:" "Browsing:\n$atual\n\nEnter a folder or save here:")" 22 76 12 "${dirs[@]}" 3>&1 1>&2 2>&3) || true

        if [ -z "$escolha" ]; then return 1; fi

        if [ "$escolha" = ">>> $(t "SALVAR NESTA PASTA" "SAVE IN THIS FOLDER") <<<" ]; then
            echo "$atual"
            return 0
        elif [ "$escolha" = ".." ]; then
            atual=$(dirname "$atual")
        elif [ -d "$atual/$escolha" ]; then
            atual="$atual/$escolha"
        fi
    done
}

# ======================================================================
# ROTINAS DE BLINDAGEM DO APT
# ======================================================================
aguardar_travas_apt() {
    caixa_explicacao "Verificando travas do APT/DPKG e bloqueando atualizacoes ocultas..." "Checking APT/DPKG locks and blocking hidden background updates..."
    systemctl stop apt-daily.timer apt-daily-upgrade.timer unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
    while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 || \
          fuser /var/lib/apt/lists/lock >/dev/null 2>&1 || \
          fuser /var/lib/dpkg/lock >/dev/null 2>&1; do
        echo "$(t "[INFO] Processos do APT ativos. Aguardando 3 segundos..." "[INFO] APT background processes active. Waiting 3 seconds...")"
        sleep 3
    done
    dpkg --configure -a 2>/dev/null || true
}

apt_instalar_com_retry() {
    local pacotes=("$@")
    local tentativas=1
    local max_tentativas=3

    set +e
    until DEBIAN_FRONTEND=noninteractive apt-get install -y "${pacotes[@]}"; do
        if [ "$tentativas" -ge "$max_tentativas" ]; then
            whiptail --title "$(t "Falha no APT" "APT Failure")" --msgbox "$(t "Falha crônica ao baixar pacotes após $max_tentativas tentativas. Verifique sua rede." "Failed to download packages after $max_tentativas attempts. Check your network.")" 12 70 || true
            set -e
            return 1
        fi
        echo -e "\n\e[1;33m$(t "[AVISO] Falha na tentativa $tentativas de $max_tentativas. Curando índices do Ubuntu e tentando novamente em 3s..." "[WARNING] Failure on attempt $tentativas of $max_tentativas. Fixing Ubuntu indices and retrying in 3s...")\e[0m\n"
        apt-get update --fix-missing -y >/dev/null 2>&1 || true
        dpkg --configure -a >/dev/null 2>&1 || true
        sleep 3
        tentativas=$((tentativas + 1))
    done
    set -e
    return 0
}

# ======================================================================
# SISTEMA CENTRAL DE VALIDAÇÃO
# ======================================================================
VALIDACAO_DIR="/var/log/koha-easy-install"
mkdir -p "$VALIDACAO_DIR" 2>/dev/null || true
VALIDACAO_LOG="$VALIDACAO_DIR/validacao-$(date '+%Y%m%d-%H%M%S').log"
V_OK=0; V_WARN=0; V_FAIL=0; V_CONTEXT=""

v_reset() {
    V_OK=0; V_WARN=0; V_FAIL=0; V_CONTEXT="$1"
    VALIDACAO_LOG="$VALIDACAO_DIR/validacao-$(date '+%Y%m%d-%H%M%S').log"
    {
        echo "======================================================================"
        echo "KOHA EASY INSTALL - VALIDATION REPORT"
        echo "Context: $V_CONTEXT"
        echo "Date: $(date '+%Y-%m-%d %H:%M:%S %Z')"
        echo "Host: $(hostname)"
        echo "======================================================================"
    } > "$VALIDACAO_LOG"
}

v_ok(){ V_OK=$((V_OK+1)); printf '[ OK ] %s\n' "$1" | tee -a "$VALIDACAO_LOG"; }
v_warn(){ V_WARN=$((V_WARN+1)); printf '[WARN] %s\n' "$1" | tee -a "$VALIDACAO_LOG"; }
v_fail(){ V_FAIL=$((V_FAIL+1)); printf '[FAIL] %s\n' "$1" | tee -a "$VALIDACAO_LOG"; }
v_info(){ printf '[INFO] %s\n' "$1" | tee -a "$VALIDACAO_LOG"; }

validar_comando(){
    local c="$1" d="$2"
    if command -v "$c" >/dev/null 2>&1; then 
        v_ok "$d: '$c' $(t "disponível" "available")."
        return 0
    fi
    v_fail "$d: '$c' $(t "não encontrado" "not found")."
    return 1
}

validar_arquivo(){
    local p="$1" d="$2"
    if [ -f "$p" ]; then 
        v_ok "$d: $p"
        return 0
    fi
    v_fail "$d: $(t "arquivo ausente" "missing file"): $p"
    return 1
}

validar_servico(){
    local s="$1" d="$2" req="${3:-sim}"
    if ! systemctl cat "$s" >/dev/null 2>&1; then
        if [ "$req" = "sim" ]; then
            v_fail "$d: $(t "serviço" "service") '$s' $(t "não encontrado" "not found")."
        else
            v_warn "$d: $(t "serviço opcional" "optional service") '$s' $(t "não instalado" "not installed")."
        fi
        return 1
    fi
    
    if systemctl is-active --quiet "$s"; then 
        v_ok "$d: $(t "serviço" "service") '$s' $(t "ativo" "active")."
        return 0
    fi
    
    if [ "$req" = "sim" ]; then
        v_fail "$d: $(t "serviço" "service") '$s' $(t "inativo" "inactive")."
    else
        v_warn "$d: $(t "serviço opcional" "optional service") '$s' $(t "inativo" "inactive")."
    fi
    return 1
}

validar_porta_local(){
    local p="$1" d="$2"
    if ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "([.:]${p})$"; then 
        v_ok "$d: TCP $p $(t "em escuta" "listening")."
        return 0
    fi
    v_fail "$d: TCP $p $(t "não está em escuta" "not listening")."
    return 1
}

validar_http(){
    local u="$1" d="$2" code
    code=$(curl -sS -L --max-time 8 -o /dev/null -w '%{http_code}' "$u" 2>/dev/null || true)
    if [[ "$code" =~ ^[23][0-9][0-9]$ ]]; then 
        v_ok "$d: HTTP $code em $u"
        return 0
    fi
    v_fail "$d: $(t "HTTP inválido em" "Invalid HTTP at") $u ($(t "código" "code") ${code:-$(t "sem resposta" "no response")})."
    return 1
}

validar_mariadb(){
    local c
    if ! mysql -Nse 'SELECT 1;' >/dev/null 2>&1; then 
        v_fail "MariaDB: $(t "conexão local falhou" "local connection failed")."
        return 1
    fi
    v_ok "MariaDB: $(t "conexão local funcionando" "local connection OK")."
    
    c=$(mysql -Nse "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='koha_library';" 2>/dev/null || echo 0)
    if [[ "$c" =~ ^[0-9]+$ ]] && [ "$c" -gt 50 ]; then 
        v_ok "koha_library: $c $(t "tabelas detectadas" "tables detected")."
        return 0
    else
        v_warn "koha_library: $c $(t "tabelas" "tables") ($(t "Aguardando Web Installer" "Waiting for Web Installer"))."
        return 0
    fi
}

obter_motor_busca(){ 
    mysql -Nse "SELECT value FROM koha_library.systempreferences WHERE variable='SearchEngine' LIMIT 1;" 2>/dev/null || true
}

validar_koha_instancia(){
    local c="/etc/koha/sites/library/koha-conf.xml" e
    validar_arquivo "$c" "Koha: $(t "configuração" "configuration")" || true
    validar_arquivo "/etc/apache2/sites-enabled/library.conf" "Apache: site Koha" || true
    
    if command -v koha-list >/dev/null 2>&1 && koha-list 2>/dev/null | grep -qx library; then 
        v_ok "Koha: $(t "instância 'library' registrada" "'library' instance registered")."
    else 
        v_fail "Koha: $(t "instância 'library' não registrada" "'library' instance not registered")."
    fi
    
    if [ -f "$c" ] && command -v xmllint >/dev/null 2>&1; then
        if xmllint --noout "$c" >/dev/null 2>&1; then
            v_ok "Koha: $(t "XML bem formado" "XML well-formed")."
        else
            v_fail "Koha: $(t "erro de XML em koha-conf.xml" "XML error in koha-conf.xml")."
        fi
    elif [ -f "$c" ]; then 
        v_warn "Koha: xmllint $(t "indisponível; XML não testado" "unavailable; XML not tested")."
    fi
    
    if command -v koha-plack >/dev/null 2>&1; then
        if koha-plack --status library >/dev/null 2>&1; then
            v_ok "Plack: $(t "status da instância respondeu" "instance status OK")."
        else
            v_warn "Plack: $(t "status da instância não foi confirmado" "instance status unconfirmed")."
        fi
    fi
    
    e=$(obter_motor_busca)
    case "$e" in
        Zebra) v_info "Koha: SearchEngine=Zebra." ;;
        Elasticsearch) v_info "Koha: SearchEngine=Elasticsearch." ;;
        "") v_warn "Koha: $(t "preferência SearchEngine não definida" "SearchEngine preference undefined")." ;;
        *) v_warn "Koha: $(t "SearchEngine contém valor inesperado:" "SearchEngine has unexpected value:") $e" ;;
    esac
}

validar_zebra(){
    [ "$1" != "Zebra" ] && return 0
    if systemctl is-active --quiet koha-zebra-daemon@library; then
        v_ok "Zebra: $(t "daemon ativo" "daemon active")."
    else
        v_warn "Zebra: $(t "daemon inativo" "daemon inactive") ($(t "Aguardando Web Installer" "Waiting for Web Installer"))."
    fi
    
    if command -v koha-rebuild-zebra >/dev/null 2>&1; then
        v_ok "Zebra: $(t "ferramenta de rebuild disponível" "rebuild tool available")."
    else
        v_fail "Zebra: koha-rebuild-zebra $(t "ausente" "missing")."
    fi
}

validar_elasticsearch(){
    local e="$1" r pend docs bibs
    if ! dpkg -s elasticsearch >/dev/null 2>&1 && ! dpkg -s koha-elasticsearch >/dev/null 2>&1; then
        if [ "$e" = "Elasticsearch" ]; then
            v_fail "Elasticsearch: $(t "configurado no Koha, mas pacote ausente" "configured in Koha, but package is missing")."
        else
            v_warn "Elasticsearch: $(t "não instalado" "not installed")."
        fi
        return 1
    fi
    
    if systemctl is-active --quiet elasticsearch; then 
        v_ok "Elasticsearch: $(t "serviço ativo" "service active")."
    else 
        if [ "$e" = "Elasticsearch" ]; then
            v_fail "Elasticsearch: $(t "serviço inativo" "service inactive")."
        else
            v_warn "Elasticsearch: $(t "instalado, mas inativo" "installed, but inactive")."
        fi
    fi
    
    r=$(curl -sS --max-time 5 http://127.0.0.1:9200/ 2>/dev/null || true)
    if [ -n "$r" ]; then 
        v_ok "Elasticsearch: API 9200 $(t "respondeu" "responded")."
    elif [ "$e" = "Elasticsearch" ]; then 
        v_fail "Elasticsearch: API 9200 $(t "sem resposta" "no response")."
    else 
        v_warn "Elasticsearch: API 9200 $(t "sem resposta" "no response")."
    fi

    if [ "$e" = "Elasticsearch" ]; then
        if koha_es_ativo_no_xml; then
            v_ok "Koha: $(t "bloco <elasticsearch> presente" "<elasticsearch> block present")"
        else
            v_fail "Koha: $(t "bloco <elasticsearch> AUSENTE" "<elasticsearch> block MISSING")"
        fi

        if curl -sS --max-time 5 'http://127.0.0.1:9200/_cat/indices/koha_library_*?format=json' 2>/dev/null | grep -q koha_library_; then
            v_ok "Elasticsearch: $(t "índices Koha encontrados" "Koha indices found")."
        else
            v_warn "Elasticsearch: $(t "índices Koha não confirmados" "Koha indices unconfirmed")."
        fi

        if koha_indexador_esta_rodando; then
            v_ok "Indexador: koha-es-indexer $(t "rodando" "running")."
        else
            v_fail "Indexador: koha-es-indexer $(t "NÃO está rodando!" "NOT running!")."
        fi

        if ss -lnt 2>/dev/null | grep -q ':61613'; then
            v_ok "Mensageria: RabbitMQ/STOMP (61613) OK."
        else
            v_warn "Mensageria: RabbitMQ/STOMP (61613) $(t "ausente" "missing") (Fallback: polling)."
        fi

        pend=$(koha_jobs_es_pendentes)
        if [ "${pend:-0}" -eq 0 ] 2>/dev/null; then
            v_ok "Fila: $(t "nenhum job pendente" "no pending jobs")."
        elif [ "${pend:-0}" -le 20 ] 2>/dev/null; then
            v_warn "Fila: $pend $(t "job(s) pendente(s)" "pending job(s)")."
        else
            v_fail "Fila: $pend $(t "jobs pendentes - indexador travado" "pending jobs - indexer stuck")."
        fi

        bibs=$(koha_total_biblios)
        docs=$(koha_es_total_documentos)
        if [[ "$bibs" =~ ^[0-9]+$ ]] && [[ "$docs" =~ ^[0-9]+$ ]]; then
            if [ "$docs" -ge "$bibs" ]; then
                v_ok "Cobertura: $docs docs -> $bibs biblios."
            else
                v_warn "Cobertura: $docs docs -> $bibs biblios ($(t "faltam" "missing") $((bibs-docs)))."
            fi
        fi
    fi
}

validar_cron(){
    local f="/etc/cron.d/koha_tasks"
    validar_arquivo "$f" "Cron: $(t "arquivo central" "central file")" || return 1
    
    if [ "$(stat -c '%a' "$f" 2>/dev/null || echo 0)" = 644 ]; then
        v_ok "Cron: $(t "permissões" "permissions") 644."
    else
        v_warn "Cron: $(t "permissões erradas" "wrong permissions")."
    fi
    
    if grep -q 'backup_sql.sh' "$f" 2>/dev/null; then v_ok "Cron: backup SQL OK."; else v_warn "Cron: backup SQL $(t "ausente" "missing")."; fi
    if grep -q 'backup_marc.sh' "$f" 2>/dev/null; then v_ok "Cron: backup MARC21 OK."; else v_warn "Cron: backup MARC21 $(t "ausente" "missing")."; fi
    
    if systemctl is-active --quiet cron; then
        v_ok "Cron: $(t "serviço ativo" "service active")."
    else
        v_fail "Cron: $(t "serviço inativo" "service inactive")."
    fi
}

validar_ufw(){
    if ! command -v ufw >/dev/null 2>&1; then
        v_fail "UFW: $(t "comando ausente" "command missing")."
        return 1
    fi
    
    if ufw status 2>/dev/null | grep -q '^Status: active'; then
        v_ok "UFW: $(t "firewall ativo" "firewall active")."
    else
        v_fail "UFW: $(t "firewall inativo" "firewall inactive")."
    fi
}

validar_rede_e_sistema(){
    local ram free
    validar_comando curl "Internet" || true
    
    if getent hosts debian.koha-community.org >/dev/null 2>&1; then
        v_ok "DNS: debian.koha-community.org OK."
    else
        v_fail "DNS: fail debian.koha-community.org."
    fi
    
    ram=$(awk '/MemTotal:/ {printf "%.1f", $2/1024/1024}' /proc/meminfo 2>/dev/null || echo 0)
    v_info "RAM $(t "detectada" "detected"): ${ram} GB."
    
    free=$(df -Pm / 2>/dev/null | awk 'NR==2{print $4}')
    if [[ "$free" =~ ^[0-9]+$ ]] && [ "$free" -ge 5120 ]; then
        v_ok "Disco/Disk: ${free} MB $(t "livres" "free")."
    else
        v_warn "Disco/Disk: ${free} MB $(t "livres" "free")."
    fi
}

validar_sistema_completo(){
    local ctx="${1:-validação completa}" ip engine
    v_reset "$ctx"
    v_info "=== SISTEMA / REDE ==="; validar_rede_e_sistema
    v_info "=== SERVIÇOS ==="
    validar_servico mariadb MariaDB
    validar_servico apache2 Apache
    validar_servico memcached Memcached
    validar_servico koha-common "Koha common"
    validar_servico cron Cron
    v_info "=== KOHA / BANCO ==="; validar_mariadb; validar_koha_instancia
    ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    if [ -n "$ip" ]; then
        validar_porta_local 80 OPAC
        validar_porta_local 8080 Staff
        validar_http http://127.0.0.1:80/ "OPAC local"
        validar_http http://127.0.0.1:8080/ "Staff local"
    fi
    engine=$(obter_motor_busca)
    v_info "=== BUSCA ==="; validar_zebra "$engine"; validar_elasticsearch "$engine"
    v_info "=== APACHE / CRON / FIREWALL ==="
    if apachectl configtest >/dev/null 2>&1; then
        v_ok "Apache: configtest OK."
    else
        v_fail "Apache: configtest $(t "falhou" "failed")."
    fi
    validar_cron; validar_ufw
    
    printf '\nRESULTADO: OK=%s | AVISOS=%s | ERROS=%s\n' "$V_OK" "$V_WARN" "$V_FAIL" | tee -a "$VALIDACAO_LOG"
    [ "$V_FAIL" -eq 0 ]
}

validar_pre_instalacao(){
    local free ram p
    v_reset "pré-instalação"
    
    if [ "$EUID" -eq 0 ]; then
        v_ok "Root OK."
    else
        v_fail "Root: $(t "privilégios insuficientes" "insufficient privileges")."
    fi
    
    validar_comando apt-get APT || true
    validar_comando dpkg DPKG || true
    validar_comando systemctl Systemd || true
    
    if getent hosts debian.koha-community.org >/dev/null 2>&1; then
        v_ok "DNS: $(t "repositório Koha resolve" "Koha repository resolves")."
    else
        v_fail "DNS: $(t "repositório Koha não resolve" "Koha repository does not resolve")."
    fi
    
    if curl -fsSI --max-time 8 https://debian.koha-community.org/koha/ >/dev/null 2>&1; then
        v_ok "HTTPS: $(t "repositório Koha respondeu" "Koha repository responded")."
    else
        v_fail "HTTPS: $(t "repositório Koha não respondeu" "Koha repository did not respond")."
    fi
    
    for p in 80 8080; do
        if ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "([.:]${p})$"; then
            v_warn "TCP $p $(t "em uso" "in use")."
        else
            v_ok "TCP $p $(t "livre" "free")."
        fi
    done
    
    if [ "$V_FAIL" -ne 0 ]; then
        whiptail --title "$(t "Pré-validação falhou" "Pre-validation failed")" --msgbox "$(t "Erros" "Errors"): $V_FAIL\n$(t "Avisos" "Warnings"): $V_WARN\n\nLog: $VALIDACAO_LOG" 10 70 || true
        return 1
    fi
    
    whiptail --title "$(t "Pré-validação OK" "Pre-validation OK")" --yesno "$(t "Pré-validação concluída sem erros críticos.\n\nIniciar instalação?" "Pre-validation completed without critical errors.\n\nStart installation?")" 12 70 || return 1
}

mostrar_validacao(){
    if [ ! -f "$VALIDACAO_LOG" ]; then
        whiptail --title "$(t "Validação" "Validation")" --msgbox "$(t "Nenhum relatório de validação foi gerado ainda." "No validation report generated yet.")" 8 65 || true
        return
    fi
    whiptail --title "$(t "Relatório de validação" "Validation Report")" --textbox "$VALIDACAO_LOG" 30 110 --scrolltext || true
}

# ======================================================================
# 1. INSTALAÇÃO BASE
# ======================================================================
funcao_instalar_koha() {
    whiptail --title "$(t "Instalação" "Installation")" --msgbox "$(t "Iniciando o Koha Easy Install (Zebra por padrão)." "Starting Koha Easy Install (Zebra default).")" 10 75 || true
    clear

    if ! validar_pre_instalacao; then return 0; fi

    aguardar_travas_apt

    caixa_explicacao "Configurando Locales e Codificação UTF-8..." "Configuring Locales and UTF-8 Encoding..."
    apt-get update -o Acquire::Check-Valid-Until=false -y >/dev/null 2>&1 || true
