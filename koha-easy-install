# MENU PRINCIPAL
# ======================================================================
while true; do
    OPCAO=$(whiptail --title "Koha Easy Install" \
    --menu "[POR] Painel de Administração Integrada:" 22 85 11 \
    "1" "Instalar Servidor Koha (Base Leve) / Install" \
    "2" "Restaurar Acervo (SQL) / Restore DB" \
    "3" "Alternar Motor de Busca (Zebra <-> Elasticsearch)" \
    "4" "Dimensionar Servidor (Tuning RAM)" \
    "5" "Configurar Backup em Nuvem (GDrive/OneDrive)" \
    "6" "Gerenciar Horários de Backup e Tarefas (Crontab)" \
    "7" "Configurar E-mails e Avisos (SMTP)" \
    "8" "Configurar Acesso Externo Seguro (Cloudflare Tunnel)" \
    "9" "Atualizar Sistema e Banco de Dados" \
    "10" "Status Detalhado dos Serviços" \
    "11" "Sair / Exit" 3>&1 1>&2 2>&3)

    if [ $? -ne 0 ]; then clear; exit 0; fi

    case $OPCAO in
        1) funcao_instalar_koha ;;
        2) funcao_restaurar_banco ;;
        3) funcao_alternar_motor_busca ;;
        4) funcao_dimensionar_servidor ;;
        5) funcao_configurar_rclone ;;
        6) funcao_gerenciar_crons ;;
        7) funcao_configurar_emails ;;
        8) funcao_configurar_cloudflare ;;
        9) funcao_atualizar_sistema ;;
        10)
           S_APA=$(systemctl is-active apache2 2>/dev/null || echo "inativo")
           S_MAR=$(systemctl is-active mariadb 2>/dev/null || echo "inativo")
           S_MEM=$(systemctl is-active memcached 2>/dev/null || echo "inativo")
           S_KOH=$(systemctl is-active koha-common 2>/dev/null || echo "inativo")
           S_CLD=$(systemctl is-active cloudflared 2>/dev/null || echo "não instalado")
           whiptail --title "Status" --msgbox "Apache: $S_APA\nMariaDB: $S_MAR\nMemcached: $S_MEM\nKoha: $S_KOH\nCloudflare: $S_CLD" 11 40
           ;;
        11) clear; exit 0 ;;
    esac
done
