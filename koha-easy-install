funcao_configurar_emails() {
    whiptail --title "E-mails (SMTP)" --msgbox "[POR] O assistente instalará as dependências e exibirá o guia SMTP." 8 70
    clear
    apt-get install -y postfix libsasl2-modules
    cat << EOF >> /etc/cron.d/koha_tasks
