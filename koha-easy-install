function_manual_backup() {
    require_database || return 0
    msg_info "$(t "Destino do Backup" "Backup Destination" "Destino de la Copia")" "$(t "Escolha a pasta para salvar o arquivo." "Choose the folder to save the file." "Elija la carpeta para guardar el archivo.")" 8 60
    local target_dir; target_dir=$(select_directory "$REAL_HOME") || return 0
    [ -z "$target_dir" ] && return 0
    
    exec 9>"/var/lock/koha_backup.lock"
    if ! flock -n 9; then msg_error "$(t "Erro" "Error" "Error")" "$(t "Outro backup ou restauração já está em andamento." "Another backup or restore is already in progress." "Otra copia o restauración ya está en progreso.")"; return 0; fi

    local file="${target_dir%/}/${DB_NAME}_manual_$(date +%Y-%m-%d_%Hh%M).sql.gz"
    display_explanation "$(t "Gerando o backup local..." "Generating local backup..." "Generando copia local...")"
    if mysqldump --single-transaction --quick --routines --triggers --default-character-set=utf8mb4 "$DB_NAME" | gzip > "$file" && gzip -t "$file" 2>/dev/null; then
        flock -u 9
        msg_ok "$(t "Backup gerado:\n$file\n\nTamanho: $(du -h "$file" | cut -f1)" "Backup generated:\n$file\n\nSize: $(du -h "$file" | cut -f1)" "Copia generada:\n$file\n\nTamaño: $(du -h "$file" | cut -f1)")" 10 70
    else
        rm -f "$file"; flock -u 9
        msg_error "$(t "Erro" "Error" "Error")" "$(t "Falha ao gerar backup. Verifique espaço em disco." "Failed to generate backup. Check disk space." "Fallo al generar copia. Compruebe el espacio en disco.")" 9 60
    fi
}

function_send_manual_scp_backup() {
    require_database || return 0
    local host user port folder key use_saved="no"

    if [ -f "$SCP_BACKUP_CONF" ] && grep -q '^SCP_HOST="[^"]\+"' "$SCP_BACKUP_CONF" 2>/dev/null; then
        . "$SCP_BACKUP_CONF"
        if prompt_yes_no "SCP" "$(t "Usar destino salvo: ${SCP_USER}@${SCP_HOST}:${SCP_FOLDER}?" "Use saved destination: ${SCP_USER}@${SCP_HOST}:${SCP_FOLDER}?" "¿Usar destino guardado: ${SCP_USER}@${SCP_HOST}:${SCP_FOLDER}?")" 9 70; then
            host="$SCP_HOST"; user="$SCP_USER"; port="$SCP_PORT"; folder="$SCP_FOLDER"; key="$SCP_KEY"
            [ -n "$key" ] && [ ! -r "$key" ] && { msg_error "$(t "Erro" "Error" "Error")" "$(t "Chave não encontrada:" "Key not found:" "Clave no encontrada:") $key"; return 1; }
            use_saved="yes"
        fi
    fi

    if [ "$use_saved" = "no" ]; then
        host=$(dialog --title "SCP" --inputbox "$(t "IP/Domínio de destino:" "Destination IP/Domain:" "IP/Dominio de destino:")" 9 60 3>&1 1>&2 2>&3) || return 0
        user=$(dialog --title "SCP" --inputbox "$(t "Usuário SSH:" "SSH User:" "Usuario SSH:")" 9 60 "$REAL_USER" 3>&1 1>&2 2>&3) || return 0
        port=$(dialog --title "SCP" --inputbox "$(t "Porta SSH:" "SSH Port:" "Puerto SSH:")" 9 60 "22" 3>&1 1>&2 2>&3) || return 0
        folder=$(dialog --title "SCP" --inputbox "$(t "Pasta no destino:" "Remote Folder:" "Carpeta remota:")" 9 60 "/home/${user}/Desktop" 3>&1 1>&2 2>&3) || return 0
        key=""
    fi

    exec 9>"/var/lock/koha_backup.lock"
    if ! flock -n 9; then msg_error "$(t "Erro" "Error" "Error")" "$(t "Outro backup em andamento." "Another backup in progress." "Otra copia en curso.")"; return 1; fi

    local target="${DIR_SQL}/${DB_NAME}_manual_scp_$(date +%Y%m%d%H%M).sql.gz"
    mkdir -p "$DIR_SQL"
    display_explanation "$(t "Gerando o backup para envio..." "Generating backup for transfer..." "Generando copia para transferencia...")"
    if ! (mysqldump --single-transaction --quick --routines --triggers --default-character-set=utf8mb4 "$DB_NAME" | gzip > "$target" && gzip -t "$target" 2>/dev/null); then
        rm -f "$target"; flock -u 9; msg_error "$(t "Erro" "Error" "Error")" "$(t "Falha ao gerar backup SQL local." "Failed to generate local SQL backup." "Fallo al generar copia SQL local.")"; return 1
    fi

    display_explanation "$(t "Enviando para ${user}@${host} via SCP..." "Sending to ${user}@${host} via SCP..." "Enviando a ${user}@${host} por SCP...")"
    local opts=(-P "$port" -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new)
    [ -n "$key" ] && opts+=(-i "$key")

    if scp "${opts[@]}" "$target" "${user}@${host}:${folder%/}/" 2>&1 | tee -a "$RUN_LOG"; then
        flock -u 9; msg_ok "$(t "Backup enviado com sucesso para ${host}:${folder}" "Backup sent successfully to ${host}:${folder}" "Copia enviada con éxito a ${host}:${folder}")" 9 66
    else
        flock -u 9; msg_error "$(t "Erro" "Error" "Error")" "$(t "Falha no SCP. A cópia local foi salva em $target" "SCP failed. Local copy saved at $target" "Fallo en SCP. Copia local guardada en $target")" 9 70
    fi
}

function_configure_automatic_scp_backup() {
    write_scp_backup_config
    local host user port folder key="/root/.ssh/koha_backup_ed25519"
    
    host=$(dialog --title "Auto SCP" --inputbox "$(t "IP/Domínio de destino:" "Destination IP/Domain:" "IP/Dominio de destino:")" 9 60 3>&1 1>&2 2>&3) || return 0
    user=$(dialog --title "Auto SCP" --inputbox "$(t "Usuário SSH:" "SSH User:" "Usuario SSH:")" 9 60 "$REAL_USER" 3>&1 1>&2 2>&3) || return 0
    port=$(dialog --title "Auto SCP" --inputbox "$(t "Porta SSH:" "SSH Port:" "Puerto SSH:")" 9 60 "22" 3>&1 1>&2 2>&3) || return 0
    folder=$(dialog --title "Auto SCP" --inputbox "$(t "Pasta destino (deve existir):" "Remote folder (must exist):" "Carpeta destino (debe existir):")" 9 60 "/home/${user}/koha_backups" 3>&1 1>&2 2>&3) || return 0

    mkdir -p /root/.ssh && chmod 700 /root/.ssh
    if [ ! -f "$key" ]; then
        ssh-keygen -t ed25519 -f "$key" -N "" -C "koha-backup@$(hostname)" >/dev/null 2>&1
    fi

    clear
    echo "======================================================================"
    echo "$(t "AUTORIZAÇÃO SSH NO DESTINO" "SSH DESTINATION AUTHORIZATION" "AUTORIZACIÓN SSH EN DESTINO")"
    echo "$(t "A senha do usuário '${user}' no destino será solicitada UMA ÚNICA VEZ." "Password for '${user}' will be asked ONCE." "La contraseña de '${user}' se pedirá UNA SOLA VEZ.")"
    echo "======================================================================"
    if ssh-copy-id -p "$port" -i "${key}.pub" -o StrictHostKeyChecking=accept-new "${user}@${host}"; then
        echo -e "\n[OK] $(t "Chave autorizada!" "Key authorized!" "¡Clave autorizada!")"
    else
        msg_info "SCP" "$(t "Copie a chave pública abaixo para o ~/.ssh/authorized_keys do destino:\n\n$(cat "${key}.pub")" "Copy this key to target's authorized_keys:\n\n$(cat "${key}.pub")" "Copie esta clave en authorized_keys del destino:\n\n$(cat "${key}.pub")")" 18 78
    fi

    display_explanation "$(t "Testando conexão..." "Testing connection..." "Probando conexión...")"
    if ! ssh -p "$port" -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 "${user}@${host}" "mkdir -p -- '$folder' && echo OK" | grep -q OK; then
        msg_error "$(t "Erro" "Error" "Error")" "$(t "A conexão sem senha falhou." "Passwordless connection failed." "La conexión sin contraseña falló.")" 9 60; return 1
    fi

    set_shell_config_value "$SCP_BACKUP_CONF" SCP_HOST "$host"
    set_shell_config_value "$SCP_BACKUP_CONF" SCP_USER "$user"
    set_shell_config_value "$SCP_BACKUP_CONF" SCP_PORT "$port"
    set_shell_config_value "$SCP_BACKUP_CONF" SCP_FOLDER "$folder"
    set_shell_config_value "$SCP_BACKUP_CONF" SCP_KEY "$key"

    msg_ok "$(t "Backup SCP Diário configurado para:\n${user}@${host}:${folder}" "Daily SCP backup configured for:\n${user}@${host}:${folder}" "Copia SCP diaria configurada para:\n${user}@${host}:${folder}")" 10 70
}

function_configure_rclone() {
    local choice; choice=$(dialog --title "Rclone" --no-tags --menu "$(t "Configurar Envio em Nuvem:" "Configure Cloud Storage:" "Configurar almacenamiento en la nube:")" 12 70 2 \
        "1" " 1. $(t "Google Drive (Express/JSON Token)" "Google Drive (Express/JSON Token)" "Google Drive (Rápido/JSON Token)")" \
        "2" " 2. $(t "Outro / Assistente Rclone" "Other / Rclone Wizard" "Otro / Asistente Rclone")" 3>&1 1>&2 2>&3) || return 0
    if [ "$choice" = "1" ]; then
        clear
        echo -e "\e[1;36m$(t "CONFIGURAÇÃO EXPRESSA DO GOOGLE DRIVE" "EXPRESS GOOGLE DRIVE CONFIGURATION" "CONFIGURACIÓN RÁPIDA DE GOOGLE DRIVE")\e[0m\n"
        echo "$(t "No seu computador pessoal (Windows/Linux/Mac), execute:" "On your personal computer, run:" "En su ordenador personal, ejecute:")"
        echo -e "\e[1;33mrclone authorize \"drive\"\e[0m\n"
        echo "$(t "O navegador vai abrir. Autorize o login e cole o JSON gerado abaixo:" "Authorize in the browser and paste the JSON below:" "Autorice en el navegador y pegue el JSON a continuación:")"
        
        local token_input
        while true; do
            read -r token_input
            if python3 -c 'import sys, json; json.loads(sys.argv[1])' "$token_input" 2>/dev/null; then break; fi
            echo -e "\e[1;31m$(t "JSON inválido. Tente colar exatamente o bloco todo (com as chaves {}):" "Invalid JSON. Please paste the whole block (with {}):" "JSON inválido. Pegue todo el bloque completo (con {}):")\e[0m"
        done

        rclone config delete gdrive >/dev/null 2>&1 || true
        if rclone config create gdrive drive config_is_local false token "$token_input" --non-interactive < /dev/null >/dev/null 2>&1; then
            write_backup_config
            set_shell_config_value "$BACKUP_CONF" RCLONE_REMOTE "gdrive"
            msg_ok "$(t "Google Drive configurado (remote: gdrive)." "Google Drive configured (remote: gdrive)." "Google Drive configurado (remote: gdrive).")" 8 60
        else
            echo "$(t "Falha ao registrar gdrive no Rclone." "Failed to register gdrive in Rclone." "Fallo al registrar gdrive en Rclone.")"; sleep 3
        fi
    else
        clear; rclone config
        local conn_name; conn_name=$(dialog --title "Rclone" --inputbox "$(t "Qual NOME EXATO do remote criado?" "What is the EXACT remote name created?" "¿Cuál es el NOMBRE EXACTO del remote creado?")" 9 60 3>&1 1>&2 2>&3) || return 0
        if rclone listremotes 2>/dev/null | grep -qx "${conn_name}:"; then
            write_backup_config
            set_shell_config_value "$BACKUP_CONF" RCLONE_REMOTE "$conn_name"
            msg_ok "$(t "Remote '${conn_name}' salvo com sucesso." "Remote '${conn_name}' saved successfully." "Remote '${conn_name}' guardado con éxito.")" 8 60
        else
            msg_error "$(t "Erro" "Error" "Error")" "$(t "O remote '$conn_name' não foi encontrado no Rclone." "Remote '$conn_name' not found in Rclone." "El remote '$conn_name' no se encontró en Rclone.")" 9 60
        fi
    fi
}

