    "5"  "Alternar Motor de Busca / Toggle Search (Zebra <-> Elasticsearch)" \
    "6"  "Dimensionar Servidor / Server Sizing & Memory Tuning" \
    "7"  "Configurar Backup em Nuvem / Setup Cloud Backup (Rclone)" \
    "8"  "Gerenciar Tarefas Agendadas / Manage Crontab Schedules" \
    "9"  "Configurar E-mails e Avisos / Setup SMTP Email Notices" \
    "10" "Acesso Externo Seguro / Setup Cloudflare Tunnel" \
    "11" "Atualizar Sistema e Schemas / Update System & Schemas" \
    "12" "Status dos Serviços / Detailed Services Status" \
    "13" "Sair / Exit" 3>&1 1>&2 2>&3) || { clear; exit 0; }

    [ -z "$OPCAO" ] && { clear; exit 0; }

    case $OPCAO in
        1)  funcao_instalar_koha ;;
        2)  funcao_ver_credenciais ;;
        3)  funcao_restaurar_banco ;;
        4)  funcao_instalar_idiomas ;;
        5)  funcao_alternar_motor_busca ;;
        6)  funcao_dimensionar_servidor ;;
        7)  funcao_configurar_rclone ;;
        8)  funcao_gerenciar_crons ;;
        9)  funcao_configurar_emails ;;
        10) funcao_configurar_cloudflare ;;
        11) funcao_atualizar_sistema ;;
        12)
            S_APA=$(systemctl is-active apache2 2>/dev/null || echo "inativo/inactive")
            S_MAR=$(systemctl is-active mariadb 2>/dev/null || echo "inativo/inactive")
            S_MEM=$(systemctl is-active memcached 2>/dev/null || echo "inativo/inactive")
            S_KOH=$(systemctl is-active koha-common 2>/dev/null || echo "inativo/inactive")
            S_CLD=$(systemctl is-active cloudflared 2>/dev/null || echo "não instalado/uninstalled")
            whiptail --title "Status dos Serviços / Services Status" --msgbox "Apache:     $S_APA\nMariaDB:    $S_MAR\nMemcached:  $S_MEM\nKoha ILS:   $S_KOH\nCloudflare: $S_CLD" 11 50
            ;;
        13) clear; exit 0 ;;
    esac
    OPCAO=""
done
