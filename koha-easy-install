00 08 * * 1 root koha-shell library -c "/usr/share/koha/bin/cronjobs/overdue_notices.pl -v -t -e" >/dev/null 2>&1
# 7. ENVIOS DE EMAIL - Processa a fila as 08:05 (Segunda-feira)
05 08 * * 1 root koha-shell library -c "/usr/share/koha/bin/cronjobs/process_message_queue.pl -v" >/dev/null 2>&1
EOF
