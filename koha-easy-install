funcao_criar_superbibliotecario() {
    clear
    TEXTO_INFO="
======================================================================
 [POR] CRIAR SUPERBIBLIOTECÁRIO (PERMISSÃO MÁXIMA)
 [EN]  CREATE SUPER LIBRARIAN (HIGHEST PRIVILEGES)
======================================================================
Esta ferramenta cadastra um novo usuário no Koha com acesso total 
(Superlibrarian). Ideal caso você tenha perdido acesso ao painel
ou precise de uma conta mestre de emergência.
======================================================================
"
    whiptail --title "Super Librarian" --msgbox "$TEXTO_INFO" 14 78

    if ! command -v koha-list >/dev/null 2>&1 || ! koha-list 2>/dev/null | grep -qx library; then
        whiptail --title "Erro / Error" --msgbox "[POR] Instância 'library' não encontrada.\n[EN] 'library' instance not found." 8 60
        return
    fi

    BRANCH=$(mysql -Nse "SELECT branchcode FROM koha_library.branches LIMIT 1;" 2>/dev/null || true)
    CAT=$(mysql -Nse "SELECT categorycode FROM koha_library.categories LIMIT 1;" 2>/dev/null || true)

    if [ -z "$BRANCH" ] || [ -z "$CAT" ]; then
        whiptail --title "Erro / Error" --msgbox "[POR] O banco de dados não possui bibliotecas (branches) ou categorias criadas ainda.\nConclua o Web Installer no navegador antes de usar esta opção.\n\n[EN] Database has no branches or categories yet. Complete the Web Installer first." 14 78
        return
    fi

    NOVO_USER=$(whiptail --title "Usuário / Username" --inputbox "[POR] Digite o NOME DE USUÁRIO (login):\n[EN] Enter the USERNAME (login):" 10 60 3>&1 1>&2 2>&3)
    [ -z "$NOVO_USER" ] && return

    EXISTS=$(mysql -Nse "SELECT borrowernumber FROM koha_library.borrowers WHERE userid='$NOVO_USER';" 2>/dev/null || true)
    if [ -n "$EXISTS" ]; then
        whiptail --title "Aviso / Warning" --msgbox "[POR] O usuário '$NOVO_USER' já existe!\nPara mudar senhas, use a interface web do Koha.\n\n[EN] User '$NOVO_USER' already exists!" 10 60
        return
    fi

    NOVA_SENHA=$(whiptail --title "Senha / Password" --inputbox "[POR] Digite a SENHA para o usuário $NOVO_USER:\n[EN] Enter the PASSWORD for $NOVO_USER:" 10 60 3>&1 1>&2 2>&3)
    [ -z "$NOVA_SENHA" ] && return

    NOME=$(whiptail --title "Nome / First Name" --inputbox "[POR] Digite o Nome (First Name):\n[EN] Enter the First Name:" 10 60 "Super" 3>&1 1>&2 2>&3)
    SOBRENOME=$(whiptail --title "Sobrenome / Surname" --inputbox "[POR] Digite o Sobrenome (Surname):\n[EN] Enter the Surname:" 10 60 "Admin" 3>&1 1>&2 2>&3)

    caixa_explicacao "Gerando hash seguro da senha e cadastrando no banco..." "Hashing password and creating user..."
    
    cat << 'EOF' > /tmp/hash_pass.pl
use strict;
use warnings;
use Koha::AuthUtils qw(hash_password);
my $pw = $ARGV[0];
print hash_password($pw);
EOF

    HASH=$(koha-shell library -c "perl /tmp/hash_pass.pl '$NOVA_SENHA'" 2>/dev/null)
    rm -f /tmp/hash_pass.pl

    if [ -n "$HASH" ]; then
        mysql -e "INSERT INTO koha_library.borrowers (userid, password, surname, firstname, branchcode, categorycode, flags) VALUES ('$NOVO_USER', '$HASH', '$SOBRENOME', '$NOME', '$BRANCH', '$CAT', 1);" 2>/dev/null
        whiptail --title "Sucesso / Success" --msgbox "[POR] Superbibliotecário criado com sucesso!\n\nUsuário: $NOVO_USER\nSenha:   $NOVA_SENHA\n\n[EN] Super Librarian created successfully!" 12 60
    else
        whiptail --title "Erro / Error" --msgbox "[POR] Falha ao gerar o hash da senha.\n[EN] Failed to hash password." 8 60
    fi
}

