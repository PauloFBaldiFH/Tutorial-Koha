# ======================================================================
funcao_configurar_emails() {
    whiptail --title "E-mails (SMTP)" --msgbox "[POR] O Koha possui configuração própria de servidores SMTP.\nO instalador não precisa iniciar um servidor de e-mail local.\n\nA rotina abaixo instala apenas o suporte SASL e grava os cronjobs de avisos sem duplicá-los.\n\n[EN] Koha has its own SMTP server configuration.\nThe installer does not need to start a local mail server.\n\nThe routine below installs only SASL support and writes the notice cronjobs without duplicates." 15 78
    clear

    DEBIAN_FRONTEND=noninteractive apt-get install -y libsasl2-modules

    CRON_FILE="/etc/cron.d/koha_tasks"
    touch "$CRON_FILE"

    sed -i '/^# BEGIN KOHA EMAIL NOTICES$/,/^# END KOHA EMAIL NOTICES$/d' "$CRON_FILE"

    cat << 'EOF' >> "$CRON_FILE"

# BEGIN KOHA EMAIL NOTICES
# 7. [EN] EMAIL CRONJOB: Overdue notices (Daily at 08:00)
#    [POR] CRONJOB DE E-MAIL: Avisos de atraso (Diariamente às 08:00)
#    --triggered (-t) usa os gatilhos configurados no Koha.
00 08 * * * root koha-shell library -c "/usr/share/koha/bin/cronjobs/overdue_notices.pl -v -t" >/dev/null 2>&1

# 8. [EN] EMAIL CRONJOB: Process message queue (Daily at 08:05)
#    [POR] CRONJOB DE E-MAIL: Processar fila de envio (Diariamente às 08:05)
05 08 * * * root koha-shell library -c "/usr/share/koha/bin/cronjobs/process_message_queue.pl -v" >/dev/null 2>&1
# END KOHA EMAIL NOTICES
EOF

    chmod 644 "$CRON_FILE"
    systemctl restart cron

    TEXTO_TUTORIAL="
======================================================================
 [POR] CONFIGURAÇÃO DE E-MAIL (SMTP) NO KOHA
 [EN]  SMTP EMAIL CONFIGURATION IN KOHA
======================================================================

1. NO KOHA / IN KOHA
   Mais > Administração > Parâmetros adicionais > Servidores SMTP
   / More > Administration > Additional parameters > SMTP servers

   Exemplo Gmail:
   - Host: smtp.gmail.com
   - Porta: 587
   - Segurança: STARTTLS
   - Autenticação: Sim
   - Usuário: e-mail da biblioteca

2. SENHA DE APP / APP PASSWORD
   Para Gmail, use uma senha de app quando a conta exigir isso.

3. PREFERÊNCIAS IMPORTANTES / IMPORTANT PREFERENCES
   - EnhancedMessagingPreferences: Permitir / Allow
   - KohaAdminEmailAddress: e-mail da biblioteca
   - EmailAddressForSuggestions: e-mail da biblioteca

4. AVISOS DE ATRASO / OVERDUE NOTICES
   Configure os gatilhos em: Ferramentas > Avisos de atraso/status de aviso
   / Tools > Overdue notice/status triggers

   O cron diário usa --triggered (-t), portanto o Koha cria o aviso
   quando o empréstimo atinge exatamente o gatilho configurado.

5. FILA DE MENSAGENS / MESSAGE QUEUE
   Às 08:00 o Koha prepara os avisos. Às 08:05 a fila é processada.

6. TESTE DE SMTP / SMTP TEST
   Nas versões atuais do Koha, a tela de servidores SMTP possui a opção
   \"Enviar e-mail de teste / Send test email\" para testar a configuração.

7. OBSERVAÇÃO / NOTE
   O script não coloca usuário, senha ou token de SMTP em arquivo.
   A credencial deve ser cadastrada diretamente no Koha.
======================================================================
"
    v_reset "validação SMTP/avisos"
    validar_cron
    whiptail --title "Tutorial SMTP" --msgbox "$TEXTO_TUTORIAL" 23 78
}

