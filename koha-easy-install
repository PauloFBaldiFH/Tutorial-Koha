function_toggle_search_engine() {
    require_database || return 0
    local engine; engine=$(get_search_engine)
    
    if [ "$engine" = "Elasticsearch" ]; then
        prompt_yes_no "Zebra" "$(t "Voltar o motor de busca para ZEBRA?\nO índice do Elasticsearch não será removido." "Revert search engine to ZEBRA?\nElasticsearch index will not be removed." "¿Volver el motor de búsqueda a ZEBRA?\nEl índice Elasticsearch no se eliminará.")" 10 70 || return 0
        clear
        exec 7>"/var/lock/koha_es_rebuild.lock"
        if ! flock -n 7; then msg_error "$(t "Erro" "Error" "Error")" "$(t "Bloqueado: Reindexação em andamento." "Blocked: Reindex in progress." "Bloqueado: Reindexación en curso.")"; return 1; fi
        
        display_explanation "$(t "Trocando motor de volta para o Zebra..." "Switching engine back to Zebra..." "Cambiando motor a Zebra...")"
        manage_koha_indexers stop
        set_xml_elasticsearch remover || { flock -u 7; msg_error "$(t "Erro" "Error" "Error")" "$(t "Falha ao editar XML." "Failed to edit XML." "Fallo al editar XML.")"; return 1; }
        set_search_engine "Zebra"
        
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        force_stop_koha_zebra
        rm -f /var/lock/koha/${INSTANCE}/rebuild/*.LCK 2>/dev/null
        chown -R "${INSTANCE}-koha:${INSTANCE}-koha" "/var/lib/koha/${INSTANCE}/biblios" "/var/lock/koha/${INSTANCE}" 2>/dev/null || true
        
        systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1
        write_cron_zebra
        systemctl restart memcached koha-common >/dev/null 2>&1
        
        display_explanation "$(t "Reconstruindo o Zebra..." "Rebuilding Zebra..." "Reconstruyendo Zebra...")"
        koha-rebuild-zebra -f -v -b -a -r "$INSTANCE"
        koha-plack --restart "$INSTANCE" >/dev/null 2>&1
        flock -u 7
        msg_ok "$(t "Motor alterado para ZEBRA com sucesso." "Engine switched to ZEBRA successfully." "Motor cambiado a ZEBRA con éxito.")" 8 60
        return 0
    fi

    prompt_yes_no "Elasticsearch" "$(t "Ativar ELASTICSEARCH? (Exige ~1.5GB de RAM a mais)." "Enable ELASTICSEARCH? (Requires ~1.5GB extra RAM)." "¿Activar ELASTICSEARCH? (Requiere ~1.5GB de RAM extra).")" 10 70 || return 0
    if [ "$(get_free_space_mb /)" -lt 4096 ]; then prompt_yes_no "$(t "Aviso" "Warning" "Aviso")" "$(t "Menos de 4GB no disco. Continuar?" "Less than 4GB disk space. Continue?" "Menos de 4GB en disco. ¿Continuar?")" 9 60 || return 0; fi

    clear
    exec 7>"/var/lock/koha_es_rebuild.lock"
    if ! flock -n 7; then msg_error "$(t "Erro" "Error" "Error")" "$(t "Bloqueado." "Blocked." "Bloqueado.")"; return 1; fi

    display_explanation "$(t "Desativando o Zebra..." "Disabling Zebra..." "Desactivando Zebra...")"
    rm -f "$CRON_ZEBRA"; systemctl restart cron >/dev/null 2>&1
    systemctl disable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true

    if ! dpkg -s elasticsearch >/dev/null 2>&1 || ! dpkg -s koha-elasticsearch >/dev/null 2>&1; then
        display_explanation "$(t "Instalando pacotes do Elasticsearch..." "Installing Elasticsearch packages..." "Instalando paquetes de Elasticsearch...")"
        if ! ensure_elasticsearch_repository || ! apt_install elasticsearch koha-elasticsearch; then
            write_cron_zebra; systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1
            flock -u 7; msg_error "$(t "Erro" "Error" "Error")" "$(t "Falha ao instalar o ES. Zebra restaurado." "Failed to install ES. Zebra restored." "Fallo al instalar ES. Zebra restaurado.")"; return 1
        fi
    fi

    display_explanation "$(t "Configurando Elasticsearch..." "Configuring Elasticsearch..." "Configurando Elasticsearch...")"
    adjust_elasticsearch_heap
    set_shell_config_value /etc/elasticsearch/elasticsearch.yml discovery.type single-node
    set_shell_config_value /etc/elasticsearch/elasticsearch.yml network.host 127.0.0.1
    
    if ! /usr/share/elasticsearch/bin/elasticsearch-plugin list 2>/dev/null | grep -q '^analysis-icu$'; then
        /usr/share/elasticsearch/bin/elasticsearch-plugin install --batch analysis-icu >/dev/null 2>&1 || true
    fi

    systemctl daemon-reload
    systemctl enable --now elasticsearch >/dev/null 2>&1
    
    local es_ok="no"
    for _ in $(seq 1 45); do curl -sS --max-time 2 http://127.0.0.1:9200 >/dev/null 2>&1 && { es_ok="yes"; break; }; sleep 2; done
    if [ "$es_ok" = "no" ]; then
        write_cron_zebra; systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1
        flock -u 7; msg_error "$(t "Erro" "Error" "Error")" "$(t "Elasticsearch não subiu na porta 9200. Zebra restaurado." "Elasticsearch failed on port 9200. Zebra restored." "Elasticsearch falló en puerto 9200. Zebra restaurado.")"; return 1
    fi

    display_explanation "$(t "Injetando tags no XML e configurando banco..." "Injecting XML tags and DB config..." "Inyectando XML y configurando base...")"
    if ! set_xml_elasticsearch inserir || ! set_search_engine "Elasticsearch" || ! prepare_koha_broker; then
        set_xml_elasticsearch remover >/dev/null 2>&1 || true
        set_search_engine "Zebra"
        write_cron_zebra; systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1
        flock -u 7; msg_error "$(t "Erro" "Error" "Error")" "$(t "Erro ao injetar configurações do ES. Zebra restaurado." "Failed to inject ES config. Zebra restored." "Fallo al inyectar configuración ES. Zebra restaurado.")"; return 1
    fi

    curl -sS -X DELETE --max-time 10 "http://127.0.0.1:9200/${DB_NAME}_biblios" >/dev/null 2>&1 || true
    systemctl restart memcached koha-common >/dev/null 2>&1
    manage_koha_indexers start

    display_explanation "$(t "Reconstruindo o Índice Elasticsearch..." "Rebuilding Elasticsearch Index..." "Reconstruyendo Índice Elasticsearch...")"
    local cut_time; cut_time=$(date '+%Y-%m-%d %H:%M:%S')
    local rebuild_ok="yes"
    rebuild_koha_elasticsearch "$cut_time" || rebuild_ok="no"
    
    koha-plack --restart "$INSTANCE" >/dev/null 2>&1
    flock -u 7

    if [ "$rebuild_ok" = "yes" ]; then
        msg_ok "$(t "ELASTICSEARCH ativado e indexado com sucesso!" "ELASTICSEARCH enabled and indexed successfully!" "¡ELASTICSEARCH activado e indexado con éxito!")" 8 60
    else
        msg_error "$(t "Erro" "Error" "Error")" "$(t "ES ativado, mas a reindexação final falhou. Use a opção de reparar índices." "ES enabled, but index rebuild failed. Use repair indexing option." "ES activado, pero falló la reindexación. Use la opción de reparar.")" 9 70
    fi
}

