        msg_ok "$(t "Painel atualizado! Feche e abra novamente (sudo options.sh)." "Panel updated! Close and reopen (sudo options.sh)." "¡Panel actualizado! Cierre y vuelva a abrir (sudo options.sh).")" 8 60
