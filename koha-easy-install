    TEXTO_DICA=$(t "======================================================================\n DICAS DE ONDE SALVAR:\n - Pendrive/USB: Navegue até as pastas /media ou /mnt\n - SCP: Salve na sua pasta padrão e use: scp root@IP:$REAL_HOME/... .\n======================================================================" "======================================================================\n SAVE DESTINATIONS:\n - USB: Browse to /media or /mnt\n - SCP: Save to your folder and use: scp root@IP:$REAL_HOME/... .\n======================================================================")
