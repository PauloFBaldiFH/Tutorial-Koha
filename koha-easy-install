#!/bin/bash
# ======================================================================
# KOHA EASY INSTALL - ADVANCED MANAGEMENT SUITE
# [POR] Suíte completa de implantação, manutenção, tuning e backups.
# [EN] Complete suite for deployment, maintenance, tuning, and backups.
# ======================================================================

set -e
set -o pipefail

# ======================================================================
# ELEVAÇÃO AUTOMÁTICA DE PRIVILÉGIOS / AUTOMATIC PRIVILEGE ESCALATION
# ======================================================================
if [ "$EUID" -ne 0 ]; then
  echo -e "\n+-----------------------------------------------------------------------------------------+"
  echo -e "| [POR] Privilégios de administrador (root) necessários. Digite sua senha:                 |"
  echo -e "| [EN]  Root privileges required. Please enter your password:                              |"
  echo -e "+-----------------------------------------------------------------------------------------+\n"
  
  if [ -f "$0" ]; then
    exec sudo bash "$0" "$@"
  else
    echo "ERRO/ERROR: Execute como root / Run with root privileges: 'sudo bash ...'"
    exit 1
  fi
fi

REAL_USER="${SUDO_USER:-$USER}"
REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
[ -z "$REAL_HOME" ] && REAL_HOME="/home/$REAL_USER"

# ======================================================================
# FUNÇÃO DE CAIXAS DE EXPLICAÇÃO / EXPLANATION BOX FUNCTION
# ======================================================================
caixa_explicacao() {
    local msg_pt="$1"
    local msg_en="$2"
    echo -e "\n+-----------------------------------------------------------------------------------------+"
    echo -e "| [POR] $msg_pt"
    echo -e "| [EN]  $msg_en"
    echo -e "+-----------------------------------------------------------------------------------------+\n"
}

# ======================================================================
# EXPLORADOR DE ARQUIVOS NATIVO / NATIVE FILE EXPLORER (TUI)
# ======================================================================
selecionar_arquivo() {
    local atual="${1:-$REAL_HOME}"
    while true; do
        local itens=()
        if [ "$atual" != "/" ]; then
            itens+=(".." "[Diretório Acima / Up]")
        fi
        
        while IFS= read -r d; do
            [ -z "$d" ] && continue
            itens+=("$d" "[Pasta / Folder]")
        done <<< "$(find "$atual" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)"
        
        while IFS= read -r f; do
            [ -z "$f" ] && continue
            itens+=("$f" "Backup Database")
        done <<< "$(find "$atual" -mindepth 1 -maxdepth 1 -type f \( -name "*.sql" -o -name "*.sql.gz" \) -printf '%f\n' 2>/dev/null | sort)"

        if [ ${#itens[@]} -eq 0 ]; then
            itens+=(".." "[Diretório Vazio - Voltar / Empty - Go back]")
        fi

        escolha=$(whiptail --title "Explorador de Arquivos / File Explorer" --menu "Navegando em / Browsing:\n$atual\n\nSelecione o arquivo de backup (.sql ou .sql.gz):\nSelect the backup file:" 22 80 12 "${itens[@]}" 3>&1 1>&2 2>&3)

        if [ $? -ne 0 ]; then return 1; fi

        if [ "$escolha" = ".." ]; then
            atual=$(dirname "$atual")
        elif [ -d "$atual/$escolha" ]; then
            atual="$atual/$escolha"
        elif [ -f "$atual/$escolha" ]; then
            echo "$atual/$escolha"
            return 0
        fi
    done
}

selecionar_diretorio() {
    local atual="${1:-$REAL_HOME}"
    while true; do
        local dirs=( ">>> SALVAR NESTA PASTA <<<" "Save in: $atual" )
        if [ "$atual" != "/" ]; then
            dirs+=( ".." "[Diretório Acima / Up]" )
        fi
        
        while IFS= read -r d; do
            [ -z "$d" ] && continue
            dirs+=("$d" "[Pasta / Folder]")
        done <<< "$(find "$atual" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)"

        escolha=$(whiptail --title "Seletor de Diretório / Directory Picker" --menu "Navegando em / Browsing:\n$atual\n\nEntre numa pasta ou escolha salvar aqui:" 22 80 12 "${dirs[@]}" 3>&1 1>&2 2>&3)

        if [ $? -ne 0 ]; then return 1; fi

        if [ "$escolha" = ">>> SALVAR NESTA PASTA <<<" ]; then
            echo "$atual"
            return 0
        elif [ "$escolha" = ".." ]; then
            atual=$(dirname "$atual")
        elif [ -d "$atual/$escolha" ]; then
            atual="$atual/$escolha"
        fi
    done
}

# ======================================================================
# FUNÇÃO: AGUARDAR E LIBERAR TRAVAS DO APT / WAIT FOR APT LOCKS (BLINDADO)
# ======================================================================
aguardar_travas_apt() {
    caixa_explicacao "Verificando travas do APT/DPKG e bloqueando atualizacoes ocultas..." "Checking APT/DPKG locks and blocking hidden background updates..."
    
    systemctl stop apt-daily.timer apt-daily-upgrade.timer unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true

    while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 || \
          fuser /var/lib/apt/lists/lock >/dev/null 2>&1 || \
          fuser /var/lib/dpkg/lock >/dev/null 2>&1; do
        echo "[INFO] Processos em segundo plano estao ativos. Aguardando 3 segundos..."
        sleep 3
    done

    dpkg --configure -a 2>/dev/null || true
}

# ======================================================================
# FUNÇÃO AUXILIAR: Inserir/Remover Elasticsearch no XML com segurança
# ======================================================================
xml_set_elasticsearch() {
    local ACAO="$1"
    local CONF="/etc/koha/sites/library/koha-conf.xml"

    python3 - "$ACAO" "$CONF" << 'PYEOF'
import re
import sys

acao, path = sys.argv[1], sys.argv[2]

with open(path, "r") as f:
    text = f.read()

text = re.sub(r"[ \t]*<elasticsearch>.*?</elasticsearch>[ \t]*\n?", "", text, flags=re.DOTALL)

if acao == "inserir":
    es_block = (
        "  <elasticsearch>\n"
        "    <server>127.0.0.1:9200</server>\n"
        "    <index_name>koha_library</index_name>\n"
        "  </elasticsearch>\n"
    )
    if "</config>" not in text:
        sys.exit("ERRO: tag </config> nao encontrada em koha-conf.xml - abortando.")
    text = text.replace("</config>", es_block + "</config>")

with open(path, "w") as f:
    f.write(text)
PYEOF
}

# ======================================================================
# SISTEMA CENTRAL DE VALIDAÇÃO / CENTRAL VALIDATION SYSTEM
# ======================================================================
VALIDACAO_DIR="/var/log/koha-easy-install"
mkdir -p "$VALIDACAO_DIR" 2>/dev/null || true
VALIDACAO_LOG="$VALIDACAO_DIR/validacao-$(date '+%Y%m%d-%H%M%S').log"
V_OK=0; V_WARN=0; V_FAIL=0; V_CONTEXT=""

v_reset() {
    V_OK=0; V_WARN=0; V_FAIL=0; V_CONTEXT="$1"
    VALIDACAO_LOG="$VALIDACAO_DIR/validacao-$(date '+%Y%m%d-%H%M%S').log"
    {
        echo "======================================================================"
        echo "KOHA EASY INSTALL - RELATÓRIO DE VALIDAÇÃO"
        echo "Contexto: $V_CONTEXT"
        echo "Data: $(date '+%Y-%m-%d %H:%M:%S %Z')"
        echo "Host: $(hostname)"
        echo "======================================================================"
    } > "$VALIDACAO_LOG"
}
v_ok(){ V_OK=$((V_OK+1)); printf '[ OK ] %s\n' "$1" | tee -a "$VALIDACAO_LOG"; }
v_warn(){ V_WARN=$((V_WARN+1)); printf '[WARN] %s\n' "$1" | tee -a "$VALIDACAO_LOG"; }
v_fail(){ V_FAIL=$((V_FAIL+1)); printf '[FAIL] %s\n' "$1" | tee -a "$VALIDACAO_LOG"; }
v_info(){ printf '[INFO] %s\n' "$1" | tee -a "$VALIDACAO_LOG"; }

validar_comando(){
    local c="$1" d="$2"
    if command -v "$c" >/dev/null 2>&1; then v_ok "$d: '$c' disponível."; return 0; fi
    v_fail "$d: '$c' não encontrado."; return 1
}
validar_arquivo(){
    local p="$1" d="$2"
    if [ -f "$p" ]; then v_ok "$d: $p"; return 0; fi
    v_fail "$d: arquivo ausente: $p"; return 1
}
validar_servico(){
    local s="$1" d="$2" req="${3:-sim}"
    if ! systemctl cat "$s" >/dev/null 2>&1; then
        [ "$req" = "sim" ] && v_fail "$d: serviço '$s' não encontrado." || v_warn "$d: serviço opcional '$s' não instalado."
        return 1
    fi
    if systemctl is-active --quiet "$s"; then v_ok "$d: serviço '$s' ativo."; return 0; fi
    [ "$req" = "sim" ] && v_fail "$d: serviço '$s' inativo." || v_warn "$d: serviço opcional '$s' inativo."
    return 1
}
validar_porta_local(){
    local p="$1" d="$2"
    if ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "([.:]${p})$"; then v_ok "$d: TCP $p em escuta."; return 0; fi
    v_fail "$d: TCP $p não está em escuta."; return 1
}
validar_http(){
    local u="$1" d="$2" code
    code=$(curl -sS -L --max-time 8 -o /dev/null -w '%{http_code}' "$u" 2>/dev/null || true)
    if [[ "$code" =~ ^[23][0-9][0-9]$ ]]; then v_ok "$d: HTTP $code em $u"; return 0; fi
    v_fail "$d: HTTP inválido em $u (código ${code:-sem resposta})."; return 1
}
validar_mariadb(){
    local c
    if ! mysql -Nse 'SELECT 1;' >/dev/null 2>&1; then v_fail "MariaDB: conexão local falhou."; return 1; fi
    v_ok "MariaDB: conexão local funcionando."
    c=$(mysql -Nse "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='koha_library';" 2>/dev/null || echo 0)
    if [[ "$c" =~ ^[0-9]+$ ]] && [ "$c" -gt 50 ]; then v_ok "koha_library: $c tabelas detectadas."; return 0; fi
    v_fail "koha_library: banco ausente/vazio/incompleto (tabelas: ${c:-0})."; return 1
}
obter_motor_busca(){ mysql -Nse "SELECT value FROM koha_library.systempreferences WHERE variable='SearchEngine' LIMIT 1;" 2>/dev/null || true; }
validar_koha_instancia(){
    local c="/etc/koha/sites/library/koha-conf.xml" e
    validar_arquivo "$c" "Koha: configuração" || true
    validar_arquivo "/etc/apache2/sites-enabled/library.conf" "Apache: site Koha" || true
    if command -v koha-list >/dev/null 2>&1 && koha-list 2>/dev/null | grep -qx library; then v_ok "Koha: instância 'library' registrada."; else v_fail "Koha: instância 'library' não registrada no koha-list."; fi
    if [ -f "$c" ] && command -v xmllint >/dev/null 2>&1; then
        xmllint --noout "$c" >/dev/null 2>&1 && v_ok "Koha: XML bem formado." || v_fail "Koha: erro de XML em koha-conf.xml."
    elif [ -f "$c" ]; then v_warn "Koha: xmllint indisponível; XML não testado sintaticamente."; fi
    if command -v koha-plack >/dev/null 2>&1; then
        koha-plack --status library >/dev/null 2>&1 && v_ok "Plack: status da instância respondeu." || v_warn "Plack: status da instância não foi confirmado."
    fi
    e=$(obter_motor_busca)
    case "$e" in
        Zebra) v_info "Koha: SearchEngine=Zebra." ;;
        Elasticsearch) v_info "Koha: SearchEngine=Elasticsearch." ;;
        "") v_fail "Koha: preferência SearchEngine não foi lida." ;;
        *) v_warn "Koha: SearchEngine contém valor inesperado: $e" ;;
    esac
}
validar_zebra(){
    [ "$1" != "Zebra" ] && return 0
    systemctl is-active --quiet koha-zebra-daemon@library && v_ok "Zebra: daemon ativo." || v_fail "Zebra: daemon inativo."
    command -v koha-rebuild-zebra >/dev/null 2>&1 && v_ok "Zebra: ferramenta de rebuild disponível." || v_fail "Zebra: koha-rebuild-zebra ausente."
}
validar_elasticsearch(){
    local e="$1" r
    if ! dpkg -s elasticsearch >/dev/null 2>&1 && ! dpkg -s koha-elasticsearch >/dev/null 2>&1; then
        [ "$e" = "Elasticsearch" ] && v_fail "Elasticsearch: configurado no Koha, mas pacote ausente." || v_warn "Elasticsearch: não instalado; OK enquanto Zebra for o motor atual."
        return 1
    fi
    if systemctl is-active --quiet elasticsearch; then v_ok "Elasticsearch: serviço ativo."; else [ "$e" = "Elasticsearch" ] && v_fail "Elasticsearch: serviço inativo." || v_warn "Elasticsearch: instalado, mas inativo."; fi
    r=$(curl -sS --max-time 5 http://127.0.0.1:9200/ 2>/dev/null || true)
    if [ -n "$r" ]; then v_ok "Elasticsearch: API 9200 respondeu."; elif [ "$e" = "Elasticsearch" ]; then v_fail "Elasticsearch: API 9200 sem resposta."; else v_warn "Elasticsearch: API 9200 sem resposta."; fi
    if [ "$e" = "Elasticsearch" ]; then
        curl -sS --max-time 5 'http://127.0.0.1:9200/_cat/indices/koha_library_*?format=json' 2>/dev/null | grep -q koha_library_ && v_ok "Elasticsearch: índices Koha encontrados." || v_warn "Elasticsearch: índices Koha não confirmados."
    fi
}
validar_cron(){
    local f="/etc/cron.d/koha_tasks"
    validar_arquivo "$f" "Cron: arquivo central" || return 1
    [ "$(stat -c '%a' "$f" 2>/dev/null || echo 0)" = 644 ] && v_ok "Cron: permissões 644." || v_warn "Cron: permissões diferentes de 644."
    grep -q 'backup_sql.sh' "$f" 2>/dev/null && v_ok "Cron: backup SQL presente." || v_warn "Cron: backup SQL não encontrado."
    grep -q 'backup_marc.sh' "$f" 2>/dev/null && v_ok "Cron: backup MARC21 presente." || v_warn "Cron: backup MARC21 não encontrado."
    grep -q 'koha-plack --restart library' "$f" 2>/dev/null && v_ok "Cron: reinício diário do Plack presente." || v_warn "Cron: reinício do Plack não encontrado."
    grep -q 'overdue_notices.pl' "$f" 2>/dev/null && v_ok "Cron: avisos de atraso presentes." || v_warn "Cron: avisos de atraso não configurados."
    grep -q 'process_message_queue.pl' "$f" 2>/dev/null && v_ok "Cron: fila de mensagens presente." || v_warn "Cron: fila de mensagens não configurada."
    systemctl is-active --quiet cron && v_ok "Cron: serviço ativo." || v_fail "Cron: serviço inativo."
}
validar_ufw(){
    command -v ufw >/dev/null 2>&1 || { v_fail "UFW: comando ausente."; return 1; }
    ufw status 2>/dev/null | grep -q '^Status: active' && v_ok "UFW: firewall ativo." || v_fail "UFW: firewall inativo."
    local p
    for p in 22 80 443 8080 587 53682; do
        ufw status 2>/dev/null | grep -Eq "${p}/tcp|${p}" && v_ok "UFW: regra TCP $p encontrada." || v_warn "UFW: regra TCP $p não confirmada."
    done
}
validar_rede_e_sistema(){
    local ram free
    validar_comando ss "Rede" || true
    validar_comando curl "Rede" || true
    if getent hosts debian.koha-community.org >/dev/null 2>&1; then v_ok "DNS: debian.koha-community.org resolve."; else v_fail "DNS: não resolve debian.koha-community.org."; fi
    ram=$(awk '/MemTotal:/ {printf "%.1f", $2/1024/1024}' /proc/meminfo 2>/dev/null || echo 0)
    v_info "RAM detectada: ${ram} GB."
    free=$(df -Pm / 2>/dev/null | awk 'NR==2{print $4}')
    if [[ "$free" =~ ^[0-9]+$ ]] && [ "$free" -ge 5120 ]; then v_ok "Disco: ${free} MB livres em /."; elif [[ "$free" =~ ^[0-9]+$ ]] && [ "$free" -ge 2048 ]; then v_warn "Disco: ${free} MB livres em /."; else v_fail "Disco: menos de 2 GB livres em /."; fi
    swapon --show 2>/dev/null | grep -q '/' && v_ok "SWAP: ativa." || v_warn "SWAP: nenhuma área ativa."
    timedatectl show -p NTPSynchronized --value 2>/dev/null | grep -q '^yes$' && v_ok "NTP: sincronizado." || v_warn "NTP: sincronização não confirmada."
}
validar_opcionais(){
    if systemctl cat cloudflared.service >/dev/null 2>&1; then systemctl is-active --quiet cloudflared && v_ok "Cloudflare Tunnel: ativo." || v_warn "Cloudflare Tunnel: instalado, mas inativo."; else v_warn "Cloudflare Tunnel: não configurado."; fi
    if [ -f /root/.config/rclone/rclone.conf ]; then
        v_ok "Rclone: configuração encontrada."
        if rclone lsd gdrive: >/dev/null 2>&1; then v_ok "Rclone: remoto gdrive acessível."; else v_warn "Rclone: remoto gdrive não respondeu."; fi
    else v_warn "Rclone: configuração ainda não encontrada."; fi
    [ -f /root/credenciais_koha.txt ] && v_ok "Credenciais: arquivo presente." || v_warn "Credenciais: arquivo ausente."
}
validar_sistema_completo(){
    local ctx="${1:-validação completa}" ip engine
    v_reset "$ctx"
    v_info "=== SISTEMA / REDE ==="; validar_rede_e_sistema
    v_info "=== SERVIÇOS ==="
    validar_servico mariadb MariaDB
    validar_servico apache2 Apache
    validar_servico memcached Memcached
    validar_servico koha-common "Koha common"
    validar_servico cron Cron
    validar_servico fail2ban Fail2ban opcional
    v_info "=== KOHA / BANCO ==="; validar_mariadb; validar_koha_instancia
    ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    if [ -n "$ip" ]; then validar_porta_local 80 OPAC; validar_porta_local 8080 Staff; validar_http http://127.0.0.1:80/ "OPAC local"; validar_http http://127.0.0.1:8080/ "Staff local"; else v_warn "IP do servidor não determinado."; fi
    engine=$(obter_motor_busca)
    v_info "=== BUSCA ==="; validar_zebra "$engine"; validar_elasticsearch "$engine"
    v_info "=== APACHE / CRON / FIREWALL ==="
    apachectl configtest >/dev/null 2>&1 && v_ok "Apache: configtest OK." || v_fail "Apache: configtest falhou."
    validar_cron; validar_ufw
    v_info "=== OPCIONAIS ==="; validar_opcionais
    printf '\nRESULTADO: OK=%s | AVISOS=%s | ERROS=%s\n' "$V_OK" "$V_WARN" "$V_FAIL" | tee -a "$VALIDACAO_LOG"
    echo "Log: $VALIDACAO_LOG" | tee -a "$VALIDACAO_LOG"
    [ "$V_FAIL" -eq 0 ]
}
validar_pre_instalacao(){
    local free ram p
    v_reset "pré-instalação"
    [ "$EUID" -eq 0 ] && v_ok "Root: execução como administrador." || v_fail "Root: privilégios insuficientes."
    if [ -r /etc/os-release ] && grep -Eq '^(ID|ID_LIKE)=(ubuntu|debian)|^(ID_LIKE)=.*debian' /etc/os-release; then v_ok "SO: base Debian/Ubuntu detectada."; else v_warn "SO: não identificado claramente como Debian/Ubuntu."; fi
    validar_comando apt-get APT || true; validar_comando dpkg DPKG || true; validar_comando systemctl Systemd || true; validar_comando ss Rede || true; validar_comando curl Internet || true; validar_comando wget Download || true; validar_comando gpg GPG || true
    getent hosts debian.koha-community.org >/dev/null 2>&1 && v_ok "DNS: repositório Koha resolve." || v_fail "DNS: repositório Koha não resolve."
    curl -fsSI --max-time 8 https://debian.koha-community.org/koha/ >/dev/null 2>&1 && v_ok "HTTPS: repositório Koha respondeu." || v_fail "HTTPS: repositório Koha não respondeu."
    free=$(df -Pm / 2>/dev/null | awk 'NR==2{print $4}'); ram=$(awk '/MemTotal:/ {printf "%.1f",$2/1024/1024}' /proc/meminfo 2>/dev/null || echo 0)
    if [[ "$free" =~ ^[0-9]+$ ]] && [ "$free" -ge 5120 ]; then v_ok "Disco: ${free} MB livres."; elif [[ "$free" =~ ^[0-9]+$ ]]; then v_warn "Disco: somente ${free} MB livres."; else v_warn "Disco: não calculado."; fi
    v_info "RAM: ${ram} GB."
    for p in 80 8080; do ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "([.:]${p})$" && v_warn "TCP $p: já está em uso." || v_ok "TCP $p: livre."; done
    [ "$V_FAIL" -eq 0 ] || { whiptail --title "Pré-validação falhou" --msgbox "Erros: $V_FAIL\nAvisos: $V_WARN\n\nLog: $VALIDACAO_LOG" 10 70; return 1; }
    whiptail --title "Pré-validação OK" --yesno "Pré-validação concluída sem erros críticos.\n\nOK: $V_OK\nAvisos: $V_WARN\n\nIniciar instalação?" 12 70
}
mostrar_validacao(){
    [ -f "$VALIDACAO_LOG" ] || { whiptail --title "Validação" --msgbox "Nenhum relatório de validação foi gerado ainda." 8 65; return; }
    whiptail --title "Relatório de validação" --textbox "$VALIDACAO_LOG" 30 110 --scrolltext
}

# ======================================================================
# 1. INSTALAÇÃO BASE / BASE INSTALLATION
# ======================================================================
funcao_instalar_koha() {
    whiptail --title "Instalação / Installation" --msgbox "[POR] Iniciando o Koha Easy Install (Modo Leve - Zebra por padrão).\n\n[EN] Starting Koha Easy Install (Lightweight Mode - Zebra default)." 10 75
    clear

    if ! validar_pre_instalacao; then return; fi

    aguardar_travas_apt

    caixa_explicacao "Configurando Locales e Codificação UTF-8..." "Configuring Locales and UTF-8 Encoding..."
    apt-get update -o Acquire::Check-Valid-Until=false -y || true
    DEBIAN_FRONTEND=noninteractive apt-get install -y locales
    locale-gen pt_BR.UTF-8 en_US.UTF-8
    update-locale LANG=pt_BR.UTF-8 LC_ALL=pt_BR.UTF-8
    export LANG=pt_BR.UTF-8
    export LC_ALL=pt_BR.UTF-8

    caixa_explicacao "Sincronizando relógio do sistema (NTP)..." "Synchronizing system clock (NTP)..."
    DEBIAN_FRONTEND=noninteractive apt-get install -y systemd-timesyncd
    systemctl enable --now systemd-timesyncd
    timeout 10 bash -c 'until timedatectl | grep -q "synchronized: yes"; do sleep 1; done' || true
    dpkg-reconfigure tzdata
    export DEBIAN_FRONTEND=noninteractive

    caixa_explicacao "Criando Memória Virtual (SWAP 4GB)..." "Creating Virtual Memory (SWAP 4GB)..."
    if [ "$(swapon --show | wc -l)" -le 1 ]; then
      fallocate -l 4G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=4096
      chmod 600 /swapfile
      mkswap /swapfile
      swapon /swapfile
      echo '/swapfile none swap sw 0 0' >> /etc/fstab
    fi

    aguardar_travas_apt

    caixa_explicacao "Instalando dependências essenciais..." "Installing essential dependencies..."
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y
    
    DEBIAN_FRONTEND=noninteractive apt-get install -y nano curl wget gpg ufw software-properties-common default-jre-headless \
                  libapache2-mod-security2 fail2ban libsasl2-modules glabels \
                  rclone avahi-daemon memcached python3 expect libxml2-utils

    systemctl enable --now avahi-daemon fail2ban

    caixa_explicacao "Adicionando repositórios (Koha e Elasticsearch)..." "Adding repositories (Koha and Elasticsearch)..."
    mkdir -p /usr/share/keyrings
    wget -q --timeout=20 --tries=3 -O - https://debian.koha-community.org/koha/gpg.asc | gpg --dearmor --yes -o /usr/share/keyrings/koha-keyring.gpg
    echo "deb [signed-by=/usr/share/keyrings/koha-keyring.gpg] https://debian.koha-community.org/koha stable main" > /etc/apt/sources.list.d/koha.list

    wget -q --timeout=20 --tries=3 -O - https://artifacts.elastic.co/GPG-KEY-elasticsearch | gpg --dearmor --yes -o /usr/share/keyrings/elasticsearch-keyring.gpg
    echo "deb [signed-by=/usr/share/keyrings/elasticsearch-keyring.gpg] https://artifacts.elastic.co/packages/7.x/apt stable main" > /etc/apt/sources.list.d/elastic-7.x.list

    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y mariadb-server koha-common
    systemctl enable --now mariadb

