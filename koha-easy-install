# 7. CONFIGURAR NUVEM (RCLONE - GDRIVE OU OUTROS) / CLOUD BACKUP
# ======================================================================
funcao_configurar_rclone() {
    TEXTO_AVISO="
======================================================================
 [POR] DICAS PARA CONFIGURAR O BACKUP EM NUVEM
 [EN]  CLOUD BACKUP SETUP TIPS
======================================================================
1. NOME DA CONEXÃO / REMOTE NAME:
   Recomendamos usar 'gdrive' (ou outro nome de sua escolha).
   O sistema detectará o nome automaticamente.

2. GOOGLE DRIVE (PASSO A PASSO TÍPICO):
   - Client ID & Client Secret: Aperte ENTER (deixar em branco).
   - Scope: Escolha a Opção 1 (Full access).
   - Service Account: Aperte ENTER (em branco).

3. MÁQUINA SEM INTERFACE (AVISO CRUCIAL):
   Quando perguntar: 'Use auto config?':
   - Se estiver via terminal/SSH: digite 'n'. O Rclone dará um link
     para você abrir no navegador, autorizar e colar o código de volta.
   - Se estiver com navegador web na máquina: aperte ENTER (y).
======================================================================
"
    whiptail --title "Nuvem / Cloud Setup Guide" --msgbox "$TEXTO_AVISO" 22 78
    clear
    mkdir -p /root/.config/rclone
    rclone config

    # Identifica os remotes disponíveis
    REMOTES=($(rclone listremotes 2>/dev/null | tr -d ':'))

    if [ ${#REMOTES[@]} -eq 0 ]; then
        whiptail --title "Aviso / Warning" --msgbox "[POR] Nenhuma nuvem foi configurada no Rclone.\n[EN] No cloud remote was configured in Rclone." 8 60
        return
    elif [ ${#REMOTES[@]} -eq 1 ]; then
        REMOTE_ESCOLHIDO="${REMOTES[0]}"
    else
        OPCOES_MENU=()
        for r in "${REMOTES[@]}"; do
            OPCOES_MENU+=("$r" "Armazenamento em nuvem")
        done
        REMOTE_ESCOLHIDO=$(whiptail --title "Selecionar Nuvem / Select Cloud" \
            --menu "[POR] Selecione a nuvem que receberá os backups:\n[EN] Select which cloud remote will receive backups:" 16 65 6 \
            "${OPCOES_MENU[@]}" 3>&1 1>&2 2>&3) || return
    fi

    clear
    caixa_explicacao "Testando conexão com a nuvem '${REMOTE_ESCOLHIDO}'..." "Testing connection to cloud '${REMOTE_ESCOLHIDO}'..."

    if rclone mkdir "${REMOTE_ESCOLHIDO}:Backup_SQL_Koha" 2>/dev/null; then
        # Atualiza os scripts de backup com o nome efetivamente criado
        sed -i "s|[a-zA-Z0-9_-]\+:Backup_SQL_Koha|${REMOTE_ESCOLHIDO}:Backup_SQL_Koha|g" /root/backup_sql.sh 2>/dev/null || true
        sed -i "s|RCLONE_REMOTE=\".*\"|RCLONE_REMOTE=\"${REMOTE_ESCOLHIDO}\"|g" /root/backup_marc.sh 2>/dev/null || true

        whiptail --title "Sucesso / Success" --msgbox "[POR] Nuvem vinculada e testada com sucesso!\nDestino ativo: ${REMOTE_ESCOLHIDO}:\nOs backups diários (SQL) e semanais (MARC) usarão essa pasta automaticamente.\n\n[EN] Cloud linked and tested successfully!\nActive remote: ${REMOTE_ESCOLHIDO}:\nDaily (SQL) and weekly (MARC) backups will use this folder automatically." 13 76
    else
        whiptail --title "Erro de Conexão / Connection Error" --msgbox "[POR] Falha ao comunicar com '${REMOTE_ESCOLHIDO}'.\nVerifique se o token de autorização expirou ou se houve erro de digitação.\n\n[EN] Failed to communicate with '${REMOTE_ESCOLHIDO}'.\nPlease verify if the authorization token expired or if an error occurred." 11 74
    fi
}

