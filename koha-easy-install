#!/bin/bash
# ======================================================================
# KOHA EASY INSTALL - ADVANCED MANAGEMENT SUITE
# [POR] Suíte completa de implantação, manutenção, tuning e backups.
# [EN] Complete suite for deployment, maintenance, tuning, and backups.
# ======================================================================

exec < /dev/tty
set -e
set -o pipefail

# ======================================================================
# FUNÇÃO DE CAIXAS DE EXPLICAÇÃO / EXPLANATION BOX FUNCTION
# ======================================================================
caixa_explicacao() {
    local msg_pt="$1"
    local msg_en="$2"
    echo -e "\n+-----------------------------------------------------------------------------------------+"
    echo -e "| [POR] $msg_pt"
    echo -e "| [EN]  $msg_en"
    echo -e "+-----------------------------------------------------------------------------------------+\n"
}

if [ "$EUID" -ne 0 ]; then
  echo "ERRO/ERROR: Execute este script como root / Run this script as root ('sudo -i')."
  exit 1
fi

REAL_USER="${SUDO_USER:-$USER}"
REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
[ -z "$REAL_HOME" ] && REAL_HOME="/home/$REAL_USER"

# ======================================================================
# FUNÇÃO AUXILIAR: Inserir/Remover Elasticsearch no XML com segurança
# HELPER FUNCTION: Safely insert/remove Elasticsearch block in XML
# ======================================================================
xml_set_elasticsearch() {
    local ACAO="$1"
    local CONF="/etc/koha/sites/library/koha-conf.xml"

    python3 - "$ACAO" "$CONF" << 'PYEOF'
import re
import sys

acao, path = sys.argv[1], sys.argv[2]

with open(path, "r") as f:
    text = f.read()

text = re.sub(r"[ \t]*<elasticsearch>.*?</elasticsearch>[ \t]*\n?", "", text, flags=re.DOTALL)

if acao == "inserir":
    es_block = (
        "  <elasticsearch>\n"
        "    <server>127.0.0.1:9200</server>\n"
        "    <index_name>koha_library</index_name>\n"
        "  </elasticsearch>\n"
    )
    if "</config>" not in text:
        sys.exit("ERRO: tag </config> nao encontrada em koha-conf.xml - abortando.")
    text = text.replace("</config>", es_block + "</config>")

with open(path, "w") as f:
    f.write(text)
PYEOF
}

# ======================================================================
# 1. INSTALAÇÃO BASE / BASE INSTALLATION
# ======================================================================
funcao_instalar_koha() {
    whiptail --title "Instalação / Installation" --msgbox "[POR] Iniciando o Koha Easy Install (Modo Leve - Zebra por padrão).\n\n[EN] Starting Koha Easy Install (Lightweight Mode - Zebra default)." 10 75
    clear

    caixa_explicacao "Configurando Locales e Codificação UTF-8..." "Configuring Locales and UTF-8 Encoding..."
    apt-get update -o Acquire::Check-Valid-Until=false -y || true
    DEBIAN_FRONTEND=noninteractive apt-get install -y locales
    locale-gen pt_BR.UTF-8 en_US.UTF-8
    update-locale LANG=pt_BR.UTF-8 LC_ALL=pt_BR.UTF-8
    export LANG=pt_BR.UTF-8
    export LC_ALL=pt_BR.UTF-8

    caixa_explicacao "Sincronizando relógio do sistema (NTP)..." "Synchronizing system clock (NTP)..."
    DEBIAN_FRONTEND=noninteractive apt-get install -y systemd-timesyncd
    systemctl enable --now systemd-timesyncd
    timeout 10 bash -c 'until timedatectl | grep -q "synchronized: yes"; do sleep 1; done' || true
    dpkg-reconfigure tzdata
    export DEBIAN_FRONTEND=noninteractive

    caixa_explicacao "Criando Memória Virtual (SWAP 4GB)..." "Creating Virtual Memory (SWAP 4GB)..."
    if [ "$(swapon --show | wc -l)" -le 1 ]; then
      fallocate -l 4G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=4096
      chmod 600 /swapfile
      mkswap /swapfile
      swapon /swapfile
      echo '/swapfile none swap sw 0 0' >> /etc/fstab
    fi

    caixa_explicacao "Instalando dependências essenciais..." "Installing essential dependencies..."
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y nano curl wget gpg ufw software-properties-common default-jre-headless \
                  libapache2-mod-security2 fail2ban postfix libsasl2-modules glabels \
                  at rclone avahi-daemon memcached python3

    systemctl enable --now avahi-daemon fail2ban

    caixa_explicacao "Adicionando repositórios (Koha e Elasticsearch)..." "Adding repositories (Koha and Elasticsearch)..."
    mkdir -p /usr/share/keyrings
    wget -q --timeout=20 --tries=3 -O - https://debian.koha-community.org/koha/gpg.asc | gpg --dearmor --yes -o /usr/share/keyrings/koha-keyring.gpg
    echo "deb [signed-by=/usr/share/keyrings/koha-keyring.gpg] https://debian.koha-community.org/koha oldstable main" > /etc/apt/sources.list.d/koha.list

    wget -q --timeout=20 --tries=3 -O - https://artifacts.elastic.co/GPG-KEY-elasticsearch | gpg --dearmor --yes -o /usr/share/keyrings/elasticsearch-keyring.gpg
    echo "deb [signed-by=/usr/share/keyrings/elasticsearch-keyring.gpg] https://artifacts.elastic.co/packages/7.x/apt stable main" > /etc/apt/sources.list.d/elastic-7.x.list

    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y mariadb-server koha-common
    systemctl enable --now mariadb

    caixa_explicacao "Configurando Apache e portas de rede..." "Configuring Apache and network ports..."
    sed -i 's/^INTRAPORT=.*/INTRAPORT="8080"/' /etc/koha/koha-sites.conf
    sed -i 's/^OPACPORT=.*/OPACPORT="80"/' /etc/koha/koha-sites.conf
    sed -i 's/^#*MEMCACHED_SERVERS=.*/MEMCACHED_SERVERS="127.0.0.1:11211"/' /etc/koha/koha-sites.conf
    sed -i 's/^#*MEMCACHED_PREFIX=.*/MEMCACHED_PREFIX="koha_"/' /etc/koha/koha-sites.conf

    a2enmod rewrite cgi deflate headers proxy_http
    grep -q "^Listen 8080" /etc/apache2/ports.conf || sed -i '/Listen 80/a Listen 8080' /etc/apache2/ports.conf
    systemctl restart apache2

    caixa_explicacao "Criando instância 'library' do Koha..." "Creating 'library' Koha instance..."
    koha-remove library 2>/dev/null || true
    mysql -e "DROP DATABASE IF EXISTS koha_library;" 2>/dev/null || true
    mysql -e "DROP USER IF EXISTS 'koha_library'@'localhost';" 2>/dev/null || true
    rm -rf /etc/koha/sites/library

    koha-create --create-db library

    sed -i 's/__MEMCACHED_SERVERS__/127.0.0.1:11211/g' /etc/koha/sites/library/koha-conf.xml
    sed -i 's/__MEMCACHED_PREFIX__/koha_library:/g' /etc/koha/sites/library/koha-conf.xml

    a2dissite 000-default 2>/dev/null || true
    a2ensite library
    systemctl restart apache2 memcached
    koha-translate --install pt-BR || true
    koha-plack --enable library
    koha-plack --start library
    systemctl restart koha-common

    caixa_explicacao "Ativando o motor de busca Zebra (padrão)..." "Enabling the Zebra search engine (default)..."
    koha-zebra --enable library
    koha-zebra --start library
    systemctl enable --now koha-zebra-daemon@library

    # ======================================================================
    # ARQUIVOS DE BACKUP E CREDENCIAIS / BACKUP FILES AND CREDENTIALS
    # ======================================================================
    caixa_explicacao "Estruturando scripts de Backup e Credenciais..." "Structuring Backup scripts and Credentials..."
    ARQUIVO_CONF="/etc/koha/sites/library/koha-conf.xml"
    DB_PASS=$(grep -oP '(?<=<pass>)[^<]+' "$ARQUIVO_CONF" | head -n 1)
    DB_USER="koha_library"

    mkdir -p /var/backups/koha_sql /var/backups/koha_marc "$REAL_HOME/logs"

    cat << EOF > /root/credenciais_koha.txt
======================================================================
 [POR] CREDENCIAIS DE ACESSO AO KOHA (INSTÂNCIA: library)
 [EN]  KOHA ACCESS CREDENTIALS (INSTANCE: library)
======================================================================
 Staff (Adm / Intranet): http://$(hostname -I | awk '{print $1}'):8080
 OPAC (Public Catalog):  http://$(hostname -I | awk '{print $1}'):80

 DB Master User: $DB_USER
 Setup Password: $DB_PASS

 Config File:    /etc/koha/sites/library/koha-conf.xml
======================================================================
EOF
    chmod 600 /root/credenciais_koha.txt

    # Script 1: Backup Diário SQL
    cat << EOF > /root/backup_sql.sh
#!/bin/bash
set -o pipefail
DATA=\$(date +%Y-%m-%d_%Hh%M)
DIR_BACKUP="/var/backups/koha_sql"
mkdir -p "\$DIR_BACKUP"
MYSQL_PWD='$DB_PASS' mysqldump -u"$DB_USER" "koha_library" | gzip > "\$DIR_BACKUP/koha_library_\$DATA.sql.gz"
if [ -f /root/.config/rclone/rclone.conf ]; then
  /usr/bin/rclone --config /root/.config/rclone/rclone.conf move "\$DIR_BACKUP/koha_library_\$DATA.sql.gz" koha_cloud:Backup_SQL_Koha 2>/dev/null || true
fi
find "\$DIR_BACKUP" -name "*.sql.gz" -mtime +7 -delete
EOF

    # Script 2: Backup Semanal MARC21
    cat << 'EOF' > /root/backup_marc.sh
#!/bin/bash
set -uo pipefail
INSTANCE="library"
EXPORT_SCRIPT="/usr/share/koha/bin/export_records.pl"
BACKUP_DIR="/var/backups/koha_marc"
RCLONE_REMOTE="koha_cloud"
RCLONE_FOLDER="Backup_MARC_Koha"
KEEP_LOCAL_DAYS=7

DATE=$(date '+%Y-%m-%d_%H%M')
BIBLIOS_FILE="$BACKUP_DIR/biblios_${DATE}.mrc"
AUTHS_FILE="$BACKUP_DIR/authorities_${DATE}.mrc"
ARCHIVE_FILE="$BACKUP_DIR/koha_marc_${DATE}.tar.gz"

mkdir -p "$BACKUP_DIR"
koha-shell "$INSTANCE" -c "perl $EXPORT_SCRIPT --record-type=bibs --format=marc --filename=$BIBLIOS_FILE" >/dev/null 2>&1
koha-shell "$INSTANCE" -c "perl $EXPORT_SCRIPT --record-type=auths --format=marc --filename=$AUTHS_FILE" >/dev/null 2>&1

tar -czf "$ARCHIVE_FILE" -C "$BACKUP_DIR" "$(basename "$BIBLIOS_FILE")" "$(basename "$AUTHS_FILE")"
rm -f "$BIBLIOS_FILE" "$AUTHS_FILE"

if [ -f /root/.config/rclone/rclone.conf ]; then
  /usr/bin/rclone copy "$ARCHIVE_FILE" "$RCLONE_REMOTE:$RCLONE_FOLDER" >/dev/null 2>&1 || true
fi
find "$BACKUP_DIR" -name "koha_marc_*.tar.gz" -mtime "+$KEEP_LOCAL_DAYS" -delete
EOF
    chmod +x /root/backup_sql.sh /root/backup_marc.sh
    chmod 600 /root/backup_sql.sh

    # ======================================================================
    # ARQUIVO CENTRAL DE CRONS / CENTRAL CRONTAB FILE
    # ======================================================================
    cat << EOF > /etc/cron.d/koha_tasks
# ======================================================================
# KOHA EASY INSTALL - GERENCIADOR DE TAREFAS / TASK MANAGER (CRON)
# ======================================================================
# [POR] Formato: Minuto(0-59) | Hora(0-23) | Dia do Mes(1-31) | Mes(1-12) | Dia da Semana(0-6, 0=Dom)
# [EN]  Format:  Minute(0-59) | Hour(0-23) | Day of Month(1-31) | Month(1-12) | Day of Week(0-6, 0=Sun)

# 1. Vacuum journalctl logs every 14 days (Runs daily at 00:30)
30 0 * * * root /usr/bin/journalctl --vacuum-time=14d >/dev/null 2>&1

# 2. Database repair & check (Runs on the 5th day of every month at 01:00)
0 1 5 * * root /usr/bin/mysqlcheck --check --auto-repair --databases koha_library >/dev/null 2>&1

# 3. Automatic restart of Plack web engine (Runs daily at 05:00)
0 5 * * * root /usr/sbin/koha-plack --restart library >/dev/null 2>&1

# 4. DAILY SQL DATABASE BACKUP (Runs daily at 17:40)
40 17 * * * root /bin/bash /root/backup_sql.sh >/dev/null 2>&1

# 5. WEEKLY MARC21 & AUTHORITIES BACKUP (Runs every Sunday at 03:00)
0 3 * * 0 root /bin/bash /root/backup_marc.sh >/dev/null 2>&1
EOF
    chmod 644 /etc/cron.d/koha_tasks
    systemctl restart cron

    # Firewall UFW
    echo "ufw disable" | at now + 10 minutes
    ufw allow 22/tcp
    ufw allow 80/tcp
    ufw allow 443/tcp
    ufw allow 8080/tcp
    ufw allow 587/tcp
    ufw allow 53682/tcp
    echo "y" | ufw enable
    for job in $(atq 2>/dev/null | cut -f1); do atrm "$job" 2>/dev/null || true; done

    IP_REAL=$(hostname -I | awk '{print $1}')
    [ -z "$IP_REAL" ] && IP_REAL="ipdoservidor"

    # ======================================================================
    # ARTE ASCII DO SISTEMA (/ETC/ISSUE) - FACHADA AMPLA E BILÍNGUE
    # ======================================================================
    cat << EOF > /etc/issue
Ubuntu \n \l

                                    .-=========-.
                                   (  KOHA ILS   )
                                    \`-=========-'
                  /===============================================\\
                 /        .-----------------------------.        \\
                /         |     K O H A   L I B R A R Y |         \\
               /     .----'-----------------------------'----.     \\
              /=====[     PUBLIC CATALOG & AUTOMATION SUITE   ]=====\\
             /_______________________________________________________\\
             |  ||  ||  ||  ||  ||  ||  ||  ||  ||  ||  ||  ||  ||  |
             |==||==||==||==||==||==||==||==||==||==||==||==||==||==|
             |                                                       |
             |  [POR] Boas-vindas ao Koha Easy Install!              |
             |  [EN]  Welcome to Koha Easy Install!                  |
             |                                                       |
             |  ===================================================  |
             |  PAINEL DE CONTROLE / CONTROL DASHBOARD:              |
             |  sudo bash install.sh                                 |
             |  ===================================================  |
             |  ENDEREÇOS DE ACESSO / WEB ACCESS URLS:
             |  - Staff (Adm/Intranet):  http://${IP_REAL}:8080
             |  - OPAC (Public Catalog): http://${IP_REAL}:80
             |  ---------------------------------------------------  |
             |  PRIMEIRO ACESSO / INITIAL CREDENTIALS:
             |  - Usuário / Username: $DB_USER
             |  - Senha / Password:   cat /root/credenciais_koha.txt
             |  ===================================================  |
             |                                                       |
             |    |---|   |---|   |---|   .---.   |---|   |---|      |
             |    |* *|   |* *|   |* *|   |# #|   |* *|   |* *|      |
             |    |===|   |===|   |===|   |===|   |===|   |===|      |
            /=========================================================\\
           /___________________________________________________________\\

EOF
    cp /etc/issue /etc/issue.net
    cp /etc/issue /etc/motd

    whiptail --title "Sucesso / Success" --msgbox "[POR] Instalação concluída com sucesso!\n\nEndereço Staff: http://${IP_REAL}:8080\nEndereço OPAC:  http://${IP_REAL}:80\n\nUsuário: $DB_USER\nSenha:   $DB_PASS\n\n(Salva com segurança em /root/credenciais_koha.txt)\n--------------------------------------------------\n[EN] Installation completed successfully!\n\nStaff URL: http://${IP_REAL}:8080\nOPAC URL:  http://${IP_REAL}:80\n\nUsername: $DB_USER\nPassword: $DB_PASS\n\n(Safely archived in /root/credenciais_koha.txt)" 19 75
}

# ======================================================================
# 2. VISUALIZAR CREDENCIAIS / VIEW CREDENTIALS
# ======================================================================
funcao_ver_credenciais() {
    ARQUIVO_CONF="/etc/koha/sites/library/koha-conf.xml"
    if [ ! -f "$ARQUIVO_CONF" ]; then
        whiptail --title "Erro / Error" --msgbox "[POR] O Koha ainda não foi instalado.\n[EN] Koha has not been installed yet." 8 60
        return
    fi

    DB_PASS=$(grep -oP '(?<=<pass>)[^<]+' "$ARQUIVO_CONF" | head -n 1)
    DB_USER="koha_library"
    IP_REAL=$(hostname -I | awk '{print $1}')

    whiptail --title "Credenciais / Credentials" --msgbox "[POR] DADOS DE ACESSO AO KOHA:\n- Staff (Adm): http://${IP_REAL}:8080\n- OPAC (Público): http://${IP_REAL}:80\n- Usuário: $DB_USER\n- Senha:   $DB_PASS\n\n[EN] KOHA ACCESS CREDENTIALS:\n- Staff URL: http://${IP_REAL}:8080\n- OPAC URL:  http://${IP_REAL}:80\n- Username:  $DB_USER\n- Password:  $DB_PASS\n\nFile / Arquivo: /root/credenciais_koha.txt" 17 72
}

# ======================================================================
# 3. GERENCIADOR DE CRONJOBS / CRONJOB TASK MANAGER
# ======================================================================
funcao_gerenciar_crons() {
    whiptail --title "Tarefas / Tasks (Cron)" --msgbox "[POR] Você será levado ao arquivo central de configurações (Cronjobs).\nEle contém instruções em ambos os idiomas sobre horários de backup e avisos.\nPara salvar e sair: aperte CTRL+O, ENTER, e CTRL+X.\n\n[EN] You will be redirected to the central crontab configuration file.\nIt contains bilingual instructions on adjusting backup schedules.\nTo save and exit: press CTRL+O, ENTER, and CTRL+X." 14 75
    nano /etc/cron.d/koha_tasks
    systemctl restart cron
    whiptail --title "Sucesso / Success" --msgbox "[POR] Tarefas e horários atualizados!\n[EN] Tasks and schedules updated successfully!" 8 60
}

# ======================================================================
# 4. CONFIGURAR NUVEM (RCLONE) / CLOUD BACKUP (RCLONE)
# ======================================================================
funcao_configurar_rclone() {
    whiptail --title "Backup em Nuvem / Cloud Backup" --msgbox "[POR] Siga o assistente interativo para vincular Google Drive, OneDrive ou Dropbox.\n\nAVISO CRUCIAL: Quando o assistente perguntar 'name', digite exatamente: koha_cloud\n\n[EN] Follow the wizard to link Google Drive, OneDrive, or Dropbox.\n\nCRITICAL NOTE: When asked for the remote 'name', type exactly: koha_cloud" 14 75
    clear
    mkdir -p /root/.config/rclone
    rclone config
    whiptail --title "Sucesso / Success" --msgbox "[POR] Nuvem vinculada! Backups SQL diários e MARC semanais serão sincronizados.\n\n[EN] Cloud linked! Daily SQL and weekly MARC backups will be synchronized." 10 70
}

# ======================================================================
# 5. RESTAURAR BANCO DE DADOS / RESTORE DATABASE
# ======================================================================
funcao_restaurar_banco() {
    BACKUP_FILE=$(whiptail --title "Restauração / Restore" --inputbox "[POR] Digite o caminho do arquivo (.sql ou .sql.gz):\n[EN] Enter the full backup file path (.sql or .sql.gz):" 11 70 "/var/backups/koha_sql/" 3>&1 1>&2 2>&3)
    if [ $? -ne 0 ]; then return; fi

    if [ ! -f "$BACKUP_FILE" ]; then
       whiptail --title "Erro / Error" --msgbox "[POR] Arquivo não encontrado: $BACKUP_FILE\n[EN] File not found: $BACKUP_FILE" 8 65
       return
    fi

    whiptail --title "Restaurando / Restoring" --msgbox "[POR] O banco 'koha_library' será recriado e reindexado.\n[EN] The 'koha_library' database will be recreated and reindexed." 8 65
    clear

    caixa_explicacao "Recriando banco de dados koha_library..." "Recreating koha_library database..."
    mysql -e "DROP DATABASE IF EXISTS koha_library; CREATE DATABASE koha_library;"

    if [[ "$BACKUP_FILE" == *.gz ]]; then
        zcat "$BACKUP_FILE" | mysql koha_library
    else
        mysql koha_library < "$BACKUP_FILE"
    fi

    caixa_explicacao "Atualizando schemas e reiniciando daemons..." "Upgrading schemas and restarting daemons..."
    systemctl restart memcached
    koha-upgrade-schema library

    MOTOR_ATUAL=$(mysql -N -e "SELECT value FROM koha_library.systempreferences WHERE variable='SearchEngine';" 2>/dev/null || echo "Zebra")
    if [ "$MOTOR_ATUAL" == "Elasticsearch" ]; then
        curl -s -X DELETE 'localhost:9200/koha_library_biblios' >/dev/null 2>&1 || true
        curl -s -X DELETE 'localhost:9200/koha_library_authorities' >/dev/null 2>&1 || true
        koha-elasticsearch --rebuild -d library
    else
        koha-rebuild-zebra -f -v -b -a library
    fi

    koha-plack --restart library
    whiptail --title "Sucesso / Success" --msgbox "[POR] Acervo restaurado e indexado com sucesso!\n[EN] Catalog restored and indexed successfully!" 8 65
}

# ======================================================================
# 6. ALTERNAR MOTOR DE BUSCA / TOGGLE SEARCH ENGINE
# ======================================================================
funcao_alternar_motor_busca() {
    MOTOR_ATUAL=$(mysql -N -e "SELECT value FROM koha_library.systempreferences WHERE variable='SearchEngine';" 2>/dev/null || echo "Zebra")

    if [ "$MOTOR_ATUAL" == "Elasticsearch" ]; then
        if whiptail --title "Motor de Busca / Search Engine" --yesno "[POR] Motor atual: ELASTICSEARCH.\nDeseja voltar para o ZEBRA (Economiza ~1.5GB de RAM)?\n\n[EN] Current engine: ELASTICSEARCH.\nSwitch back to ZEBRA (Saves ~1.5GB RAM)?" 11 72; then
            clear
            caixa_explicacao "Desativando Elasticsearch..." "Disabling Elasticsearch..."
            systemctl stop elasticsearch && systemctl disable elasticsearch

            caixa_explicacao "Removendo bloco <elasticsearch> do koha-conf.xml..." "Removing <elasticsearch> block from koha-conf.xml..."
            if ! xml_set_elasticsearch remover; then
                whiptail --title "Erro / Error" --msgbox "[POR] Falha ao editar koha-conf.xml.\n[EN] Failed to edit koha-conf.xml." 8 60
                return
            fi

            caixa_explicacao "Ativando Zebra..." "Enabling Zebra..."
            koha-zebra --enable library && koha-zebra --start library
            systemctl enable --now koha-zebra-daemon@library
            mysql -e "UPDATE koha_library.systempreferences SET value='Zebra' WHERE variable='SearchEngine';"
            koha-rebuild-zebra -f -v -b -a library
            koha-plack --restart library
            whiptail --title "Sucesso / Success" --msgbox "[POR] Sistema operando com ZEBRA!\n[EN] System is now running on ZEBRA!" 8 60
        fi
    else
        if whiptail --title "Motor de Busca / Search Engine" --yesno "[POR] Motor atual: ZEBRA.\nDeseja ativar o ELASTICSEARCH (Busca avançada)?\n\n[EN] Current engine: ZEBRA.\nEnable ELASTICSEARCH (Advanced search)?" 11 72; then
            clear

            if ! dpkg -s koha-elasticsearch &>/dev/null; then
                caixa_explicacao "Instalando pacotes do Elasticsearch..." "Installing Elasticsearch packages..."
                apt-get update
                if ! DEBIAN_FRONTEND=noninteractive apt-get install -y elasticsearch koha-elasticsearch; then
                    whiptail --title "Erro / Error" --msgbox "[POR] Falha na instalação do Elasticsearch.\n[EN] Failed to install Elasticsearch." 8 60
                    return
                fi

                caixa_explicacao "Ajustando memória JVM do Elasticsearch..." "Tuning Elasticsearch JVM memory..."
                mkdir -p /etc/elasticsearch/jvm.options.d
                cat << 'JVMEOF' > /etc/elasticsearch/jvm.options.d/koha.options
-Xms1g
-Xmx1g
JVMEOF
                /usr/share/elasticsearch/bin/elasticsearch-plugin install --batch analysis-icu 2>/dev/null || true
            fi

            caixa_explicacao "Ativando serviço do Elasticsearch..." "Enabling Elasticsearch service..."
            systemctl enable --now elasticsearch

            caixa_explicacao "Inserindo bloco <elasticsearch> no koha-conf.xml..." "Inserting <elasticsearch> block into koha-conf.xml..."
            if ! xml_set_elasticsearch inserir; then
                whiptail --title "Erro / Error" --msgbox "[POR] Falha ao editar koha-conf.xml.\n[EN] Failed to edit koha-conf.xml." 8 60
                systemctl stop elasticsearch 2>/dev/null || true
                systemctl disable elasticsearch 2>/dev/null || true
                return
            fi

            caixa_explicacao "Desativando Zebra..." "Disabling Zebra..."
            systemctl stop koha-zebra-daemon@library 2>/dev/null || true
            systemctl disable koha-zebra-daemon@library 2>/dev/null || true
            koha-zebra --stop library 2>/dev/null || true
            koha-zebra --disable library 2>/dev/null || true

            mysql -e "UPDATE koha_library.systempreferences SET value='Elasticsearch' WHERE variable='SearchEngine';"
            mysql -e "UPDATE koha_library.systempreferences SET value='1' WHERE variable='ElasticsearchCommitImmediately';"
            curl -s -X DELETE 'localhost:9200/koha_library_biblios' >/dev/null 2>&1 || true
            curl -s -X DELETE 'localhost:9200/koha_library_authorities' >/dev/null 2>&1 || true
            systemctl restart koha-common

            caixa_explicacao "Reindexando acervo..." "Reindexing catalog..."
            if ! koha-elasticsearch --rebuild -d library; then
                whiptail --title "Aviso / Warning" --msgbox "[POR] Reindexação falhou. Rode depois: koha-elasticsearch --rebuild -d library\n[EN] Reindexing failed. Run later: koha-elasticsearch --rebuild -d library" 9 70
            fi

            koha-plack --restart library
            whiptail --title "Sucesso / Success" --msgbox "[POR] Sistema operando com ELASTICSEARCH!\n[EN] System is now running on ELASTICSEARCH!" 8 60
        fi
    fi
}

# ======================================================================
# 7. DIMENSIONAMENTO DE SERVIDOR / SERVER TUNING
# ======================================================================
funcao_dimensionar_servidor() {
    PERFIL=$(whiptail --title "Tuning / Sizing" \
    --menu "[POR] Selecione o perfil de hardware / [EN] Select hardware profile:" 16 80 4 \
    "1" "Low (~2GB RAM)  - 2 Plack Workers, 64MB Cache, 256MB DB" \
    "2" "Mid (~4GB RAM)  - 4 Plack Workers, 128MB Cache, 1GB DB" \
    "3" "High (8GB+ RAM) - 8 Plack Workers, 256MB Cache, 2GB DB" \
    "4" "Cancelar / Cancel" 3>&1 1>&2 2>&3)
    if [ $? -ne 0 ] || [ "$PERFIL" -eq 4 ]; then return; fi
    case $PERFIL in
        1) WK="2"; MEM="64"; DB="256M" ;;
        2) WK="4"; MEM="128"; DB="1G" ;;
        3) WK="8"; MEM="256"; DB="2G" ;;
    esac
    clear
    sed -i "s/^#*\s*PLACK_WORKERS=.*/PLACK_WORKERS=$WK/" /etc/default/koha-common || echo "PLACK_WORKERS=$WK" >> /etc/default/koha-common
    sed -i "s/^#*\s*PLACK_MAX_REQUESTS=.*/PLACK_MAX_REQUESTS=100/" /etc/default/koha-common || echo "PLACK_MAX_REQUESTS=100" >> /etc/default/koha-common
    sed -i "s/^-m .*/-m $MEM/" /etc/memcached.conf
    mkdir -p /etc/mysql/mariadb.conf.d/
    echo -e "[mysqld]\ninnodb_buffer_pool_size = $DB" > /etc/mysql/mariadb.conf.d/99-koha-tuning.cnf
    systemctl restart memcached mariadb koha-common
    koha-plack --restart library
    whiptail --title "Sucesso / Success" --msgbox "[POR] Servidor ajustado e reiniciado com sucesso!\n[EN] Server tuned and services restarted successfully!" 8 65
}

