write_backup_config() {
    [ -f "$BACKUP_CONF" ] && return 0
    cat > "$BACKUP_CONF" << 'EOF'
RCLONE_REMOTE=""
RCLONE_SQL_FOLDER="Backup_SQL_Koha"
RCLONE_MARC_FOLDER="Backup_MARC_Koha"
KEEP_DAYS=7
EOF
    chmod 600 "$BACKUP_CONF"
}

write_scp_backup_config() {
    [ -f "$SCP_BACKUP_CONF" ] && return 0
    cat > "$SCP_BACKUP_CONF" << 'EOF'
SCP_HOST=""
SCP_USER=""
SCP_PORT="22"
SCP_FOLDER=""
SCP_KEY="/root/.ssh/koha_backup_ed25519"
EOF
    chmod 600 "$SCP_BACKUP_CONF"
}

write_backup_scripts() {
    write_backup_config
    write_scp_backup_config

    # Script Backup SQL
    cat > /root/backup_sql.sh << EOF
#!/bin/bash
set -o pipefail
umask 077
. "$BACKUP_CONF" 2>/dev/null || true
. "$SCP_BACKUP_CONF" 2>/dev/null || true
DIR="$DIR_SQL"
LOG="${LOG_DIR}/backup_sql.log"
LOCK_FILE="/var/lock/koha_backup.lock"
[ -z "\$KEEP_DAYS" ] && KEEP_DAYS=7

log_backup() { mkdir -p "\$DIR"; printf '%s | %s\n' "\$(date '+%F %T')" "\$*" >> "\$LOG"; }

exec 9>"\$LOCK_FILE"
flock -n 9 || { log_backup "Bloqueado: outro processo ativo"; exit 0; }

FILE="\$DIR/${DB_NAME}_\$(date +%Y-%m-%d_%Hh%M).sql.gz"
if mysqldump --single-transaction --quick --routines --triggers --default-character-set=utf8mb4 "$DB_NAME" 2>>"\$LOG" | gzip > "\$FILE" && gzip -t "\$FILE" 2>/dev/null; then
    log_backup "OK: \$FILE"
    
    # Envio Rclone
    if [ -n "\$RCLONE_REMOTE" ] && [ -f /root/.config/rclone/rclone.conf ]; then
        rclone copy "\$FILE" "\${RCLONE_REMOTE}:\${RCLONE_SQL_FOLDER:-Backup_SQL_Koha}/" >>"\$LOG" 2>&1
    fi
    
    # Envio SCP
    if [ -n "\$SCP_HOST" ] && [ -n "\$SCP_USER" ] && [ -n "\$SCP_FOLDER" ]; then
        scp -P "\${SCP_PORT:-22}" -i "\${SCP_KEY}" -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new "\$FILE" "\${SCP_USER}@\${SCP_HOST}:\${SCP_FOLDER%/}/" >>"\$LOG" 2>&1
    fi
else
    log_backup "FALHA: Erro ao gerar \$FILE"
    rm -f "\$FILE"
    exit 1
fi
find "\$DIR" -name '*.sql.gz' -mtime "+\$KEEP_DAYS" -delete 2>/dev/null
exit 0
EOF

    # Script Backup MARC21
    cat > /root/backup_marc.sh << EOF
#!/bin/bash
set -o pipefail
umask 077
. "$BACKUP_CONF" 2>/dev/null || true
DIR="$DIR_MARC"
LOG="${LOG_DIR}/backup_marc.log"
LOCK_FILE="/var/lock/koha_backup.lock"
[ -z "\$KEEP_DAYS" ] && KEEP_DAYS=7

log_backup() { mkdir -p "\$DIR"; printf '%s | %s\n' "\$(date '+%F %T')" "\$*" >> "\$LOG"; }

exec 9>"\$LOCK_FILE"
flock -n 9 || { log_backup "Bloqueado: outro processo ativo"; exit 0; }

EXPORT_CMD=\$(find /usr/share/koha -name export_records.pl 2>/dev/null | head -n1)
[ -z "\$EXPORT_CMD" ] && { log_backup "FALHA: export_records.pl nao encontrado"; exit 1; }

DATE=\$(date '+%Y-%m-%d_%H%M')
B_FILE="\$DIR/biblios_\${DATE}.mrc"
A_FILE="\$DIR/auths_\${DATE}.mrc"
PACKAGE="\$DIR/koha_marc_\${DATE}.tar.gz"

koha-shell "$INSTANCE" -c "perl \$EXPORT_CMD --record-type=bibs --format=marc --filename=\$B_FILE" >>"\$LOG" 2>&1
koha-shell "$INSTANCE" -c "perl \$EXPORT_CMD --record-type=auths --format=marc --filename=\$A_FILE" >>"\$LOG" 2>&1

if [ -s "\$B_FILE" ] && tar -czf "\$PACKAGE" -C "\$DIR" "\$(basename "\$B_FILE")" "\$(basename "\$A_FILE" 2>/dev/null)" 2>>"\$LOG"; then
    log_backup "OK: \$PACKAGE"
    rm -f "\$B_FILE" "\$A_FILE"
    if [ -n "\$RCLONE_REMOTE" ] && [ -f /root/.config/rclone/rclone.conf ]; then
        rclone copy "\$PACKAGE" "\${RCLONE_REMOTE}:\${RCLONE_MARC_FOLDER:-Backup_MARC_Koha}/" >>"\$LOG" 2>&1
    fi
else
    log_backup "FALHA ao gerar pacote MARC"
    rm -f "\$B_FILE" "\$A_FILE" "\$PACKAGE"
    exit 1
fi
find "\$DIR" -name 'koha_marc_*.tar.gz' -mtime "+\$KEEP_DAYS" -delete 2>/dev/null
exit 0
EOF

    chmod 700 /root/backup_sql.sh /root/backup_marc.sh
}

