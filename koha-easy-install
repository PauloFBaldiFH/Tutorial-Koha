function_install_koha() {
    msg_info "$(t "Instalação" "Installation" "Instalación")" "$(t "Este assistente vai instalar MariaDB, Apache, Memcached e o Koha.\n\nPode levar de 10 a 30 minutos. Não feche o terminal." "This wizard installs MariaDB, Apache, Memcached and Koha.\n\nIt can take 10 to 30 minutes. Do not close the terminal." "Este asistente instalará MariaDB, Apache, Memcached y Koha.\n\nPuede tardar de 10 a 30 minutos. No cierre el terminal.")" 10 76
    clear
    validate_pre_installation || return 0

    local tz
    tz=$(choose_timezone) || return 0
    [ -n "$tz" ] && timedatectl set-timezone "$tz" >/dev/null 2>&1

    display_explanation "$(t "Configurando idioma, fuso e SWAP..." "Configuring locales, timezone and SWAP..." "Configurando idioma, zona horaria y SWAP...")"
    
    apt_update_indices || { msg_error "$(t "Erro" "Error" "Error")" "$(t "Falha ao atualizar repositórios." "Failed to update repositories." "Error al actualizar repositorios.")"; return 1; }
    
    apt_install locales systemd-timesyncd || { msg_error "$(t "Erro" "Error" "Error")" "$(t "Falha ao instalar pacotes base." "Failed to install base packages." "Error al instalar paquetes base.")"; return 1; }
    
    locale-gen pt_BR.UTF-8 en_US.UTF-8 es_ES.UTF-8 >/dev/null 2>&1
    case "$SYS_LANG" in
        pt) update-locale LANG=pt_BR.UTF-8 ;;
        es) update-locale LANG=es_ES.UTF-8 ;;
        *)  update-locale LANG=en_US.UTF-8 ;;
    esac
    systemctl enable --now systemd-timesyncd >/dev/null 2>&1

    if [ "$(swapon --show 2>/dev/null | wc -l)" -le 1 ] && [ ! -f /swapfile ] && [ "$(get_free_space_mb /)" -ge 8192 ]; then
        fallocate -l 4G /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=4096 status=none
        chmod 600 /swapfile
        mkswap /swapfile >/dev/null 2>&1
        swapon /swapfile 2>/dev/null && echo '/swapfile none swap sw 0 0' >> /etc/fstab
    fi

    display_explanation "$(t "Atualizando sistema e instalando dependências base..." "Upgrading system and base dependencies..." "Actualizando sistema e instalando dependencias base...")"
    DEBIAN_FRONTEND=noninteractive apt-get upgrade "${APT_OPTS[@]}" || { msg_error "$(t "Erro" "Error" "Error")" "$(t "Falha na atualização do sistema." "System upgrade failed." "Fallo en la actualización del sistema.")"; return 1; }
    
    apt_install nano wget gnupg ca-certificates ufw apt-transport-https openssh-client fail2ban libsasl2-modules rclone avahi-daemon memcached libxml2-utils pv || { msg_error "$(t "Erro" "Error" "Error")" "$(t "Falha ao instalar dependências." "Failed to install dependencies." "Error al instalar dependencias.")"; return 1; }
    
    systemctl enable --now avahi-daemon fail2ban memcached >/dev/null 2>&1

    display_explanation "$(t "Adicionando repositório oficial do Koha..." "Adding official Koha repository..." "Añadiendo repositorio oficial de Koha...")"
    mkdir -p /usr/share/keyrings
    curl -fsSL --retry 3 https://debian.koha-community.org/koha/gpg.asc | gpg --dearmor --yes -o /usr/share/keyrings/koha-keyring.gpg 2>/dev/null || return 1
    echo "deb [signed-by=/usr/share/keyrings/koha-keyring.gpg] https://debian.koha-community.org/koha stable main" > /etc/apt/sources.list.d/koha.list
    apt_update_indices || { msg_error "$(t "Erro" "Error" "Error")" "$(t "Falha ao atualizar repositórios do Koha." "Failed to update Koha repositories." "Error al actualizar repositorios de Koha.")"; return 1; }

    display_explanation "$(t "Instalando MariaDB e Koha (etapa mais demorada)..." "Installing MariaDB and Koha (longest step)..." "Instalando MariaDB y Koha (etapa más larga)...")"
    apt_install mariadb-server koha-common || { msg_error "$(t "Erro" "Error" "Error")" "$(t "Falha ao instalar Koha/MariaDB." "Failed to install Koha/MariaDB." "Error al instalar Koha/MariaDB.")"; return 1; }
    systemctl enable --now mariadb >/dev/null 2>&1

    display_explanation "$(t "Configurando Apache e preparando o Koha..." "Configuring Apache and preparing Koha..." "Configurando Apache y preparando Koha...")"
    define_koha_sites_conf
    a2enmod rewrite cgi deflate headers proxy proxy_http >/dev/null 2>&1
    grep -qE '^[[:space:]]*Listen[[:space:]]+8080' /etc/apache2/ports.conf 2>/dev/null || sed -i '/^[[:space:]]*Listen[[:space:]]\+80$/a Listen 8080' /etc/apache2/ports.conf
    systemctl restart apache2 memcached >/dev/null 2>&1

    if [ -d "/etc/koha/sites/${INSTANCE}" ] || [ "$(run_sql "SELECT 1 FROM information_schema.schemata WHERE schema_name='${DB_NAME}';")" = "1" ]; then
        prompt_yes_no "$(t "Instância Existente" "Existing Instance" "Instancia Existente")" "$(t "O Koha já está instalado. REINSTALAR APAGARÁ TUDO!\n\nContinuar?" "Koha is already installed. REINSTALLING DELETES EVERYTHING!\n\nContinue?" "Koha ya está instalado. ¡REINSTALAR BORRARÁ TODO!\n\n¿Continuar?")" 10 70 || return 0
        local confirm
        confirm=$(dialog --title "$(t "CONFIRMAÇÃO" "CONFIRMATION" "CONFIRMACIÓN")" --inputbox "$(t "Digite REINSTALAR para continuar:" "Type REINSTALL to continue:" "Escriba REINSTALAR para continuar:")" 10 50 3>&1 1>&2 2>&3) || return 0
        [ "$confirm" != "$(t "REINSTALAR" "REINSTALL" "REINSTALAR")" ] && return 0
        
        manage_koha_indexers stop
        [ -d "/etc/koha/sites/${INSTANCE}" ] && koha-remove "$INSTANCE" >/dev/null 2>&1
        mysql -e "DROP DATABASE IF EXISTS ${DB_NAME}; DROP USER IF EXISTS '${DB_NAME}'@'localhost'; FLUSH PRIVILEGES;" >/dev/null 2>&1
        rm -rf "/etc/koha/sites/${INSTANCE}"
    fi

    display_explanation "$(t "Criando a instância de banco e bibliotecas..." "Creating database instance and libraries..." "Creando instancia de base de datos y bibliotecas...")"
    koha-create --create-db "$INSTANCE" || { msg_error "$(t "Erro" "Error" "Error")" "$(t "Falha ao criar instância Koha." "Failed to create Koha instance." "Fallo al crear instancia Koha.")"; return 1; }

    sed -i 's/__MEMCACHED_SERVERS__/127.0.0.1:11211/g; s/__MEMCACHED_PREFIX__/koha_library:/g' "$KOHA_CONF" 2>/dev/null
    a2dissite 000-default >/dev/null 2>&1
    a2ensite "$INSTANCE" >/dev/null 2>&1
    systemctl restart apache2 memcached koha-common >/dev/null 2>&1

    koha-plack --enable "$INSTANCE" >/dev/null 2>&1
    koha-plack --start  "$INSTANCE" >/dev/null 2>&1
    koha-zebra --enable "$INSTANCE" >/dev/null 2>&1
    koha-zebra --start  "$INSTANCE" >/dev/null 2>&1
    systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1
    
    write_cron_zebra
    manage_koha_indexers start >/dev/null 2>&1

    display_explanation "$(t "Finalizando credenciais e rotinas automáticas..." "Finalizing credentials and automatic routines..." "Finalizando credenciales y rutinas automáticas...")"
    local db_pass ip
    db_pass=$(get_database_password)
    ip=$(get_server_ip)
    
    write_backup_scripts
    write_cron_tasks
    configure_firewall
    write_banner "$ip"

    cat > /root/credenciais_koha.txt << EOF
======================================================================
