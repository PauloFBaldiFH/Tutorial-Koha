}

# ======================================================================
# 3. RESTAURAR BANCO DE DADOS / RESTORE DATABASE
# ======================================================================
funcao_restaurar_banco() {
    LOCAL_ARQUIVO="$REAL_HOME/koha_library.sql"
    IP_REAL=$(hostname -I | awk '{print $1}')
    [ -z "$IP_REAL" ] && IP_REAL="ip_do_servidor"

    if [ ! -f "$LOCAL_ARQUIVO" ]; then
        TEXTO_SCP="
======================================================================
 [POR] COMO ENVIAR O ARQUIVO DE BACKUP PARA RESTAURAÇÃO
 [EN]  HOW TO SEND THE BACKUP FILE FOR RESTORATION
======================================================================

[POR] O Koha Easy Install exige que o arquivo se chame estritamente:
      koha_library.sql
      E esteja na pasta de usuário: $REAL_HOME/

OPÇÃO 1: VIA WINSCP (MÉTODO VISUAL MAIS FÁCIL)
1. No seu computador, baixe o WinSCP (winscp.net).
2. Conecte no IP: $IP_REAL (Porta 22, com seu usuário e senha).
3. Renomeie seu backup para 'koha_library.sql'.
4. Arraste o arquivo diretamente para a pasta inicial ($REAL_HOME/).

OPÇÃO 2: VIA LINHA DE COMANDO / SCP (WINDOWS POWERHELL OU CMD)
1. Coloque o backup na raiz do seu drive C: com o nome 'koha_library.sql'.
2. Abra o CMD ou PowerShell no seu computador e execute:
   scp C:\\koha_library.sql $REAL_USER@$IP_REAL:~
3. Digite sua senha. O arquivo irá direto para a pasta correta!

----------------------------------------------------------------------
[EN] The file MUST be named strictly: koha_library.sql
     And located at the user home directory: $REAL_HOME/

OPTION 1: WINSCP (VISUAL DRAG & DROP)
- Connect to $IP_REAL on Port 22 and drop 'koha_library.sql' in $REAL_HOME/

OPTION 2: COMMAND LINE (WINDOWS POWERSHELL / TERMINAL)
- Place file in C:\\ and run:
  scp C:\\koha_library.sql $REAL_USER@$IP_REAL:~
======================================================================
"
        whiptail --title "Como Enviar o Backup / Backup Guide" --scrolltext "$TEXTO_SCP" 26 82
        return
    fi

    if ! whiptail --title "Confirmar Restauração / Confirm Restore" --yesno "[POR] Arquivo encontrado em:\n$LOCAL_ARQUIVO\n\nATENÇÃO: O acervo atual será totalmente substituído pelo backup.\nDeseja continuar?\n\n[EN] Backup file found at:\n$LOCAL_ARQUIVO\n\nWARNING: Current catalog will be replaced by the backup.\nDo you want to proceed?" 14 74; then
        return
    fi

    clear
    caixa_explicacao "Recriando banco de dados koha_library..." "Recreating koha_library database..."
    mysql -e "DROP DATABASE IF EXISTS koha_library; CREATE DATABASE koha_library;"

    caixa_explicacao "Importando acervo (koha_library.sql)..." "Importing catalog (koha_library.sql)..."
    mysql koha_library < "$LOCAL_ARQUIVO"

    caixa_explicacao "Atualizando schemas e reiniciando daemons..." "Upgrading schemas and restarting daemons..."
    systemctl restart memcached
    koha-upgrade-schema library

    caixa_explicacao "Sincronizando Motor de Busca..." "Synchronizing Search Engine..."
    if dpkg -s koha-elasticsearch &>/dev/null && grep -q "<elasticsearch>" /etc/koha/sites/library/koha-conf.xml; then
        MOTOR_REAL="Elasticsearch"
    else
        MOTOR_REAL="Zebra"
    fi

    mysql -e "UPDATE koha_library.systempreferences SET value='$MOTOR_REAL' WHERE variable='SearchEngine';"

    if [ "$MOTOR_REAL" == "Elasticsearch" ]; then
        mysql -e "UPDATE koha_library.systempreferences SET value='1' WHERE variable='ElasticsearchCommitImmediately';"
        curl -s -X DELETE 'localhost:9200/koha_library_biblios' >/dev/null 2>&1 || true
        curl -s -X DELETE 'localhost:9200/koha_library_authorities' >/dev/null 2>&1 || true
        koha-elasticsearch --rebuild -d library
    else
        systemctl enable --now koha-zebra-daemon@library 2>/dev/null || true
        koha-zebra --start library 2>/dev/null || true
        koha-rebuild-zebra -f -v -b -a library
    fi

    koha-plack --restart library
    whiptail --title "Sucesso / Success" --msgbox "[POR] Acervo 'koha_library.sql' restaurado e indexado com sucesso!\nO servidor identificou e ativou automaticamente o motor: $MOTOR_REAL.\n\n[EN] Database 'koha_library.sql' restored and indexed successfully!\nThe server automatically detected and enabled the engine: $MOTOR_REAL." 10 74
}

