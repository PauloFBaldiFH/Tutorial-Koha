# ======================================================================
# 20. REPARAR/RECONSTRUIR INDEXAÇÃO (DINÂMICO PARA ZEBRA OU ES)
# ======================================================================
funcao_reparar_indexacao() {
    MOTOR=$(obter_motor_busca)
    
    if [ "$MOTOR" = "Elasticsearch" ]; then
        if whiptail --title "$(t "Reparar Elasticsearch" "Repair Elasticsearch")" --yesno "$(t "O motor atual é o ELASTICSEARCH.\nDeseja reiniciar o daemon e reconstruir os índices?" "Current engine is ELASTICSEARCH.\nRestart daemon and rebuild indices?")" 10 70; then
            clear
            caixa_explicacao "Reparando serviços do Elasticsearch..." "Repairing Elasticsearch services..."
            koha_broker_preparar || true
            systemctl restart memcached koha-common
            koha_indexadores_gerenciar start
            koha-plack --restart library
            caixa_explicacao "Reconstruindo índice do zero para o Elasticsearch..." "Rebuilding entire index for Elasticsearch..."
            koha-elasticsearch --rebuild -d library || true
            whiptail --title "$(t "Concluído" "Done")" --msgbox "$(t "Reparo finalizado e índice reconstruído." "Repair finished and index rebuilt.")" 8 60
        fi
    else
        if whiptail --title "$(t "Reparar Zebra" "Repair Zebra")" --yesno "$(t "O motor atual é o ZEBRA.\nDeseja destravar o daemon e reconstruir os índices do zero?" "Current engine is ZEBRA.\nUnlock daemon and rebuild indices?")" 10 70; then
            clear
            caixa_explicacao "Reparando e destravando serviços do Zebra..." "Repairing and unlocking Zebra services..."
            koha-zebra --stop library 2>/dev/null || true
            killall -9 zebrasrv 2>/dev/null || true
            rm -f /var/lock/koha/library/rebuild/rebuild..LCK
            rm -f /var/run/koha/library/zebrasrv.pid 2>/dev/null || true
            chown -R library-koha:library-koha /var/lib/koha/library/biblios /var/lib/koha/library/authorities /var/lock/koha/library
            chmod -R 755 /var/lib/koha/library/biblios /var/lib/koha/library/authorities
            
            koha-zebra --start library 2>/dev/null || true
            systemctl restart memcached koha-common
            
            caixa_explicacao "Sincronizando acervo com o Zebra (Rebuild Completo)..." "Synchronizing catalog with Zebra (Full Rebuild)..."
            koha-rebuild-zebra -f -v -b -a -r library || true
            koha-plack --restart library
            whiptail --title "$(t "Concluído" "Done")" --msgbox "$(t "Zebra destravado e banco de dados sincronizado." "Zebra unlocked and database synchronized.")" 8 60
        fi
    fi
}

# ======================================================================
# 21. ATIVAR / DESATIVAR PLUGINS DO KOHA
# ======================================================================
funcao_alternar_plugins() {
    ARQUIVO_CONF="/etc/koha/sites/library/koha-conf.xml"
    if [ ! -f "$ARQUIVO_CONF" ]; then
        whiptail --title "$(t "Erro" "Error")" --msgbox "$(t "O Koha ainda não foi instalado." "Koha has not been installed yet.")" 8 60
        return
    fi

    if grep -q "<enable_plugins>1</enable_plugins>" "$ARQUIVO_CONF"; then
        if whiptail --title "$(t "Plugins do Koha" "Koha Plugins")" --yesno "$(t "Status atual: ATIVADOS.\n\nDeseja DESATIVAR os plugins do Koha?" "Current status: ENABLED.\n\nDo you want to DISABLE Koha plugins?")" 10 65; then
            clear
            caixa_explicacao "Desativando plugins do Koha..." "Disabling Koha plugins..."
            sed -i 's/<enable_plugins>1<\/enable_plugins>/<enable_plugins>0<\/enable_plugins>/g' "$ARQUIVO_CONF"
            mysql -e "UPDATE koha_library.systempreferences SET value='0' WHERE variable='UseKohaPlugins';" 2>/dev/null || true
            systemctl restart memcached koha-common
            koha-plack --restart library
            whiptail --title "$(t "Sucesso" "Success")" --msgbox "$(t "Plugins desativados com sucesso!" "Plugins successfully disabled!")" 8 60
        fi
    else
        if whiptail --title "$(t "Plugins do Koha" "Koha Plugins")" --yesno "$(t "Status atual: DESATIVADOS.\n\nDeseja ATIVAR os plugins do Koha?" "Current status: DISABLED.\n\nDo you want to ENABLE Koha plugins?")" 10 65; then
            clear
            caixa_explicacao "Ativando plugins do Koha..." "Enabling Koha plugins..."
            
            if grep -q "<enable_plugins>0</enable_plugins>" "$ARQUIVO_CONF"; then
                sed -i 's/<enable_plugins>0<\/enable_plugins>/<enable_plugins>1<\/enable_plugins>/g' "$ARQUIVO_CONF"
            elif ! grep -q "<enable_plugins>" "$ARQUIVO_CONF"; then
                sed -i 's/<\/config>/  <enable_plugins>1<\/enable_plugins>\n<\/config>/g' "$ARQUIVO_CONF"
            fi
            
            mysql -e "UPDATE koha_library.systempreferences SET value='1' WHERE variable='UseKohaPlugins';" 2>/dev/null || true
            
            mkdir -p /var/lib/koha/library/plugins
            chown -R library-koha:library-koha /var/lib/koha/library/plugins
            
            systemctl restart memcached koha-common
            koha-plack --restart library
            whiptail --title "$(t "Sucesso" "Success")" --msgbox "$(t "Plugins ativados com sucesso!" "Plugins successfully enabled!")" 8 60
        fi
    fi
}

