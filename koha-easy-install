# ======================================================================
# 16. RESTAURAÇÃO DE BACKUP COM ROLLBACK ATÔMICO
# ======================================================================
backup_database_for_rollback() {
    local dest="$1"
    mkdir -p "$(dirname "$dest")"
    if ! mysqldump --single-transaction --quick --routines --triggers --default-character-set=utf8mb4 "$DB_NAME" 2>>"$RUN_LOG" | gzip >"$dest"; then
        rm -f "$dest"; return 1
    fi
    gzip -t "$dest" >/dev/null 2>&1 || { rm -f "$dest"; return 1; }
    return 0
}

rollback_database_from_backup() {
    local backup="$1" pass db_pass_sql
    [ -s "$backup" ] || return 1
    pass=$(get_database_password) || return 1
    db_pass_sql=$(sql_escape_literal "$pass")

    mysql -e "DROP DATABASE IF EXISTS ${DB_NAME}; CREATE DATABASE ${DB_NAME} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
              CREATE USER IF NOT EXISTS '${DB_NAME}'@'localhost' IDENTIFIED BY '${db_pass_sql}';
              ALTER USER '${DB_NAME}'@'localhost' IDENTIFIED BY '${db_pass_sql}';
              GRANT ALL PRIVILEGES ON ${DB_NAME}.* TO '${DB_NAME}'@'localhost'; FLUSH PRIVILEGES;" >/dev/null 2>&1 || return 1
    
    gzip -dc -- "$backup" | mysql --default-character-set=utf8mb4 "$DB_NAME" >/dev/null 2>&1 || return 1
    return 0
}

restore_engine_after_database_rollback() {
    local old_engine="$1"
    if [ "$old_engine" = "Elasticsearch" ]; then
        set_xml_elasticsearch inserir >/dev/null 2>&1 || true
        set_search_engine "Elasticsearch"
        systemctl restart elasticsearch memcached koha-common >/dev/null 2>&1 || true
        manage_koha_indexers start >/dev/null 2>&1
    else
        set_xml_elasticsearch remover >/dev/null 2>&1 || true
        set_search_engine "Zebra"
        manage_koha_indexers stop >/dev/null 2>&1
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
    fi
    koha-plack --restart "$INSTANCE" >/dev/null 2>&1 || true
}

import_sql_backup() {
    local file="$1"
    if [[ "$file" == *.gz ]]; then gzip -dc -- "$file" | mysql --default-character-set=utf8mb4 "$DB_NAME"
    else mysql --default-character-set=utf8mb4 "$DB_NAME" < "$file"; fi
}

function_restore_database() {
    require_koha || return 0
    local file; file=$(select_file "$REAL_HOME") || return 0
    [ -z "$file" ] && return 0

    display_explanation "$(t "Inspecionando integridade do backup..." "Inspecting backup integrity..." "Inspeccionando integridad de la copia...")"
    if [[ "$file" == *.gz ]] && ! gzip -t "$file" 2>/dev/null; then
        msg_error "$(t "Erro" "Error" "Error")" "$(t "Arquivo corrompido (falha no teste gzip)." "Corrupted file (failed gzip test)." "Archivo dañado (falló la prueba gzip).")" 8 60; return 0
    fi

    prompt_yes_no "$(t "Confirmar Restauração" "Confirm Restore" "Confirmar Restauración")" "$(t "Arquivo: $file\n\nATENÇÃO: O banco atual será SUBSTITUÍDO.\nUm backup de rollback será criado automaticamente.\n\nContinuar?" "File: $file\n\nWARNING: The current DB will be REPLACED.\nA rollback backup will be created automatically.\n\nContinue?" "Archivo: $file\n\nATENCIÓN: La base actual será REEMPLAZADA.\nSe creará una copia de seguridad automáticamente.\n\n¿Continuar?")" 12 74 || return 0
    
    clear
    exec 9>"/var/lock/koha_backup.lock"
    if ! flock -n 9; then msg_error "$(t "Erro" "Error" "Error")" "$(t "Operação bloqueada por outro backup em andamento." "Operation blocked by another backup in progress." "Operación bloqueada por otra copia en curso.")"; return 0; fi

    local rollback_file="${DIR_SQL}/PRE-RESTORE_${DB_NAME}_$(date +%Y%m%d-%H%M%S).sql.gz"
    local old_engine; old_engine=$(get_search_engine)
    [ "$old_engine" = "Elasticsearch" ] || old_engine="Zebra"

    if ! backup_database_for_rollback "$rollback_file"; then
        flock -u 9; msg_error "$(t "Erro" "Error" "Error")" "$(t "Falha ao criar o backup de segurança para rollback. Abortando." "Failed to create safety rollback backup. Aborting." "Fallo al crear la copia de seguridad. Abortando.")" 9 74; return 1
    fi

    manage_koha_indexers stop
    systemctl stop "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true

    local configured_db_pass; configured_db_pass=$(get_database_password)
    [ -z "$configured_db_pass" ] && configured_db_pass=$(python3 -c 'import secrets,string; print("".join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))')
    local db_pass_sql; db_pass_sql=$(sql_escape_literal "$configured_db_pass")

    display_explanation "$(t "Recriando banco e importando dados..." "Recreating DB and importing data..." "Recreando base de datos e importando datos...")"
    mysql -e "DROP DATABASE IF EXISTS ${DB_NAME}; CREATE DATABASE ${DB_NAME} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci; CREATE USER IF NOT EXISTS '${DB_NAME}'@'localhost' IDENTIFIED BY '${db_pass_sql}'; ALTER USER '${DB_NAME}'@'localhost' IDENTIFIED BY '${db_pass_sql}'; GRANT ALL PRIVILEGES ON ${DB_NAME}.* TO '${DB_NAME}'@'localhost'; FLUSH PRIVILEGES;" >/dev/null 2>&1

    if ! import_sql_backup "$file"; then
        log "Falha na importação. Executando rollback."
        rollback_database_from_backup "$rollback_file" && restore_engine_after_database_rollback "$old_engine"
        flock -u 9; msg_error "$(t "Erro" "Error" "Error")" "$(t "Importação falhou. Banco revertido para o estado anterior." "Import failed. Database rolled back to previous state." "La importación falló. La base de datos fue revertida.")" 9 70; return 1
    fi

    display_explanation "$(t "Atualizando schema do Koha..." "Upgrading Koha schema..." "Actualizando esquema de Koha...")"
    systemctl restart memcached >/dev/null 2>&1 || true
    if ! koha-upgrade-schema "$INSTANCE"; then
        rollback_database_from_backup "$rollback_file" && restore_engine_after_database_rollback "$old_engine"
        flock -u 9; msg_error "$(t "Erro" "Error" "Error")" "$(t "Migração do schema falhou. Banco revertido." "Schema migration failed. Database rolled back." "La migración del esquema falló. Base revertida.")" 9 70; return 1
    fi

    display_explanation "$(t "Sincronizando motores de busca..." "Synchronizing search engines..." "Sincronizando motores de búsqueda...")"
    local engine="Zebra"
    if dpkg -s koha-elasticsearch >/dev/null 2>&1 && is_koha_es_active_in_xml; then engine="Elasticsearch"; fi
    set_search_engine "$engine"

    if [ "$engine" = "Elasticsearch" ]; then
        prepare_koha_broker || { rollback_database_from_backup "$rollback_file"; restore_engine_after_database_rollback "$old_engine"; flock -u 9; msg_error "$(t "Erro" "Error" "Error")" "$(t "Falha ao configurar mensageria ES." "Failed to configure ES broker." "Fallo al configurar mensajería ES.")"; return 1; }
        systemctl restart koha-common >/dev/null 2>&1 || true
        manage_koha_indexers start
        rebuild_koha_elasticsearch "$(date '+%Y-%m-%d %H:%M:%S')" || msg_error "$(t "Aviso" "Warning" "Aviso")" "$(t "O banco foi restaurado, mas a reconstrução do ES falhou. Repare-o na Central de Manutenção." "DB restored, but ES index rebuild failed. Repair it in Maintenance Center." "Base de datos restaurada, pero falló la reconstrucción de ES. Repárelo en el Centro de Mantenimiento.")"
    else
        systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        write_cron_zebra
        koha-rebuild-zebra -f -v -b -a "$INSTANCE" || msg_error "$(t "Erro" "Error" "Error")" "$(t "A reindexação do Zebra falhou." "Zebra reindexing failed." "La reindexación de Zebra falló.")"
    fi

    flock -u 9
    koha-plack --restart "$INSTANCE" >/dev/null 2>&1 || true
    msg_ok "$(t "Restauração concluída!\n\nMotor atual: $engine\nPonto de segurança mantido em: $rollback_file" "Restore complete!\n\nCurrent engine: $engine\nSafety backup kept at: $rollback_file" "¡Restauración completada!\n\nMotor actual: $engine\nCopia de seguridad en: $rollback_file")" 11 74
}

