function_install_koha() {
    msg_info "$(t "Instalação" "Installation")" "$(t "Este assistente vai instalar MariaDB, Apache, Memcached e o Koha.\n\nPode levar de 10 a 30 minutos. Não feche o terminal." "This wizard installs MariaDB, Apache, Memcached and Koha.\n\nIt can take 10 to 30 minutes. Do not close the terminal.")" 10 76
    clear
    validate_pre_installation || return 0

    local tz
    tz=$(choose_timezone) && [ -n "$tz" ] && timedatectl set-timezone "$tz" >/dev/null 2>&1

    display_explanation "Configurando idioma, fuso e SWAP..." "Configuring locales, timezone and SWAP..."
    apt_update_indices || return 1
    apt_install locales systemd-timesyncd
    locale-gen pt_BR.UTF-8 en_US.UTF-8 es_ES.UTF-8 >/dev/null 2>&1
    case "$SYS_LANG" in
        pt) update-locale LANG=pt_BR.UTF-8 ;;
        es) update-locale LANG=es_ES.UTF-8 ;;
        *)  update-locale LANG=en_US.UTF-8 ;;
    esac
    systemctl enable --now systemd-timesyncd >/dev/null 2>&1

    if [ "$(swapon --show 2>/dev/null | wc -l)" -le 1 ] && [ ! -f /swapfile ] && [ "$(get_free_space_mb /)" -ge 8192 ]; then
        fallocate -l 4G /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=4096 status=none
        chmod 600 /swapfile
        mkswap /swapfile >/dev/null 2>&1
        swapon /swapfile 2>/dev/null && echo '/swapfile none swap sw 0 0' >> /etc/fstab
    fi

    display_explanation "Atualizando sistema e instalando dependências base..." "Upgrading system and base dependencies..."
    DEBIAN_FRONTEND=noninteractive apt-get upgrade "${APT_OPTS[@]}" || { msg_error "" "System upgrade failed."; return 1; }
    apt_install nano wget gnupg ca-certificates ufw apt-transport-https openssh-client fail2ban libsasl2-modules rclone avahi-daemon memcached libxml2-utils pv || return 1
    systemctl enable --now avahi-daemon fail2ban memcached >/dev/null 2>&1

    display_explanation "Adicionando repositório oficial do Koha..." "Adding official Koha repository..."
    mkdir -p /usr/share/keyrings
    curl -fsSL --retry 3 https://debian.koha-community.org/koha/gpg.asc | gpg --dearmor --yes -o /usr/share/keyrings/koha-keyring.gpg 2>/dev/null || return 1
    echo "deb [signed-by=/usr/share/keyrings/koha-keyring.gpg] https://debian.koha-community.org/koha stable main" > /etc/apt/sources.list.d/koha.list
    apt_update_indices || return 1

    display_explanation "Instalando MariaDB e Koha (etapa mais demorada)..." "Installing MariaDB and Koha (longest step)..."
    apt_install mariadb-server koha-common || return 1
    systemctl enable --now mariadb >/dev/null 2>&1

    display_explanation "Configurando Apache e preparando o Koha..." "Configuring Apache and preparing Koha..."
    define_koha_sites_conf
    a2enmod rewrite cgi deflate headers proxy proxy_http >/dev/null 2>&1
    grep -qE '^[[:space:]]*Listen[[:space:]]+8080' /etc/apache2/ports.conf 2>/dev/null || sed -i '/^[[:space:]]*Listen[[:space:]]\+80$/a Listen 8080' /etc/apache2/ports.conf
    systemctl restart apache2 memcached >/dev/null 2>&1

    if [ -d "/etc/koha/sites/${INSTANCE}" ] || [ "$(run_sql "SELECT 1 FROM information_schema.schemata WHERE schema_name='${DB_NAME}';")" = "1" ]; then
        prompt_yes_no "$(t "Instância Existente" "Existing Instance")" "$(t "O Koha já está instalado. REINSTALAR APAGARÁ TUDO!\n\nContinuar?" "Koha is already installed. REINSTALLING DELETES EVERYTHING!\n\nContinue?")" 10 70 || return 0
        local confirm
        confirm=$(dialog --title "$(t "CONFIRMAÇÃO" "CONFIRMATION")" --inputbox "$(t "Digite REINSTALAR para continuar:" "Type REINSTALL to continue:")" 10 50 3>&1 1>&2 2>&3) || return 0
        [ "$confirm" != "$(t "REINSTALAR" "REINSTALL")" ] && return 0
        
        manage_koha_indexers stop
        [ -d "/etc/koha/sites/${INSTANCE}" ] && koha-remove "$INSTANCE" >/dev/null 2>&1
        mysql -e "DROP DATABASE IF EXISTS ${DB_NAME}; DROP USER IF EXISTS '${DB_NAME}'@'localhost'; FLUSH PRIVILEGES;" >/dev/null 2>&1
        rm -rf "/etc/koha/sites/${INSTANCE}"
    fi

    display_explanation "Criando a instância de banco e bibliotecas..." "Creating database instance and libraries..."
    koha-create --create-db "$INSTANCE" || { msg_error "" "Failed to create Koha instance."; return 1; }

    sed -i 's/__MEMCACHED_SERVERS__/127.0.0.1:11211/g; s/__MEMCACHED_PREFIX__/koha_library:/g' "$KOHA_CONF" 2>/dev/null
    a2dissite 000-default >/dev/null 2>&1
    a2ensite "$INSTANCE" >/dev/null 2>&1
    systemctl restart apache2 memcached koha-common >/dev/null 2>&1

    koha-plack --enable "$INSTANCE" >/dev/null 2>&1
    koha-plack --start  "$INSTANCE" >/dev/null 2>&1
    koha-zebra --enable "$INSTANCE" >/dev/null 2>&1
    koha-zebra --start  "$INSTANCE" >/dev/null 2>&1
    systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1
    
    write_cron_zebra
    manage_koha_indexers start >/dev/null 2>&1

    display_explanation "Finalizando credenciais e rotinas automáticas..." "Finalizing credentials and automatic routines..."
    local db_pass ip
    db_pass=$(get_database_password)
    ip=$(get_server_ip)
    
    write_backup_scripts
    write_cron_tasks
    configure_firewall
    write_banner "$ip"

    cat > /root/credenciais_koha.txt << EOF
======================================================================
 CREDENCIAIS DO KOHA / KOHA CREDENTIALS  (instancia: ${INSTANCE})
 Gerado em / Generated on: $(date '+%F %T')
======================================================================
 Staff (administracao) : http://${ip}:8080
 OPAC  (catalogo)      : http://${ip}:80

 Usuario / Username    : ${DB_NAME}
 Senha   / Password    : ${db_pass}
======================================================================
EOF
    chmod 600 /root/credenciais_koha.txt
    [ -f "$0" ] && install -m 755 "$0" /usr/local/bin/options.sh 2>/dev/null

    apt-get clean -y >/dev/null 2>&1
    DEBIAN_FRONTEND=noninteractive apt-get autoremove --purge -y >/dev/null 2>&1

    clear
    msg_ok "$(t "INSTALAÇÃO CONCLUÍDA!\n\nAcesse a Interface Staff para concluir o Web Installer:\nhttp://${ip}:8080\n\nUsuário: ${DB_NAME}\nSenha:   ${db_pass}" "INSTALLATION COMPLETE!\n\nAccess the Staff Interface to finish Web Installer:\nhttp://${ip}:8080\n\nUser: ${DB_NAME}\nPass: ${db_pass}")" 15 74

    prompt_yes_no "$(t "Reiniciar Servidor" "Reboot Server")" "$(t "É recomendado reiniciar agora para carregar a SWAP e aplicar tunings.\nReiniciar?" "Reboot is recommended to load SWAP and apply tunings.\nReboot now?")" 10 70 && reboot
}

# ======================================================================
# 17. RESTAURAÇÃO DE BACKUP COM ROLLBACK ATÔMICO
# ======================================================================
backup_database_for_rollback() {
    local dest="$1"
    mkdir -p "$(dirname "$dest")"
    if ! mysqldump --single-transaction --quick --routines --triggers --default-character-set=utf8mb4 "$DB_NAME" 2>>"$RUN_LOG" | gzip >"$dest"; then
        rm -f "$dest"; return 1
    fi
    gzip -t "$dest" >/dev/null 2>&1 || { rm -f "$dest"; return 1; }
    return 0
}

rollback_database_from_backup() {
    local backup="$1" pass db_pass_sql
    [ -s "$backup" ] || return 1
    pass=$(get_database_password) || return 1
    db_pass_sql=$(sql_escape_literal "$pass")

    mysql -e "DROP DATABASE IF EXISTS ${DB_NAME}; CREATE DATABASE ${DB_NAME} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
              CREATE USER IF NOT EXISTS '${DB_NAME}'@'localhost' IDENTIFIED BY '${db_pass_sql}';
              ALTER USER '${DB_NAME}'@'localhost' IDENTIFIED BY '${db_pass_sql}';
              GRANT ALL PRIVILEGES ON ${DB_NAME}.* TO '${DB_NAME}'@'localhost'; FLUSH PRIVILEGES;" >/dev/null 2>&1 || return 1
    
    gzip -dc -- "$backup" | mysql --default-character-set=utf8mb4 "$DB_NAME" >/dev/null 2>&1 || return 1
    return 0
}

restore_engine_after_database_rollback() {
    local old_engine="$1"
    if [ "$old_engine" = "Elasticsearch" ]; then
        set_xml_elasticsearch inserir >/dev/null 2>&1 || true
        set_search_engine "Elasticsearch"
        systemctl restart elasticsearch memcached koha-common >/dev/null 2>&1 || true
        manage_koha_indexers start >/dev/null 2>&1
    else
        set_xml_elasticsearch remover >/dev/null 2>&1 || true
        set_search_engine "Zebra"
        manage_koha_indexers stop >/dev/null 2>&1
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
    fi
    koha-plack --restart "$INSTANCE" >/dev/null 2>&1 || true
}

import_sql_backup() {
    local file="$1"
    if [[ "$file" == *.gz ]]; then gzip -dc -- "$file" | mysql --default-character-set=utf8mb4 "$DB_NAME"
    else mysql --default-character-set=utf8mb4 "$DB_NAME" < "$file"; fi
}

function_restore_database() {
    require_koha || return 0
    local file; file=$(select_file "$REAL_HOME") || return 0
    [ -z "$file" ] && return 0

    display_explanation "Inspecionando integridade do backup..." "Inspecting backup integrity..."
    if [[ "$file" == *.gz ]] && ! gzip -t "$file" 2>/dev/null; then
        msg_error "" "$(t "Arquivo corrompido (falha no teste gzip)." "Corrupted file (failed gzip test).")" 8 60; return 0
    fi

    prompt_yes_no "$(t "Confirmar Restauração" "Confirm Restore")" "$(t "Arquivo: $file\n\nATENÇÃO: O banco atual será SUBSTITUÍDO.\nUm backup de rollback será criado automaticamente.\n\nContinuar?" "File: $file\n\nWARNING: The current DB will be REPLACED.\nA rollback backup will be created automatically.\n\nContinue?")" 12 74 || return 0
    
    clear
    exec 9>"/var/lock/koha_backup.lock"
    if ! flock -n 9; then msg_error "" "Operação bloqueada por outro backup em andamento."; return 0; fi

    local rollback_file="${DIR_SQL}/PRE-RESTORE_${DB_NAME}_$(date +%Y%m%d-%H%M%S).sql.gz"
    local old_engine; old_engine=$(get_search_engine)
    [ "$old_engine" = "Elasticsearch" ] || old_engine="Zebra"

    if ! backup_database_for_rollback "$rollback_file"; then
        flock -u 9; msg_error "" "$(t "Falha ao criar o backup de segurança para rollback. Abortando." "Failed to create safety rollback backup. Aborting.")" 9 74; return 1
    fi

    manage_koha_indexers stop
    systemctl stop "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true

    local configured_db_pass; configured_db_pass=$(get_database_password)
    [ -z "$configured_db_pass" ] && configured_db_pass=$(python3 -c 'import secrets,string; print("".join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))')
    local db_pass_sql; db_pass_sql=$(sql_escape_literal "$configured_db_pass")

    display_explanation "Recriando banco e importando dados..." "Recreating DB and importing data..."
    mysql -e "DROP DATABASE IF EXISTS ${DB_NAME}; CREATE DATABASE ${DB_NAME} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci; CREATE USER IF NOT EXISTS '${DB_NAME}'@'localhost' IDENTIFIED BY '${db_pass_sql}'; ALTER USER '${DB_NAME}'@'localhost' IDENTIFIED BY '${db_pass_sql}'; GRANT ALL PRIVILEGES ON ${DB_NAME}.* TO '${DB_NAME}'@'localhost'; FLUSH PRIVILEGES;" >/dev/null 2>&1

    if ! import_sql_backup "$file"; then
        log "Falha na importação. Executando rollback."
        rollback_database_from_backup "$rollback_file" && restore_engine_after_database_rollback "$old_engine"
        flock -u 9; msg_error "" "$(t "Importação falhou. Banco revertido para o estado anterior." "Import failed. Database rolled back to previous state.")" 9 70; return 1
    fi

    display_explanation "Atualizando schema do Koha..." "Upgrading Koha schema..."
    systemctl restart memcached >/dev/null 2>&1 || true
    if ! koha-upgrade-schema "$INSTANCE"; then
        rollback_database_from_backup "$rollback_file" && restore_engine_after_database_rollback "$old_engine"
        flock -u 9; msg_error "" "$(t "Migração do schema falhou. Banco revertido." "Schema migration failed. Database rolled back.")" 9 70; return 1
    fi

    display_explanation "Sincronizando motores de busca..." "Synchronizing search engines..."
    local engine="Zebra"
    if dpkg -s koha-elasticsearch >/dev/null 2>&1 && is_koha_es_active_in_xml; then engine="Elasticsearch"; fi
    set_search_engine "$engine"

    if [ "$engine" = "Elasticsearch" ]; then
        prepare_koha_broker || { rollback_database_from_backup "$rollback_file"; restore_engine_after_database_rollback "$old_engine"; flock -u 9; msg_error "" "Falha ao configurar mensageria ES."; return 1; }
        systemctl restart koha-common >/dev/null 2>&1 || true
        manage_koha_indexers start
        rebuild_koha_elasticsearch "$(date '+%Y-%m-%d %H:%M:%S')" || msg_error "" "O banco foi restaurado, mas a reconstrução do índice Elasticsearch falhou. Repare-o na Central de Manutenção."
    else
        systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true
        write_cron_zebra
        koha-rebuild-zebra -f -v -b -a "$INSTANCE" || msg_error "" "A reindexação do Zebra falhou."
    fi

    flock -u 9
    koha-plack --restart "$INSTANCE" >/dev/null 2>&1 || true
    msg_ok "$(t "Restauração concluída!\n\nMotor atual: $engine\nPonto de segurança mantido em: $rollback_file" "Restore complete!\n\nCurrent engine: $engine\nSafety backup kept at: $rollback_file")" 11 74
}

# ======================================================================
# 18. OPERAÇÕES DE BACKUP E NUVEM (MANUAL, SCP, RCLONE)
# ======================================================================
function_manual_backup() {
    require_database || return 0
    msg_info "$(t "Destino do Backup" "Backup Destination")" "$(t "Escolha a pasta para salvar o arquivo." "Choose the folder to save the file.")" 8 60
    local target_dir; target_dir=$(select_directory "$REAL_HOME") || return 0
    [ -z "$target_dir" ] && return 0
    
    exec 9>"/var/lock/koha_backup.lock"
    if ! flock -n 9; then msg_error "" "Outro backup ou restauração já está em andamento."; return 0; fi

    local file="${target_dir%/}/${DB_NAME}_manual_$(date +%Y-%m-%d_%Hh%M).sql.gz"
    display_explanation "Gerando o backup local..." "Generating local backup..."
    if mysqldump --single-transaction --quick --routines --triggers --default-character-set=utf8mb4 "$DB_NAME" | gzip > "$file" && gzip -t "$file" 2>/dev/null; then
        flock -u 9
        msg_ok "$(t "Backup gerado:\n$file\n\nTamanho: $(du -h "$file" | cut -f1)" "Backup generated:\n$file\n\nSize: $(du -h "$file" | cut -f1)")" 10 70
    else
        rm -f "$file"; flock -u 9
        msg_error "" "$(t "Falha ao gerar backup. Verifique espaço em disco." "Failed to generate backup. Check disk space.")" 9 60
    fi
}

function_send_manual_scp_backup() {
    require_database || return 0
    local host user port folder key use_saved="no"

    if [ -f "$SCP_BACKUP_CONF" ] && grep -q '^SCP_HOST="[^"]\+"' "$SCP_BACKUP_CONF" 2>/dev/null; then
        . "$SCP_BACKUP_CONF"
        if prompt_yes_no "SCP" "$(t "Usar destino salvo: ${SCP_USER}@${SCP_HOST}:${SCP_FOLDER}?" "Use saved destination: ${SCP_USER}@${SCP_HOST}:${SCP_FOLDER}?")" 9 70; then
            host="$SCP_HOST"; user="$SCP_USER"; port="$SCP_PORT"; folder="$SCP_FOLDER"; key="$SCP_KEY"
            [ -n "$key" ] && [ ! -r "$key" ] && { msg_error "" "Chave não encontrada: $key"; return 1; }
            use_saved="yes"
        fi
    fi

    if [ "$use_saved" = "no" ]; then
        host=$(dialog --title "SCP" --inputbox "$(t "IP/Domínio de destino:" "Destination IP/Domain:")" 9 60 3>&1 1>&2 2>&3) || return 0
        user=$(dialog --title "SCP" --inputbox "$(t "Usuário SSH:" "SSH User:")" 9 60 "$REAL_USER" 3>&1 1>&2 2>&3) || return 0
        port=$(dialog --title "SCP" --inputbox "$(t "Porta SSH:" "SSH Port:")" 9 60 "22" 3>&1 1>&2 2>&3) || return 0
        folder=$(dialog --title "SCP" --inputbox "$(t "Pasta no destino:" "Remote Folder:")" 9 60 "/home/${user}/Desktop" 3>&1 1>&2 2>&3) || return 0
        key=""
    fi

    exec 9>"/var/lock/koha_backup.lock"
    if ! flock -n 9; then msg_error "" "Outro backup em andamento."; return 1; fi

    local target="${DIR_SQL}/${DB_NAME}_manual_scp_$(date +%Y%m%d%H%M).sql.gz"
    mkdir -p "$DIR_SQL"
    display_explanation "Gerando o backup para envio..." "Generating backup for transfer..."
    if ! (mysqldump --single-transaction --quick --routines --triggers --default-character-set=utf8mb4 "$DB_NAME" | gzip > "$target" && gzip -t "$target" 2>/dev/null); then
        rm -f "$target"; flock -u 9; msg_error "" "Falha ao gerar backup SQL local."; return 1
    fi

    display_explanation "Enviando para ${user}@${host} via SCP..." "Sending via SCP..."
    local opts=(-P "$port" -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new)
    [ -n "$key" ] && opts+=(-i "$key")

    if scp "${opts[@]}" "$target" "${user}@${host}:${folder%/}/" 2>&1 | tee -a "$RUN_LOG"; then
        flock -u 9; msg_ok "$(t "Backup enviado com sucesso para ${host}:${folder}" "Backup sent successfully to ${host}:${folder}")" 9 66
    else
        flock -u 9; msg_error "" "$(t "Falha no SCP. A cópia local foi salva em $target" "SCP failed. Local copy saved at $target")" 9 70
    fi
}

function_configure_automatic_scp_backup() {
    write_scp_backup_config
    local host user port folder key="/root/.ssh/koha_backup_ed25519"
    
    host=$(dialog --title "Auto SCP" --inputbox "$(t "IP/Domínio de destino:" "Destination IP/Domain:")" 9 60 3>&1 1>&2 2>&3) || return 0
    user=$(dialog --title "Auto SCP" --inputbox "$(t "Usuário SSH:" "SSH User:")" 9 60 "$REAL_USER" 3>&1 1>&2 2>&3) || return 0
    port=$(dialog --title "Auto SCP" --inputbox "$(t "Porta SSH:" "SSH Port:")" 9 60 "22" 3>&1 1>&2 2>&3) || return 0
    folder=$(dialog --title "Auto SCP" --inputbox "$(t "Pasta destino (deve existir):" "Remote folder (must exist):")" 9 60 "/home/${user}/koha_backups" 3>&1 1>&2 2>&3) || return 0

    mkdir -p /root/.ssh && chmod 700 /root/.ssh
    if [ ! -f "$key" ]; then
        ssh-keygen -t ed25519 -f "$key" -N "" -C "koha-backup@$(hostname)" >/dev/null 2>&1
    fi

    clear
    echo "======================================================================"
    echo "$(t "AUTORIZAÇÃO SSH NO DESTINO" "SSH DESTINATION AUTHORIZATION")"
    echo "$(t "A senha do usuário '${user}' no destino será solicitada UMA ÚNICA VEZ." "Password for '${user}' will be asked ONCE.")"
    echo "======================================================================"
    if ssh-copy-id -p "$port" -i "${key}.pub" -o StrictHostKeyChecking=accept-new "${user}@${host}"; then
        echo -e "\n[OK] Chave autorizada!"
    else
        msg_info "SCP" "$(t "Copie a chave pública abaixo para o ~/.ssh/authorized_keys do destino:\n\n$(cat "${key}.pub")" "Copy this key to target's authorized_keys:\n\n$(cat "${key}.pub")")" 18 78
    fi

    display_explanation "Testando conexão..." "Testing connection..."
    if ! ssh -p "$port" -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 "${user}@${host}" "mkdir -p -- '$folder' && echo OK" | grep -q OK; then
        msg_error "" "$(t "A conexão sem senha falhou." "Passwordless connection failed.")" 9 60; return 1
    fi

    set_shell_config_value "$SCP_BACKUP_CONF" SCP_HOST "$host"
    set_shell_config_value "$SCP_BACKUP_CONF" SCP_USER "$user"
    set_shell_config_value "$SCP_BACKUP_CONF" SCP_PORT "$port"
    set_shell_config_value "$SCP_BACKUP_CONF" SCP_FOLDER "$folder"
    set_shell_config_value "$SCP_BACKUP_CONF" SCP_KEY "$key"

    msg_ok "$(t "Backup SCP Diário configurado para:\n${user}@${host}:${folder}" "Daily SCP backup configured for:\n${user}@${host}:${folder}")" 10 70
}

function_configure_rclone() {
    local choice; choice=$(dialog --title "Rclone" --menu "$(t "Configurar Envio em Nuvem:" "Configure Cloud Storage:")" 12 70 2 "1" "Google Drive (Express/JSON Token)" "2" "$(t "Outro / Assistente Rclone" "Other / Rclone Wizard")" 3>&1 1>&2 2>&3) || return 0
    if [ "$choice" = "1" ]; then
        clear
        echo -e "\e[1;36mCONFIGURAÇÃO EXPRESSA DO GOOGLE DRIVE\e[0m\n"
        echo "$(t "No seu computador pessoal (Windows/Linux/Mac), execute:" "On your personal computer, run:")"
        echo -e "\e[1;33mrclone authorize \"drive\"\e[0m\n"
        echo "$(t "O navegador vai abrir. Autorize o login e cole o JSON gerado abaixo:" "Authorize in the browser and paste the JSON below:")"
        
        local token_input
        while true; do
            read -r token_input
            if python3 -c 'import sys, json; json.loads(sys.argv[1])' "$token_input" 2>/dev/null; then break; fi
            echo -e "\e[1;31mJSON inválido. Tente colar exatamente o bloco todo (com as chaves {}):\e[0m"
        done

        rclone config delete gdrive >/dev/null 2>&1 || true
        if rclone config create gdrive drive config_is_local false token "$token_input" --non-interactive < /dev/null >/dev/null 2>&1; then
            write_backup_config
            set_shell_config_value "$BACKUP_CONF" RCLONE_REMOTE "gdrive"
            msg_ok "Google Drive configurado (remote: gdrive)." 8 60
        else
            echo "Falha ao registrar gdrive no Rclone."; sleep 3
        fi
    else
        clear; rclone config
        local conn_name; conn_name=$(dialog --title "Rclone" --inputbox "$(t "Qual NOME EXATO do remote criado?" "What is the EXACT remote name created?")" 9 60 3>&1 1>&2 2>&3) || return 0
        if rclone listremotes 2>/dev/null | grep -qx "${conn_name}:"; then
            write_backup_config
            set_shell_config_value "$BACKUP_CONF" RCLONE_REMOTE "$conn_name"
            msg_ok "Remote '${conn_name}' salvo com sucesso." 8 60
        else
            msg_error "" "O remote '$conn_name' não foi encontrado no Rclone." 9 60
        fi
    fi
}

# ======================================================================
# 19. DIAGNÓSTICO E REPARO DO BANCO DE DADOS (DBA)
# ======================================================================
function_test_latest_backup() {
    local latest=$(find "$DIR_SQL" -type f \( -name "*.sql" -o -name "*.sql.gz" \) -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -f2- -d' ')
    [ -z "$latest" ] && { msg_error "" "Nenhum backup local encontrado em $DIR_SQL"; return 1; }

    exec 9>"/var/lock/koha_backup.lock"
    if ! flock -n 9; then msg_error "" "Operação bloqueada por tarefa em andamento."; return 1; fi

    clear
    display_explanation "Testando importação estrutural em base temporária...\nArquivo: $(basename "$latest")" "Testing structural import in temporary DB..."
    
    local test_db="koha_test_$$_$(date +%s)"
    mysql -e "DROP DATABASE IF EXISTS ${test_db}; CREATE DATABASE ${test_db} CHARACTER SET utf8mb4;" || { flock -u 9; return 1; }

    if [[ "$latest" =~ \.gz$ ]]; then
        gzip -dc "$latest" | mysql --default-character-set=utf8mb4 "$test_db" 2>/dev/null
    else
        mysql --default-character-set=utf8mb4 "$test_db" < "$latest" 2>/dev/null
    fi

    local tables; tables=$(mysql -N -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${test_db}';" 2>/dev/null || echo "0")
    mysql -e "DROP DATABASE IF EXISTS ${test_db};" 2>/dev/null
    flock -u 9

    if [ "$tables" -ge 100 ]; then
        msg_ok "$(t "O backup ($tables tabelas) passou no teste de importação estrutural!" "The backup ($tables tables) passed structural import test!")" 10 74
    else
        msg_error "" "$(t "O arquivo falhou no teste (gerou apenas $tables tabelas)." "File failed the test (generated only $tables tables).")" 9 70
    fi
}

function_validate_repair_database() {
    require_database || return 0
    while true; do
        local sub=$(dialog --title "$(t "Diagnóstico e Reparo" "Diagnostics & Repair")" --menu "$(t "Ações no MariaDB:" "MariaDB Actions:")" 16 76 4 \
            "1" "$(t "Validar o último backup (Dry-run temp DB)" "Validate latest backup (Temp DB dry-run)")" \
            "2" "$(t "Checagem de integridade (CHECK)" "Integrity check (CHECK)")" \
            "3" "$(t "Análise e estatísticas (ANALYZE)" "Analysis and stats (ANALYZE)")" \
            "4" "$(t "Otimização/Reparo Profundo (REPAIR)" "Deep Optimize/Repair (REPAIR)")" 3>&1 1>&2 2>&3) || break
        
        case "$sub" in
            1) function_test_latest_backup ;;
            2|3)
                clear
                local mode="--check" title="CHECK"
                [ "$sub" = "3" ] && { mode="--analyze"; title="ANALYZE"; }
                display_explanation "Executando mysqlcheck $mode..." "Running mysqlcheck $mode..."
                local tlog="/tmp/mariadb_${title}.log"
                mysqlcheck $mode --databases "$DB_NAME" > "$tlog" 2>&1
                dialog --title "Resultado / Result" --scrolltext --textbox "$tlog" 20 80
                rm -f "$tlog"
                ;;
            4)
                prompt_yes_no "Otimizar Banco" "$(t "Executar REPAIR, OPTIMIZE e limpar sessões velhas?" "Run REPAIR, OPTIMIZE and clear old sessions?")" 10 70 || continue
                clear
                exec 9>"/var/lock/koha_backup.lock"
                if ! flock -n 9; then msg_error "" "Operação bloqueada."; continue; fi
                
                display_explanation "Reparando e otimizando MariaDB..." "Repairing and optimizing MariaDB..."
                local rlog="${LOG_DIR}/mariadb_repair.log"
                {
                    mysqlcheck --repair --databases "$DB_NAME"
                    mysqlcheck --optimize --databases "$DB_NAME"
                    koha-shell "$INSTANCE" -c "/usr/share/koha/bin/cronjobs/cleanup_database.pl --sessions --sessdays 7 --zebraqueue 10"
                    journalctl --vacuum-time=14d
                } > "$rlog" 2>&1
                
                flock -u 9
                systemctl restart memcached >/dev/null 2>&1
                dialog --title "Otimização / Optimization" --scrolltext --textbox "$rlog" 20 80
                ;;
        esac
    done
}

# ======================================================================
# 20. GERENCIAMENTO DO MOTOR DE BUSCA (ALTERNÂNCIA)
# ======================================================================
function_toggle_search_engine() {
    require_database || return 0
    local engine; engine=$(get_search_engine)
    
    if [ "$engine" = "Elasticsearch" ]; then
        prompt_yes_no "Zebra" "$(t "Voltar o motor de busca para ZEBRA?\nO índice do Elasticsearch não será removido." "Revert search engine to ZEBRA?")" 10 70 || return 0
        clear
        exec 7>"/var/lock/koha_es_rebuild.lock"
        if ! flock -n 7; then msg_error "" "Bloqueado: Reindexação em andamento."; return 1; fi
        
        display_explanation "Trocando motor de volta para o Zebra..." "Switching engine back to Zebra..."
        manage_koha_indexers stop
        set_xml_elasticsearch remover || { flock -u 7; msg_error "" "Falha ao editar XML."; return 1; }
        set_search_engine "Zebra"
        
        systemctl disable --now elasticsearch >/dev/null 2>&1 || true
        force_stop_koha_zebra
        rm -f /var/lock/koha/${INSTANCE}/rebuild/*.LCK 2>/dev/null
        chown -R "${INSTANCE}-koha:${INSTANCE}-koha" "/var/lib/koha/${INSTANCE}/biblios" "/var/lock/koha/${INSTANCE}" 2>/dev/null || true
        
        systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1
        write_cron_zebra
        systemctl restart memcached koha-common >/dev/null 2>&1
        
        display_explanation "Reconstruindo o Zebra..." "Rebuilding Zebra..."
        koha-rebuild-zebra -f -v -b -a -r "$INSTANCE"
        koha-plack --restart "$INSTANCE" >/dev/null 2>&1
        flock -u 7
        msg_ok "Motor alterado para ZEBRA com sucesso." 8 60
        return 0
    fi

    prompt_yes_no "Elasticsearch" "$(t "Ativar ELASTICSEARCH? (Exige ~1.5GB de RAM a mais)." "Enable ELASTICSEARCH? (Requires ~1.5GB extra RAM).")" 10 70 || return 0
    if [ "$(get_free_space_mb /)" -lt 4096 ]; then prompt_yes_no "Aviso" "$(t "Menos de 4GB no disco. Continuar?" "Less than 4GB disk space. Continue?")" 9 60 || return 0; fi

    clear
    exec 7>"/var/lock/koha_es_rebuild.lock"
    if ! flock -n 7; then msg_error "" "Bloqueado."; return 1; fi

    display_explanation "Desativando o Zebra..." "Disabling Zebra..."
    rm -f "$CRON_ZEBRA"; systemctl restart cron >/dev/null 2>&1
    systemctl disable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1 || true

    if ! dpkg -s elasticsearch >/dev/null 2>&1 || ! dpkg -s koha-elasticsearch >/dev/null 2>&1; then
        display_explanation "Instalando pacotes do Elasticsearch..." "Installing Elasticsearch packages..."
        if ! ensure_elasticsearch_repository || ! apt_install elasticsearch koha-elasticsearch; then
            write_cron_zebra; systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1
            flock -u 7; msg_error "" "Falha ao instalar o ES. Zebra restaurado."; return 1
        fi
    fi

    display_explanation "Configurando Elasticsearch..." "Configuring Elasticsearch..."
    adjust_elasticsearch_heap
    set_shell_config_value /etc/elasticsearch/elasticsearch.yml discovery.type single-node
    set_shell_config_value /etc/elasticsearch/elasticsearch.yml network.host 127.0.0.1
    
    if ! /usr/share/elasticsearch/bin/elasticsearch-plugin list 2>/dev/null | grep -q '^analysis-icu$'; then
        /usr/share/elasticsearch/bin/elasticsearch-plugin install --batch analysis-icu >/dev/null 2>&1 || true
    fi

    systemctl daemon-reload
    systemctl enable --now elasticsearch >/dev/null 2>&1
    
    local es_ok="no"
    for _ in $(seq 1 45); do curl -sS --max-time 2 http://127.0.0.1:9200 >/dev/null 2>&1 && { es_ok="yes"; break; }; sleep 2; done
    if [ "$es_ok" = "no" ]; then
        write_cron_zebra; systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1
        flock -u 7; msg_error "" "Elasticsearch não subiu na porta 9200. Zebra restaurado."; return 1
    fi

    display_explanation "Injetando tags no XML e configurando banco..." "Injecting XML tags and DB config..."
    if ! set_xml_elasticsearch inserir || ! set_search_engine "Elasticsearch" || ! prepare_koha_broker; then
        set_xml_elasticsearch remover >/dev/null 2>&1 || true
        set_search_engine "Zebra"
        write_cron_zebra; systemctl enable --now "koha-zebra-daemon@${INSTANCE}" >/dev/null 2>&1
        flock -u 7; msg_error "" "Erro ao injetar configurações do ES. Zebra restaurado."; return 1
    fi

    curl -sS -X DELETE --max-time 10 "http://127.0.0.1:9200/${DB_NAME}_biblios" >/dev/null 2>&1 || true
    systemctl restart memcached koha-common >/dev/null 2>&1
    manage_koha_indexers start

    display_explanation "Reconstruindo o Índice Elasticsearch..." "Rebuilding Elasticsearch Index..."
    local cut_time; cut_time=$(date '+%Y-%m-%d %H:%M:%S')
    local rebuild_ok="yes"
    rebuild_koha_elasticsearch "$cut_time" || rebuild_ok="no"
    
    koha-plack --restart "$INSTANCE" >/dev/null 2>&1
    flock -u 7

    if [ "$rebuild_ok" = "yes" ]; then
        msg_ok "ELASTICSEARCH ativado e indexado com sucesso!" 8 60
    else
        msg_error "" "ES ativado, mas a reindexação final falhou. Use a opção de reparar índices." 9 70
    fi
}

function_repair_indexing() {
    require_database || return 0
    if [ "$(get_search_engine)" = "Elasticsearch" ]; then
        prompt_yes_no "Reparar ES" "$(t "Reiniciar ES e reindexar?" "Restart ES and reindex?")" 8 60 || return 0
        clear
        systemctl restart elasticsearch memcached koha-common >/dev/null 2>&1
        manage_koha_indexers start
        rebuild_koha_elasticsearch "$(date '+%Y-%m-%d %H:%M:%S')"
        koha-plack --restart "$INSTANCE" >/dev/null 2>&1
        msg_ok "Comando de reparo do ES enviado." 8 60
    else
