#!/bin/bash
# ======================================================================
# KOHA EASY INSTALL - ADVANCED MANAGEMENT SUITE
# [POR] Suíte completa de implantação, manutenção, tuning e backups.
# [EN] Complete suite for deployment, maintenance, tuning, and backups.
# ======================================================================

set -e
set -o pipefail

# ======================================================================
# ELEVAÇÃO AUTOMÁTICA DE PRIVILÉGIOS / AUTOMATIC PRIVILEGE ESCALATION
# ======================================================================
if [ "$EUID" -ne 0 ]; then
  echo -e "\n+-----------------------------------------------------------------------------------------+"
  echo -e "| [POR] Privilégios de administrador (root) necessários. Digite sua senha:                 |"
  echo -e "| [EN]  Root privileges required. Please enter your password:                              |"
  echo -e "+-----------------------------------------------------------------------------------------+\n"
  
  if [ -f "$0" ]; then
    exec sudo bash "$0" "$@"
  else
    echo "ERRO/ERROR: Execute como root / Run with root privileges: 'sudo bash ...'"
    exit 1
  fi
fi

REAL_USER="${SUDO_USER:-$USER}"
REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
[ -z "$REAL_HOME" ] && REAL_HOME="/home/$REAL_USER"

# ======================================================================
# FUNÇÃO DE CAIXAS DE EXPLICAÇÃO / EXPLANATION BOX FUNCTION
# ======================================================================
caixa_explicacao() {
    local msg_pt="$1"
    local msg_en="$2"
    echo -e "\n+-----------------------------------------------------------------------------------------+"
    echo -e "| [POR] $msg_pt"
    echo -e "| [EN]  $msg_en"
    echo -e "+-----------------------------------------------------------------------------------------+\n"
}

# ======================================================================
# EXPLORADOR DE ARQUIVOS NATIVO / NATIVE FILE EXPLORER (TUI)
# ======================================================================
selecionar_arquivo() {
    local atual="${1:-/}"
    while true; do
        local itens=()
        if [ "$atual" != "/" ]; then
            itens+=(".." "[Voltar para o diretorio anterior / Back]")
        fi
        
        while IFS= read -r d; do
            [ -z "$d" ] && continue
            itens+=("$d" "[Pasta / Folder]")
        done <<< "$(find "$atual" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)"
        
        while IFS= read -r f; do
            [ -z "$f" ] && continue
            itens+=("$f" "Backup Database")
        done <<< "$(find "$atual" -mindepth 1 -maxdepth 1 -type f \( -name "*.sql" -o -name "*.sql.gz" \) -printf '%f\n' 2>/dev/null | sort)"

        if [ ${#itens[@]} -eq 0 ]; then
            itens+=(".." "[Diretório Vazio - Voltar / Empty - Go back]")
        fi

        escolha=$(whiptail --title "Explorador de Arquivos / File Explorer" --menu "Navegando em / Browsing:\n$atual\n\nSelecione o arquivo de backup (.sql ou .sql.gz):\nSelect the backup file:" 22 80 12 "${itens[@]}" 3>&1 1>&2 2>&3)

        if [ $? -ne 0 ]; then return 1; fi

        if [ "$escolha" = ".." ]; then
            atual=$(dirname "$atual")
        elif [ -d "$atual/$escolha" ]; then
            atual="$atual/$escolha"
        elif [ -f "$atual/$escolha" ]; then
            echo "$atual/$escolha"
            return 0
        fi
    done
}

selecionar_diretorio() {
    local atual="${1:-/}"
    while true; do
        local dirs=( ">>> SALVAR NESTA PASTA <<<" "Save in: $atual" )
        if [ "$atual" != "/" ]; then
            dirs+=( ".." "[Voltar para o diretorio anterior / Back]" )
        fi
        
        while IFS= read -r d; do
            [ -z "$d" ] && continue
            dirs+=("$d" "[Pasta / Folder]")
        done <<< "$(find "$atual" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)"

        escolha=$(whiptail --title "Seletor de Diretório / Directory Picker" --menu "Navegando em / Browsing:\n$atual\n\nEntre numa pasta ou escolha salvar aqui:" 22 80 12 "${dirs[@]}" 3>&1 1>&2 2>&3)

        if [ $? -ne 0 ]; then return 1; fi

        if [ "$escolha" = ">>> SALVAR NESTA PASTA <<<" ]; then
            echo "$atual"
            return 0
        elif [ "$escolha" = ".." ]; then
            atual=$(dirname "$atual")
        elif [ -d "$atual/$escolha" ]; then
            atual="$atual/$escolha"
        fi
    done
}

# ======================================================================
# FUNÇÃO: AGUARDAR E LIBERAR TRAVAS DO APT / WAIT FOR APT LOCKS
# ======================================================================
aguardar_travas_apt() {
    caixa_explicacao "Verificando travas do APT/DPKG e bloqueando atualizacoes ocultas..." "Checking APT/DPKG locks and blocking hidden background updates..."
    
    systemctl stop apt-daily.timer apt-daily-upgrade.timer unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true

    while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 || \
          fuser /var/lib/apt/lists/lock >/dev/null 2>&1 || \
          fuser /var/lib/dpkg/lock >/dev/null 2>&1; do
        echo "[INFO] Processos em segundo plano estao ativos. Aguardando 3 segundos..."
        sleep 3
    done

    dpkg --configure -a 2>/dev/null || true
}

# ======================================================================
# FUNÇÃO AUXILIAR: Inserir/Remover Elasticsearch no XML com segurança
# ======================================================================
xml_set_elasticsearch() {
    local ACAO="$1"
    local CONF="/etc/koha/sites/library/koha-conf.xml"

    python3 - "$ACAO" "$CONF" << 'PYEOF'
import re
import sys

acao, path = sys.argv[1], sys.argv[2]

with open(path, "r") as f:
    text = f.read()

text = re.sub(r"[ \t]*<elasticsearch>.*?</elasticsearch>[ \t]*\n?", "", text, flags=re.DOTALL)

if acao == "inserir":
    es_block = (
        "  <elasticsearch>\n"
        "    <server>127.0.0.1:9200</server>\n"
        "    <index_name>koha_library</index_name>\n"
        "  </elasticsearch>\n"
    )
    if "</config>" not in text:
        sys.exit("ERRO: tag </config> nao encontrada em koha-conf.xml - abortando.")
    text = text.replace("</config>", es_block + "</config>")

with open(path, "w") as f:
    f.write(text)
PYEOF
}

# ======================================================================
# FUNÇÃO AUXILIAR: Gerenciar o koha-worker (fila de background jobs)
# ======================================================================
# [POR] HISTORICO DO BUG: o Koha moderno propaga mudancas do catalogo pro
# Elasticsearch atraves de uma fila de "background jobs" (tipo
# "update_elastic_index"), nao mais em tempo real direto. Quem processa
# essa fila e o script background_jobs_worker.pl, gerenciado pelo comando
# oficial "koha-worker" - confirmado no proprio plano de teste de um patch
# do nucleo do Koha (Bug 27844), que usa os arquivos reais de
# debian/templates do pacote. Duas tentativas anteriores usaram nomes de
# comando que pareciam corretos mas nao existiam de fato no pacote
# ("koha-indexer" e depois "koha-es-indexer") - cada uma delas falhava
# silenciosamente (por causa do "|| true"), entao o reindex inicial
# completo funcionava (por isso os registros antigos apareciam na busca),
# mas nenhum registro catalogado depois disso era processado.
# [EN] BUG HISTORY: modern Koha propagates catalog changes to
# Elasticsearch through a "background jobs" queue (e.g.
# "update_elastic_index"), no longer directly in real time. The script
# that processes that queue is background_jobs_worker.pl, managed by the
# official "koha-worker" command - confirmed in a Koha core patch's own
# test plan (Bug 27844), which uses the package's real debian/templates
# files. Two earlier attempts used command names that looked plausible
# but didn't actually exist in the package ("koha-indexer", then
# "koha-es-indexer") - each failed silently (because of "|| true"), so
# the initial full reindex worked (which is why old records showed up in
# search), but nothing catalogued afterwards was ever processed.
koha_worker_gerenciar() {
    local ACAO="$1"   # "start" ou "stop"

    if [ "$ACAO" = "start" ]; then
        koha-worker --start library 2>/dev/null || true
        if systemctl list-unit-files 2>/dev/null | grep -q '^koha-worker@'; then
            systemctl enable --now "koha-worker@library" 2>/dev/null || true
        fi
    else
        koha-worker --stop library 2>/dev/null || true
        if systemctl list-unit-files 2>/dev/null | grep -q '^koha-worker@'; then
            systemctl disable --now "koha-worker@library" 2>/dev/null || true
        fi
    fi
}

koha_worker_esta_rodando() {
    systemctl is-active --quiet "koha-worker@library" 2>/dev/null && return 0
    pgrep -f "background_jobs_worker.*library" >/dev/null 2>&1 && return 0
    pgrep -f "background_jobs_worker" >/dev/null 2>&1 && return 0
    return 1
}

# ======================================================================
# SISTEMA CENTRAL DE VALIDAÇÃO / CENTRAL VALIDATION SYSTEM
# ======================================================================
VALIDACAO_DIR="/var/log/koha-easy-install"
mkdir -p "$VALIDACAO_DIR" 2>/dev/null || true
VALIDACAO_LOG="$VALIDACAO_DIR/validacao-$(date '+%Y%m%d-%H%M%S').log"
V_OK=0; V_WARN=0; V_FAIL=0; V_CONTEXT=""

v_reset() {
    V_OK=0; V_WARN=0; V_FAIL=0; V_CONTEXT="$1"
    VALIDACAO_LOG="$VALIDACAO_DIR/validacao-$(date '+%Y%m%d-%H%M%S').log"
    {
        echo "======================================================================"
        echo "KOHA EASY INSTALL - RELATÓRIO DE VALIDAÇÃO"
        echo "Contexto: $V_CONTEXT"
        echo "Data: $(date '+%Y-%m-%d %H:%M:%S %Z')"
        echo "Host: $(hostname)"
        echo "======================================================================"
    } > "$VALIDACAO_LOG"
}
v_ok(){ V_OK=$((V_OK+1)); printf '[ OK ] %s\n' "$1" | tee -a "$VALIDACAO_LOG"; }
v_warn(){ V_WARN=$((V_WARN+1)); printf '[WARN] %s\n' "$1" | tee -a "$VALIDACAO_LOG"; }
v_fail(){ V_FAIL=$((V_FAIL+1)); printf '[FAIL] %s\n' "$1" | tee -a "$VALIDACAO_LOG"; }
v_info(){ printf '[INFO] %s\n' "$1" | tee -a "$VALIDACAO_LOG"; }

validar_comando(){
    local c="$1" d="$2"
    if command -v "$c" >/dev/null 2>&1; then v_ok "$d: '$c' disponível."; return 0; fi
    v_fail "$d: '$c' não encontrado."; return 1
}
validar_arquivo(){
    local p="$1" d="$2"
    if [ -f "$p" ]; then v_ok "$d: $p"; return 0; fi
    v_fail "$d: arquivo ausente: $p"; return 1
}
validar_servico(){
    local s="$1" d="$2" req="${3:-sim}"
    if ! systemctl cat "$s" >/dev/null 2>&1; then
        [ "$req" = "sim" ] && v_fail "$d: serviço '$s' não encontrado." || v_warn "$d: serviço opcional '$s' não instalado."
        return 1
    fi
    if systemctl is-active --quiet "$s"; then v_ok "$d: serviço '$s' ativo."; return 0; fi
    [ "$req" = "sim" ] && v_fail "$d: serviço '$s' inativo." || v_warn "$d: serviço opcional '$s' inativo."
    return 1
}
validar_porta_local(){
    local p="$1" d="$2"
    if ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "([.:]${p})$"; then v_ok "$d: TCP $p em escuta."; return 0; fi
    v_fail "$d: TCP $p não está em escuta."; return 1
}
validar_http(){
    local u="$1" d="$2" code
    code=$(curl -sS -L --max-time 8 -o /dev/null -w '%{http_code}' "$u" 2>/dev/null || true)
    if [[ "$code" =~ ^[23][0-9][0-9]$ ]]; then v_ok "$d: HTTP $code em $u"; return 0; fi
    v_fail "$d: HTTP inválido em $u (código ${code:-sem resposta})."; return 1
}
validar_mariadb(){
    local c
    if ! mysql -Nse 'SELECT 1;' >/dev/null 2>&1; then v_fail "MariaDB: conexão local falhou."; return 1; fi
    v_ok "MariaDB: conexão local funcionando."
    
    c=$(mysql -Nse "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='koha_library';" 2>/dev/null || echo 0)
    if [[ "$c" =~ ^[0-9]+$ ]] && [ "$c" -gt 50 ]; then 
        v_ok "koha_library: $c tabelas detectadas."
        return 0
    else
        v_warn "koha_library: $c tabelas (Aguardando conclusão do Web Installer no navegador)."
        return 0 # Não falha a instalação se estiver zerado, pois depende do Web Installer!
    fi
}
obter_motor_busca(){ mysql -Nse "SELECT value FROM koha_library.systempreferences WHERE variable='SearchEngine' LIMIT 1;" 2>/dev/null || true; }
validar_koha_instancia(){
    local c="/etc/koha/sites/library/koha-conf.xml" e
    validar_arquivo "$c" "Koha: configuração" || true
    validar_arquivo "/etc/apache2/sites-enabled/library.conf" "Apache: site Koha" || true
    if command -v koha-list >/dev/null 2>&1 && koha-list 2>/dev/null | grep -qx library; then v_ok "Koha: instância 'library' registrada."; else v_fail "Koha: instância 'library' não registrada no koha-list."; fi
    if [ -f "$c" ] && command -v xmllint >/dev/null 2>&1; then
        xmllint --noout "$c" >/dev/null 2>&1 && v_ok "Koha: XML bem formado." || v_fail "Koha: erro de XML em koha-conf.xml."
    elif [ -f "$c" ]; then v_warn "Koha: xmllint indisponível; XML não testado sintaticamente."; fi
    if command -v koha-plack >/dev/null 2>&1; then
        koha-plack --status library >/dev/null 2>&1 && v_ok "Plack: status da instância respondeu." || v_warn "Plack: status da instância não foi confirmado."
    fi
    e=$(obter_motor_busca)
    case "$e" in
        Zebra) v_info "Koha: SearchEngine=Zebra." ;;
        Elasticsearch) v_info "Koha: SearchEngine=Elasticsearch." ;;
        "") v_warn "Koha: preferência SearchEngine ainda não definida (Aguardando Web Installer)." ;;
        *) v_warn "Koha: SearchEngine contém valor inesperado: $e" ;;
    esac
}
validar_zebra(){
    [ "$1" != "Zebra" ] && return 0
    systemctl is-active --quiet koha-zebra-daemon@library && v_ok "Zebra: daemon ativo." || v_warn "Zebra: daemon inativo (Aguardando Web Installer)."
    command -v koha-rebuild-zebra >/dev/null 2>&1 && v_ok "Zebra: ferramenta de rebuild disponível." || v_fail "Zebra: koha-rebuild-zebra ausente."
}
validar_elasticsearch(){
    local e="$1" r
    if ! dpkg -s elasticsearch >/dev/null 2>&1 && ! dpkg -s koha-elasticsearch >/dev/null 2>&1; then
        [ "$e" = "Elasticsearch" ] && v_fail "Elasticsearch: configurado no Koha, mas pacote ausente." || v_warn "Elasticsearch: não instalado; OK enquanto Zebra for o motor atual."
        return 1
    fi
    if systemctl is-active --quiet elasticsearch; then v_ok "Elasticsearch: serviço ativo."; else [ "$e" = "Elasticsearch" ] && v_fail "Elasticsearch: serviço inativo." || v_warn "Elasticsearch: instalado, mas inativo."; fi
    r=$(curl -sS --max-time 5 http://127.0.0.1:9200/ 2>/dev/null || true)
    if [ -n "$r" ]; then v_ok "Elasticsearch: API 9200 respondeu."; elif [ "$e" = "Elasticsearch" ]; then v_fail "Elasticsearch: API 9200 sem resposta."; else v_warn "Elasticsearch: API 9200 sem resposta."; fi
    if [ "$e" = "Elasticsearch" ]; then
        curl -sS --max-time 5 'http://127.0.0.1:9200/_cat/indices/koha_library_*?format=json' 2>/dev/null | grep -q koha_library_ && v_ok "Elasticsearch: índices Koha encontrados." || v_warn "Elasticsearch: índices Koha não confirmados."
        if koha_worker_esta_rodando; then
            v_ok "koha-worker: daemon de background jobs rodando (registros novos/editados serão propagados ao índice)."
        else
            v_fail "koha-worker: daemon de background jobs NÃO está rodando - registros catalogados agora NÃO vão aparecer na busca até um novo rebuild manual."
        fi
    fi
}
validar_cron(){
    local f="/etc/cron.d/koha_tasks"
    validar_arquivo "$f" "Cron: arquivo central" || return 1
    [ "$(stat -c '%a' "$f" 2>/dev/null || echo 0)" = 644 ] && v_ok "Cron: permissões 644." || v_warn "Cron: permissões diferentes de 644."
    grep -q 'backup_sql.sh' "$f" 2>/dev/null && v_ok "Cron: backup SQL presente." || v_warn "Cron: backup SQL não encontrado."
    grep -q 'backup_marc.sh' "$f" 2>/dev/null && v_ok "Cron: backup MARC21 presente." || v_warn "Cron: backup MARC21 não encontrado."
    grep -q 'koha-plack --restart library' "$f" 2>/dev/null && v_ok "Cron: reinício diário do Plack presente." || v_warn "Cron: reinício do Plack não encontrado."
    grep -q 'overdue_notices.pl' "$f" 2>/dev/null && v_ok "Cron: avisos de atraso presentes." || v_warn "Cron: avisos de atraso não configurados."
    grep -q 'process_message_queue.pl' "$f" 2>/dev/null && v_ok "Cron: fila de mensagens presente." || v_warn "Cron: fila de mensagens não configurada."
    grep -q 'cleanup_database.pl' "$f" 2>/dev/null && v_ok "Cron: limpeza de banco de dados presente." || v_warn "Cron: limpeza de banco de dados não configurada."
    systemctl is-active --quiet cron && v_ok "Cron: serviço ativo." || v_fail "Cron: serviço inativo."
}
validar_ufw(){
    command -v ufw >/dev/null 2>&1 || { v_fail "UFW: comando ausente."; return 1; }
    ufw status 2>/dev/null | grep -q '^Status: active' && v_ok "UFW: firewall ativo." || v_fail "UFW: firewall inativo."
    local p
    for p in 22 80 443 8080 587 2100 6001 53682; do
        ufw status 2>/dev/null | grep -Eq "${p}/tcp|${p}" && v_ok "UFW: regra TCP $p encontrada." || v_warn "UFW: regra TCP $p não confirmada (Serviço opcional)."
    done
}
validar_rede_e_sistema(){
    local ram free
    validar_comando ss "Rede" || true
    validar_comando curl "Rede" || true
    if getent hosts debian.koha-community.org >/dev/null 2>&1; then v_ok "DNS: debian.koha-community.org resolve."; else v_fail "DNS: não resolve debian.koha-community.org."; fi
    ram=$(awk '/MemTotal:/ {printf "%.1f", $2/1024/1024}' /proc/meminfo 2>/dev/null || echo 0)
    v_info "RAM detectada: ${ram} GB."
    free=$(df -Pm / 2>/dev/null | awk 'NR==2{print $4}')
    if [[ "$free" =~ ^[0-9]+$ ]] && [ "$free" -ge 5120 ]; then v_ok "Disco: ${free} MB livres em /."; elif [[ "$free" =~ ^[0-9]+$ ]] && [ "$free" -ge 2048 ]; then v_warn "Disco: ${free} MB livres em /."; else v_fail "Disco: menos de 2 GB livres em /."; fi
    swapon --show 2>/dev/null | grep -q '/' && v_ok "SWAP: ativa." || v_warn "SWAP: nenhuma área ativa."
    timedatectl show -p NTPSynchronized --value 2>/dev/null | grep -q '^yes$' && v_ok "NTP: sincronizado." || v_warn "NTP: sincronização não confirmada."
}
validar_opcionais(){
    if systemctl cat cloudflared.service >/dev/null 2>&1; then systemctl is-active --quiet cloudflared && v_ok "Cloudflare Tunnel: ativo." || v_warn "Cloudflare Tunnel: instalado, mas inativo."; else v_warn "Cloudflare Tunnel: não configurado."; fi
    if [ -f /root/.config/rclone/rclone.conf ]; then
        v_ok "Rclone: configuração encontrada."
        if rclone lsd gdrive: >/dev/null 2>&1; then v_ok "Rclone: remoto gdrive acessível."; else v_warn "Rclone: remoto gdrive não respondeu."; fi
    else v_warn "Rclone: configuração ainda não encontrada."; fi
    [ -f /root/credenciais_koha.txt ] && v_ok "Credenciais: arquivo presente." || v_warn "Credenciais: arquivo ausente."
}
validar_sistema_completo(){
    local ctx="${1:-validação completa}" ip engine
    v_reset "$ctx"
    v_info "=== SISTEMA / REDE ==="; validar_rede_e_sistema
    v_info "=== SERVIÇOS ==="
    validar_servico mariadb MariaDB
    validar_servico apache2 Apache
    validar_servico memcached Memcached
    validar_servico koha-common "Koha common"
    validar_servico cron Cron
    validar_servico fail2ban Fail2ban opcional
    v_info "=== KOHA / BANCO ==="; validar_mariadb; validar_koha_instancia
    ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    if [ -n "$ip" ]; then validar_porta_local 80 OPAC; validar_porta_local 8080 Staff; validar_http http://127.0.0.1:80/ "OPAC local"; validar_http http://127.0.0.1:8080/ "Staff local"; else v_warn "IP do servidor não determinado."; fi
    engine=$(obter_motor_busca)
    v_info "=== BUSCA ==="; validar_zebra "$engine"; validar_elasticsearch "$engine"
    v_info "=== APACHE / CRON / FIREWALL ==="
    apachectl configtest >/dev/null 2>&1 && v_ok "Apache: configtest OK." || v_fail "Apache: configtest falhou."
    validar_cron; validar_ufw
    v_info "=== OPCIONAIS ==="; validar_opcionais
    printf '\nRESULTADO: OK=%s | AVISOS=%s | ERROS=%s\n' "$V_OK" "$V_WARN" "$V_FAIL" | tee -a "$VALIDACAO_LOG"
    echo "Log: $VALIDACAO_LOG" | tee -a "$VALIDACAO_LOG"
    [ "$V_FAIL" -eq 0 ]
}
validar_pre_instalacao(){
    local free ram p
    v_reset "pré-instalação"
    [ "$EUID" -eq 0 ] && v_ok "Root: execução como administrador." || v_fail "Root: privilégios insuficientes."
    if [ -r /etc/os-release ] && grep -Eq '^(ID|ID_LIKE)=(ubuntu|debian)|^(ID_LIKE)=.*debian' /etc/os-release; then v_ok "SO: base Debian/Ubuntu detectada."; else v_warn "SO: não identificado claramente como Debian/Ubuntu."; fi
    validar_comando apt-get APT || true; validar_comando dpkg DPKG || true; validar_comando systemctl Systemd || true; validar_comando ss Rede || true; validar_comando curl Internet || true; validar_comando wget Download || true; validar_comando gpg GPG || true
    getent hosts debian.koha-community.org >/dev/null 2>&1 && v_ok "DNS: repositório Koha resolve." || v_fail "DNS: repositório Koha não resolve."
    curl -fsSI --max-time 8 https://debian.koha-community.org/koha/ >/dev/null 2>&1 && v_ok "HTTPS: repositório Koha respondeu." || v_fail "HTTPS: repositório Koha não respondeu."
    free=$(df -Pm / 2>/dev/null | awk 'NR==2{print $4}'); ram=$(awk '/MemTotal:/ {printf "%.1f",$2/1024/1024}' /proc/meminfo 2>/dev/null || echo 0)
    if [[ "$free" =~ ^[0-9]+$ ]] && [ "$free" -ge 5120 ]; then v_ok "Disco: ${free} MB livres."; elif [[ "$free" =~ ^[0-9]+$ ]]; then v_warn "Disco: somente ${free} MB livres."; else v_warn "Disco: não calculado."; fi
    v_info "RAM: ${ram} GB."
    for p in 80 8080; do ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "([.:]${p})$" && v_warn "TCP $p: já está em uso." || v_ok "TCP $p: livre."; done
    [ "$V_FAIL" -eq 0 ] || { whiptail --title "Pré-validação falhou" --msgbox "Erros: $V_FAIL\nAvisos: $V_WARN\n\nLog: $VALIDACAO_LOG" 10 70; return 1; }
    whiptail --title "Pré-validação OK" --yesno "Pré-validação concluída sem erros críticos.\n\nOK: $V_OK\nAvisos: $V_WARN\n\nIniciar instalação?" 12 70
}
mostrar_validacao(){
    [ -f "$VALIDACAO_LOG" ] || { whiptail --title "Validação" --msgbox "Nenhum relatório de validação foi gerado ainda." 8 65; return; }
    whiptail --title "Relatório de validação" --textbox "$VALIDACAO_LOG" 30 110 --scrolltext
}

# ======================================================================
# 1. INSTALAÇÃO BASE / BASE INSTALLATION
# ======================================================================
funcao_instalar_koha() {
    whiptail --title "Instalação / Installation" --msgbox "[POR] Iniciando o Koha Easy Install (Modo Leve - Zebra por padrão).\n\n[EN] Starting Koha Easy Install (Lightweight Mode - Zebra default)." 10 75
    clear

    if ! validar_pre_instalacao; then return; fi

    aguardar_travas_apt

    caixa_explicacao "Configurando Locales e Codificação UTF-8..." "Configuring Locales and UTF-8 Encoding..."
    apt-get update -o Acquire::Check-Valid-Until=false -y || true
    DEBIAN_FRONTEND=noninteractive apt-get install -y locales
    locale-gen pt_BR.UTF-8 en_US.UTF-8
    update-locale LANG=pt_BR.UTF-8 LC_ALL=pt_BR.UTF-8
    export LANG=pt_BR.UTF-8
    export LC_ALL=pt_BR.UTF-8

    caixa_explicacao "Sincronizando relógio do sistema (NTP)..." "Synchronizing system clock (NTP)..."
    DEBIAN_FRONTEND=noninteractive apt-get install -y systemd-timesyncd
    systemctl enable --now systemd-timesyncd
    timeout 10 bash -c 'until timedatectl | grep -q "synchronized: yes"; do sleep 1; done' || true
    dpkg-reconfigure tzdata
    export DEBIAN_FRONTEND=noninteractive

    caixa_explicacao "Criando Memória Virtual (SWAP 4GB)..." "Creating Virtual Memory (SWAP 4GB)..."
    if [ "$(swapon --show | wc -l)" -le 1 ]; then
      fallocate -l 4G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=4096
      chmod 600 /swapfile
      mkswap /swapfile
      swapon /swapfile
      echo '/swapfile none swap sw 0 0' >> /etc/fstab
    fi

    aguardar_travas_apt

    caixa_explicacao "Instalando dependências essenciais..." "Installing essential dependencies..."
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y
    
    DEBIAN_FRONTEND=noninteractive apt-get install -y nano curl wget gpg ufw software-properties-common default-jre-headless \
                  libapache2-mod-security2 fail2ban libsasl2-modules glabels \
                  rclone avahi-daemon memcached python3 expect libxml2-utils

    systemctl enable --now avahi-daemon fail2ban memcached

    caixa_explicacao "Adicionando repositórios (Koha e Elasticsearch)..." "Adding repositories (Koha and Elasticsearch)..."
    mkdir -p /usr/share/keyrings
    wget -q --timeout=20 --tries=3 -O - https://debian.koha-community.org/koha/gpg.asc | gpg --dearmor --yes -o /usr/share/keyrings/koha-keyring.gpg
    echo "deb [signed-by=/usr/share/keyrings/koha-keyring.gpg] https://debian.koha-community.org/koha stable main" > /etc/apt/sources.list.d/koha.list

    wget -q --timeout=20 --tries=3 -O - https://artifacts.elastic.co/GPG-KEY-elasticsearch | gpg --dearmor --yes -o /usr/share/keyrings/elasticsearch-keyring.gpg
    echo "deb [signed-by=/usr/share/keyrings/elasticsearch-keyring.gpg] https://artifacts.elastic.co/packages/7.x/apt stable main" > /etc/apt/sources.list.d/elastic-7.x.list

    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y mariadb-server koha-common
    systemctl enable --now mariadb

    caixa_explicacao "Configurando Apache e parâmetros globais do Koha..." "Configuring Apache and Koha global templates..."
    
    sed -i 's/^INTRAPORT=.*/INTRAPORT="8080"/' /etc/koha/koha-sites.conf
    sed -i 's/^OPACPORT=.*/OPACPORT="80"/' /etc/koha/koha-sites.conf
    
    grep -q "^MEMCACHED_SERVERS=" /etc/koha/koha-sites.conf && \
        sed -i 's/^MEMCACHED_SERVERS=.*/MEMCACHED_SERVERS="127.0.0.1:11211"/' /etc/koha/koha-sites.conf || \
        echo 'MEMCACHED_SERVERS="127.0.0.1:11211"' >> /etc/koha/koha-sites.conf

    grep -q "^MEMCACHED_PREFIX=" /etc/koha/koha-sites.conf && \
        sed -i 's/^MEMCACHED_PREFIX=.*/MEMCACHED_PREFIX="koha_"/' /etc/koha/koha-sites.conf || \
        echo 'MEMCACHED_PREFIX="koha_"' >> /etc/koha/koha-sites.conf

    if [ -f /etc/koha/koha-conf-site.xml.in ]; then
        sed -i 's/__MEMCACHED_SERVERS__/127.0.0.1:11211/g' /etc/koha/koha-conf-site.xml.in
        sed -i 's/__MEMCACHED_PREFIX__/koha_/g' /etc/koha/koha-conf-site.xml.in
    fi

    a2enmod rewrite cgi deflate headers proxy_http
    grep -q "^Listen 8080" /etc/apache2/ports.conf || sed -i '/Listen 80/a Listen 8080' /etc/apache2/ports.conf
    systemctl restart apache2 memcached

    # -------------------------------------------------------------
    # REMOVER INSTALAÇÃO ANTERIOR SE EXISTIR
    # -------------------------------------------------------------
    KOHA_INSTANCIA_EXISTE=false
    if [ -d /etc/koha/sites/library ]; then
        KOHA_INSTANCIA_EXISTE=true
    elif mysql -Nse "SELECT 1 FROM information_schema.schemata WHERE schema_name='koha_library' LIMIT 1;" 2>/dev/null | grep -q '^1$'; then
        KOHA_INSTANCIA_EXISTE=true
    fi

    if [ "$KOHA_INSTANCIA_EXISTE" = true ]; then
        if ! whiptail --title "Instância já existe / Instance already exists" --yesno \
            "[POR] Já existe uma instalação da instância 'library'.\n\nREINSTALAR APAGARÁ a configuração atual e o banco koha_library.\nEssa operação é destrutiva e não pode ser desfeita pelo script.\n\nDeseja prosseguir para a segunda confirmação?\n\n[EN] A 'library' instance already exists.\n\nREINSTALLING WILL DELETE the current configuration and the koha_library database.\nThis operation is destructive and cannot be undone by this script.\n\nContinue to the second confirmation?" 18 78; then
            whiptail --title "Instalação cancelada / Installation cancelled" --msgbox "[POR] Nenhuma alteração destrutiva foi feita.\n\n[EN] No destructive changes were made." 8 62
            return
        fi

        CONFIRMAR_REINSTALACAO=$(whiptail --title "CONFIRMAÇÃO FINAL / FINAL CONFIRMATION" --inputbox \
            "[POR] Para apagar a instalação atual, digite exatamente:\n\nREINSTALAR\n\n[EN] To delete the current installation, type exactly:\n\nREINSTALL" 12 68 3>&1 1>&2 2>&3) || return

        if [ "$CONFIRMAR_REINSTALACAO" != "REINSTALAR" ]; then
            whiptail --title "Instalação cancelada / Installation cancelled" --msgbox "[POR] Confirmação incorreta. Nada foi apagado.\n\n[EN] Incorrect confirmation. Nothing was deleted." 8 62
            return
        fi

        caixa_explicacao "Removendo instalação existente..." "Removing existing installation..."
        koha-remove library 2>/dev/null || true
        mysql -e "DROP DATABASE IF EXISTS koha_library;" 2>/dev/null || true
        mysql -e "DROP USER IF EXISTS 'koha_library'@'localhost';" 2>/dev/null || true
        rm -rf /etc/koha/sites/library
    fi

    # -------------------------------------------------------------
    # CRIAÇÃO DA INSTÂNCIA (SEM FORÇAR DADOS)
    # -------------------------------------------------------------
    caixa_explicacao "Criando instância 'library' do Koha..." "Creating 'library' Koha instance..."
    
    # Prepara o banco vazio e o usuário do MariaDB. 
    # AS TABELAS SÓ SERÃO CRIADAS QUANDO O USUÁRIO ACESSAR O WEB INSTALLER NO NAVEGADOR!
    koha-create --create-db library

    # Higieniza o XML com as configurações corretas de Memcached
    sed -i 's/__MEMCACHED_SERVERS__/127.0.0.1:11211/g' /etc/koha/sites/library/koha-conf.xml 2>/dev/null || true
    sed -i 's/__MEMCACHED_PREFIX__/koha_library:/g' /etc/koha/sites/library/koha-conf.xml 2>/dev/null || true

    DB_PASS=$(grep -oP '(?<=<pass>)[^<]+' /etc/koha/sites/library/koha-conf.xml | head -n 1)

    a2dissite 000-default 2>/dev/null || true
    a2ensite library
    systemctl restart apache2 memcached koha-common

    koha-translate --install pt-BR || true
    koha-plack --enable library
    koha-plack --start library

    # Inicia o daemon do Zebra, mas ele não fará nada até as tabelas existirem
    systemctl enable --now koha-zebra-daemon@library 2>/dev/null || true
    koha-zebra --start library 2>/dev/null || true

    v_reset "pós-instalação"
    validar_servico mariadb "MariaDB"
    validar_servico apache2 "Apache"
    validar_servico memcached "Memcached"
    validar_servico koha-common "Koha common"
    validar_mariadb
    validar_koha_instancia

    # ======================================================================
    # ARQUIVOS DE BACKUP E CREDENCIAIS / BACKUP FILES AND CREDENTIALS
    # ======================================================================
    caixa_explicacao "Estruturando scripts de Backup e Credenciais..." "Structuring Backup scripts and Credentials..."
    ARQUIVO_CONF="/etc/koha/sites/library/koha-conf.xml"
    DB_PASS=$(grep -oP '(?<=<pass>)[^<]+' "$ARQUIVO_CONF" | head -n 1)
    DB_USER="koha_library"

    mkdir -p /var/backups/koha_sql /var/backups/koha_marc "$REAL_HOME/logs"

    cat << EOF > /root/credenciais_koha.txt
======================================================================
 [POR] CREDENCIAIS DE ACESSO AO KOHA (INSTÂNCIA: library)
 [EN]  KOHA ACCESS CREDENTIALS (INSTANCE: library)
======================================================================
 Staff (Adm / Intranet): http://$(hostname -I | awk '{print $1}'):8080
 OPAC (Public Catalog):  http://$(hostname -I | awk '{print $1}'):80

 DB Master User: $DB_USER
 Setup Password: $DB_PASS

 Config File:    /etc/koha/sites/library/koha-conf.xml
======================================================================
EOF
    chmod 600 /root/credenciais_koha.txt

    cat << EOF > /root/backup_sql.sh
#!/bin/bash
set -o pipefail
DATA=\$(date +%Y-%m-%d_%Hh%M)
DIR_BACKUP="/var/backups/koha_sql"
mkdir -p "\$DIR_BACKUP"
MYSQL_PWD='$DB_PASS' mysqldump -u"$DB_USER" "koha_library" | gzip > "\$DIR_BACKUP/koha_library_\$DATA.sql.gz"
if [ -f /root/.config/rclone/rclone.conf ]; then
  /usr/bin/rclone --config /root/.config/rclone/rclone.conf move "\$DIR_BACKUP/koha_library_\$DATA.sql.gz" gdrive:Backup_SQL_Koha 2>/dev/null || true
fi
find "\$DIR_BACKUP" -name "*.sql.gz" -mtime +7 -delete
EOF

    cat << 'EOF' > /root/backup_marc.sh
#!/bin/bash
set -uo pipefail
INSTANCE="library"
EXPORT_SCRIPT="/usr/share/koha/bin/export_records.pl"
BACKUP_DIR="/var/backups/koha_marc"
RCLONE_REMOTE="gdrive"
RCLONE_FOLDER="Backup_MARC_Koha"
KEEP_LOCAL_DAYS=7

DATE=$(date '+%Y-%m-%d_%H%M')
BIBLIOS_FILE="$BACKUP_DIR/biblios_${DATE}.mrc"
AUTHS_FILE="$BACKUP_DIR/authorities_${DATE}.mrc"
ARCHIVE_FILE="$BACKUP_DIR/koha_marc_${DATE}.tar.gz"

mkdir -p "$BACKUP_DIR"
koha-shell "$INSTANCE" -c "perl $EXPORT_SCRIPT --record-type=bibs --format=marc --filename=$BIBLIOS_FILE" >/dev/null 2>&1
koha-shell "$INSTANCE" -c "perl $EXPORT_SCRIPT --record-type=auths --format=marc --filename=$AUTHS_FILE" >/dev/null 2>&1

tar -czf "$ARCHIVE_FILE" -C "$BACKUP_DIR" "$(basename "$BIBLIOS_FILE")" "$(basename "$AUTHS_FILE")"
rm -f "$BIBLIOS_FILE" "$AUTHS_FILE"

if [ -f /root/.config/rclone/rclone.conf ]; then
  /usr/bin/rclone copy "$ARCHIVE_FILE" "$RCLONE_REMOTE:$RCLONE_FOLDER" >/dev/null 2>&1 || true
fi
find "$BACKUP_DIR" -name "koha_marc_*.tar.gz" -mtime "+$KEEP_LOCAL_DAYS" -delete
EOF
    chmod +x /root/backup_sql.sh /root/backup_marc.sh
    chmod 600 /root/backup_sql.sh

    cat << EOF > /etc/cron.d/koha_tasks
# ======================================================================
# KOHA EASY INSTALL - GERENCIADOR DE TAREFAS / TASK MANAGER (CRON)
# ======================================================================
# [POR] Formato: Minuto(0-59) | Hora(0-23) | Dia do Mes(1-31) | Mes(1-12) | Dia da Semana(0-6, 0=Dom)
# [EN]  Format:  Minute(0-59) | Hour(0-23) | Day of Month(1-31) | Month(1-12) | Day of Week(0-6, 0=Sun)

# 1. [EN] Vacuum journalctl logs every 14 days (Runs daily at 00:30)
30 0 * * * root /usr/bin/journalctl --vacuum-time=14d >/dev/null 2>&1

# 2. [EN] Database repair & check (Runs on the 5th day of every month at 01:00)
0 1 5 * * root /usr/bin/mysqlcheck --check --auto-repair --databases koha_library >/dev/null 2>&1

# 3. [EN] Automatic restart of Plack web engine (Runs daily at 05:00)
0 5 * * * root /usr/sbin/koha-plack --restart library >/dev/null 2>&1

# 4. [EN] DAILY SQL DATABASE BACKUP (Runs daily at 17:40)
40 17 * * * root /bin/bash /root/backup_sql.sh >/dev/null 2>&1

# 5. [EN] WEEKLY MARC21 & AUTHORITIES BACKUP (Runs every Sunday at 03:00)
0 3 * * 0 root /bin/bash /root/backup_marc.sh >/dev/null 2>&1

# 6. [EN] DAILY DATABASE CLEANUP (Runs daily at 01:30)
#    [POR] LIMPEZA DE BANCO DE DADOS (Diariamente às 01:30)
30 1 * * * root koha-shell library -c "/usr/share/koha/bin/cronjobs/cleanup_database.pl --sessions --zebraqueue 10" >/dev/null 2>&1
EOF
    chmod 644 /etc/cron.d/koha_tasks
    systemctl restart cron

    ufw allow 22/tcp >/dev/null 2>&1
    ufw allow 80/tcp >/dev/null 2>&1
    ufw allow 443/tcp >/dev/null 2>&1
    ufw allow 8080/tcp >/dev/null 2>&1
    ufw allow 587/tcp >/dev/null 2>&1
    ufw allow 53682/tcp >/dev/null 2>&1
    ufw --force enable >/dev/null 2>&1

    IP_REAL=$(hostname -I | awk '{print $1}')
    [ -z "$IP_REAL" ] && IP_REAL="ipdoservidor"

    if [ -f "$0" ]; then
        cp "$0" /usr/local/bin/options.sh 2>/dev/null || true
        chmod +x /usr/local/bin/options.sh 2>/dev/null || true
    else
        curl -fsSL https://raw.githubusercontent.com/PauloFBaldiFH/Tutorial-Koha/main/koha-easy-install -o /usr/local/bin/options.sh 2>/dev/null || true
        chmod +x /usr/local/bin/options.sh 2>/dev/null || true
    fi

    cat << EOF > /etc/issue
Ubuntu \n \l

                                    .-=========-.
                                   (  KOHA ILS   )
                                    \`-=========-'
                  /===============================================\\
                 /        .-----------------------------.        \\
                /         |     K O H A   L I B R A R Y |         \\
               /     .----'-----------------------------'----.     \\
              /=====[     PUBLIC CATALOG & AUTOMATION SUITE   ]=====\\
             /_______________________________________________________\\
             |  ||  ||  ||  ||  ||  ||  ||  ||  ||  ||  ||  ||  ||  |
             |==||==||==||==||==||==||==||==||==||==||==||==||==||==|
             |                                                       |
             |  [POR] Boas-vindas ao Koha Easy Install!              |
             |  [EN]  Welcome to Koha Easy Install!                  |
             |                                                       |
             |  ===================================================  |
             |  PAINEL DE CONTROLE / CONTROL DASHBOARD:              |
             |  sudo options.sh                                      |
             |  ===================================================  |
             |  ENDEREÇOS DE ACESSO / WEB ACCESS URLS:
             |  - Staff (Adm/Intranet):  http://${IP_REAL}:8080
             |  - OPAC (Public Catalog): http://${IP_REAL}:80
             |  ---------------------------------------------------  |
             |  PRIMEIRO ACESSO / INITIAL CREDENTIALS:
             |  - Usuário / Username: $DB_USER
             |  - Senha / Password:   cat /root/credenciais_koha.txt
             |  ===================================================  |
             |                                                       |
             |    |---|   |---|   |---|   .---.   |---|   |---|      |
             |    |* *|   |* *|   |* *|   |* *|   |* *|   |* *|      |
             |    |===|   |===|   |===|   |===|   |===|   |===|      |
            /=========================================================\\
           /___________________________________________________________\\

EOF
    cp /etc/issue /etc/issue.net
    cp /etc/issue /etc/motd

    # ----------------------------------------------------------------------
    # LIMPEZA PREVENTIVA PÓS-INSTALAÇÃO / POST-INSTALL CLEANUP
    # ----------------------------------------------------------------------
    caixa_explicacao "Limpando arquivos temporários e pacotes órfãos..." "Cleaning temporary files and orphan packages..."
    apt-get clean -y
    apt-get autoclean -y
    DEBIAN_FRONTEND=noninteractive apt-get autoremove --purge -y || true
    rm -rf /tmp/koha /tmp/koha-easy-install* 2>/dev/null || true
    journalctl --vacuum-time=7d >/dev/null 2>&1 || true

    # REATIVA SERVIÇOS DO APT APENAS NO FINAL
    systemctl start apt-daily.timer apt-daily-upgrade.timer unattended-upgrades 2>/dev/null || true

    STATUS_NUVEM="\e[1;33mNão configurado. Use a Opção 8 do painel.\e[0m"

    clear
    if validar_sistema_completo "instalação concluída"; then
        VALIDACAO_FINAL_OK=true
    else
        VALIDACAO_FINAL_OK=false
    fi

    if [ "$VALIDACAO_FINAL_OK" = true ]; then
        COR_FINAL="\e[1;32m"
        MSG_FINAL_PT="INSTALAÇÃO CONCLUÍDA! O AMBIENTE ESTÁ PRONTO."
        MSG_FINAL_EN="INSTALLATION COMPLETED! ENVIRONMENT IS READY."
    else
        COR_FINAL="\e[1;33m"
        MSG_FINAL_PT="INSTALAÇÃO CONCLUÍDA, MAS A VALIDAÇÃO ENCONTROU PROBLEMAS."
        MSG_FINAL_EN="INSTALLATION COMPLETED, BUT VALIDATION FOUND PROBLEMS."
    fi

    echo -e "\n\n${COR_FINAL}======================================================================\e[0m"
    echo -e "${COR_FINAL}  [POR] $MSG_FINAL_PT\e[0m"
    echo -e "${COR_FINAL}  [EN]  $MSG_FINAL_EN\e[0m"
    echo -e "${COR_FINAL}======================================================================\e[0m"
    echo -e ""
    echo -e "\e[1;31m  >>> PASSO FINAL OBRIGATÓRIO / MANDATORY FINAL STEP <<<\e[0m"
    echo -e "  [POR] O banco de dados está vazio. Para criar as tabelas,"
    echo -e "  acesse a URL Staff abaixo no navegador e conclua o Web Installer!"
    echo -e "  [EN] The database is empty. Access the Staff URL below in your"
    echo -e "  browser and complete the Web Installer to generate the tables!"
    echo -e ""
    echo -e "\e[1;36m  🌐 ACESSOS / WEB ACCESS URLS:\e[0m"
    echo -e "  - Staff (Adm/Intranet):  \e[4;37mhttp://${IP_REAL}:8080\e[0m"
    echo -e "  - OPAC (Public Catalog): \e[4;37mhttp://${IP_REAL}:80\e[0m"
    echo -e ""
    echo -e "\e[1;36m  🔑 PRIMEIRO ACESSO / INITIAL CREDENTIALS:\e[0m"
    echo -e "  - Usuário / Username: \e[1;33m$DB_USER\e[0m"
    echo -e "  - Senha / Password:   \e[1;33m$DB_PASS\e[0m"
    echo -e ""
    echo -e "\e[1;36m  ✅ VALIDAÇÃO / VALIDATION:\e[0m"
    echo -e "  - OK: $V_OK | Avisos: $V_WARN | Erros: $V_FAIL"
    echo -e "  - Relatório: $VALIDACAO_LOG"
    echo -e ""
    echo -e "\e[1;36m  ⚙️  PAINEL DE CONTROLE / CONTROL DASHBOARD:\e[0m"
    echo -e "  Abra o painel a qualquer momento digitando: \e[1;35msudo options.sh\e[0m"
    echo -e "  Open the dashboard anytime by typing:       \e[1;35msudo options.sh\e[0m"
    echo -e ""
    echo -e "\e[1;36m  ☁️  NUVEM / CLOUD BACKUP:\e[0m"
    echo -e "  Status: $STATUS_NUVEM"
    echo -e "\e[1;32m======================================================================\e[0m"
    echo -e "\e[1;37mPressione [ENTER] para sair do instalador... / Press [ENTER] to exit...\e[0m"
    read -r
}

# ======================================================================
# 2. VISUALIZAR CREDENCIAIS / VIEW CREDENTIALS
# ======================================================================
funcao_ver_credenciais() {
    ARQUIVO_CONF="/etc/koha/sites/library/koha-conf.xml"
    if [ ! -f "$ARQUIVO_CONF" ]; then
        whiptail --title "Erro / Error" --msgbox "[POR] O Koha ainda não foi instalado.\n[EN] Koha has not been installed yet." 8 60
        return
    fi

    DB_PASS=$(grep -oP '(?<=<pass>)[^<]+' "$ARQUIVO_CONF" | head -n 1)
    DB_USER="koha_library"
    IP_REAL=$(hostname -I | awk '{print $1}')

    validar_arquivo "$ARQUIVO_CONF" "Koha: configuração" || true
    validar_arquivo "/root/credenciais_koha.txt" "Credenciais salvas" || true

    whiptail --title "Credenciais / Credentials" --msgbox "[POR] DADOS DE ACESSO AO KOHA:\n- Staff (Adm): http://${IP_REAL}:8080\n- OPAC (Público): http://${IP_REAL}:80\n- Usuário: $DB_USER\n- Senha:   $DB_PASS\n\n[EN] KOHA ACCESS CREDENTIALS:\n- Staff URL: http://${IP_REAL}:8080\n- OPAC URL:  http://${IP_REAL}:80\n- Username:  $DB_USER\n- Password:  $DB_PASS\n\nFile / Arquivo: /root/credenciais_koha.txt" 17 72
}

# ======================================================================
# 3. RESTAURAR BANCO DE DADOS (EXPLORADOR NATIVO TUI)
# ======================================================================
funcao_restaurar_banco() {
    TEXTO_DICA="
======================================================================
 [POR] DICAS DE TRANSFERÊNCIA (Como colocar o arquivo no servidor):
 - Pendrive/USB: Geralmente aparecem nas pastas /media ou /mnt
 - SCP (Terminal Linux/Mac/Win): Envie pela rede com o comando:
   scp seu_backup.sql root@$(hostname -I | awk '{print $1}'):/var/backups/
======================================================================
"
    whiptail --title "Origem do Arquivo / File Source" --msgbox "$TEXTO_DICA" 13 76

    LOCAL_ARQUIVO=$(selecionar_arquivo "/var/backups")
    if [ -z "$LOCAL_ARQUIVO" ]; then return; fi

    if ! whiptail --title "Confirmar Restauração / Confirm Restore" --yesno "[POR] Arquivo selecionado:\n$LOCAL_ARQUIVO\n\nATENÇÃO: O acervo atual será totalmente substituído pelo backup.\nDeseja continuar?\n\n[EN] Selected file:\n$LOCAL_ARQUIVO\n\nWARNING: Current catalog will be replaced by the backup.\nDo you want to proceed?" 14 74; then
        return
    fi

    clear
    caixa_explicacao "Recriando banco de dados koha_library..." "Recreating koha_library database..."
    mysql -e "DROP DATABASE IF EXISTS koha_library; CREATE DATABASE koha_library;"

    caixa_explicacao "Importando acervo ($LOCAL_ARQUIVO)..." "Importing catalog ($LOCAL_ARQUIVO)..."
    if [[ "$LOCAL_ARQUIVO" == *.gz ]]; then
        zcat "$LOCAL_ARQUIVO" | mysql koha_library
    else
        mysql koha_library < "$LOCAL_ARQUIVO"
    fi

    caixa_explicacao "Atualizando schemas e reiniciando daemons..." "Upgrading schemas and restarting daemons..."
    systemctl restart memcached
    koha-upgrade-schema library

    caixa_explicacao "Sincronizando Motor de Busca..." "Synchronizing Search Engine..."
    if dpkg -s koha-elasticsearch &>/dev/null && grep -q "<elasticsearch>" /etc/koha/sites/library/koha-conf.xml; then
        MOTOR_REAL="Elasticsearch"
    else
        MOTOR_REAL="Zebra"
    fi

    mysql -e "UPDATE koha_library.systempreferences SET value='$MOTOR_REAL' WHERE variable='SearchEngine';"

    if [ "$MOTOR_REAL" == "Elasticsearch" ]; then
        mysql -e "UPDATE koha_library.systempreferences SET value='1' WHERE variable='ElasticsearchCommitImmediately';"
        curl -s -X DELETE 'localhost:9200/koha_library_biblios' >/dev/null 2>&1 || true
        curl -s -X DELETE 'localhost:9200/koha_library_authorities' >/dev/null 2>&1 || true
        koha-elasticsearch --rebuild -d library
        koha_worker_gerenciar start
    else
        systemctl enable --now koha-zebra-daemon@library 2>/dev/null || true
        koha-zebra --start library 2>/dev/null || true
        koha-rebuild-zebra -f -v -b -a library
    fi

    koha-plack --restart library
    validar_sistema_completo "restauração do banco" || true
    whiptail --title "Sucesso / Success" --msgbox "[POR] Acervo restaurado e indexado com sucesso!\nO servidor identificou e ativou automaticamente o motor: $MOTOR_REAL.\n\n[EN] Database restored and indexed successfully!\nThe server automatically detected and enabled the engine: $MOTOR_REAL." 10 74
}

