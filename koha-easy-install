        1)  funcao_instalar_koha ;;
        2)  funcao_ver_credenciais ;;
        3)  funcao_restaurar_banco ;;
        4)  funcao_backup_manual ;;
        5)  funcao_instalar_idiomas ;;
        6)  funcao_alternar_motor_busca ;;
        7)  funcao_dimensionar_servidor ;;
        8)  funcao_configurar_rclone ;;
        9)  funcao_gerenciar_crons ;;
        10) funcao_configurar_emails ;;
        11) funcao_criar_superbibliotecario ;;
        12) funcao_configurar_cloudflare ;;
        13) funcao_configurar_ssl ;;
        14) funcao_interoperabilidade ;;
        15) funcao_configurar_relogio ;;
        16) funcao_central_seguranca ;;
        17) funcao_atualizar_sistema ;;
        18)
            clear
            if validar_sistema_completo "validação manual"; then
                whiptail --title "Validação OK / Validation OK" --msgbox "[POR] Validação concluída sem erros críticos.\n\nOK: $V_OK\nAvisos: $V_WARN\nErros: $V_FAIL\n\nLog: $VALIDACAO_LOG" 12 74
            else
                whiptail --title "Validação encontrou problemas / Validation found issues" --msgbox "[POR] A validação encontrou $V_FAIL erro(s) e $V_WARN aviso(s).\n\nOK: $V_OK\nErros: $V_FAIL\nAvisos: $V_WARN\n\nLog: $VALIDACAO_LOG" 13 74
            fi
            mostrar_validacao
            ;;
        19)
            S_APA=$(systemctl is-active apache2 2>/dev/null || echo "inativo/inactive")
            S_MAR=$(systemctl is-active mariadb 2>/dev/null || echo "inativo/inactive")
            S_MEM=$(systemctl is-active memcached 2>/dev/null || echo "inativo/inactive")
            S_KOH=$(systemctl is-active koha-common 2>/dev/null || echo "inativo/inactive")
            S_PLK=$(koha-plack --status library 2>/dev/null | tr '\n' ' ' || echo "não disponível")
            S_ZEB=$(systemctl is-active koha-zebra-daemon@library 2>/dev/null || echo "inativo/inactive")
            S_ES=$(systemctl is-active elasticsearch 2>/dev/null || echo "não instalado/inactive")
            S_CLD=$(systemctl is-active cloudflared 2>/dev/null || echo "não instalado/uninstalled")
            S_CRO=$(systemctl is-active cron 2>/dev/null || echo "inativo/inactive")
            if koha_worker_esta_rodando; then S_WRK="ativo/active"; else S_WRK="inativo/inactive"; fi
            MOTOR=$(obter_motor_busca)
            whiptail --title "Status Detalhado / Detailed Status" --msgbox "Apache:        $S_APA\nMariaDB:       $S_MAR\nMemcached:     $S_MEM\nKoha common:   $S_KOH\nPlack:         $S_PLK\nZebra:         $S_ZEB\nElasticsearch: $S_ES\nkoha-worker:   $S_WRK\nCloudflare:    $S_CLD\nCron:          $S_CRO\nMotor Koha:    ${MOTOR:-não detectado}" 17 78
            ;;
        20) clear; exit 0 ;;
    esac
    OPCAO=""
done
