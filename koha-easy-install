    [ "$opc" = "1" ] && tail -n 50 -f "/var/log/apache2/koha_${INSTANCE}_error.log" || tail -n 50 -f "/var/log/apache2/koha_${INSTANCE}_opac_error.log"
}

function_reboot_server() {
    prompt_yes_no "Reiniciar" "Reiniciar servidor agora?" 8 60 && { clear; echo "Reiniciando..."; sleep 3; reboot; }
}

function_about() {
    dialog --title "Sobre" --msgbox "Koha Easy Install & Tools v${PANEL_VERSION}\n\nDesenvolvido para ajudar bibliotecas a democratizar o acesso à gestão livre.\nRepositório: github.com/BibliotecaPalotina/koha-easy-install" 12 70
}

# ======================================================================
# 31. ATUALIZADOR AUTOMÁTICO DO SCRIPT
# ======================================================================
function_autoupdate() {
    prompt_yes_no "Atualizar Painel" "Baixar a última versão do painel do GitHub?" 8 60 || return 0
    clear
    display_explanation "Baixando o painel..." "Downloading panel..."
    local target="/usr/local/bin/options.sh" tmp
    tmp="$(mktemp "/tmp/.options.sh.XXXXXX")"
    
    if curl -fsSL --retry 3 "$UPDATE_URL" -o "$tmp"; then
        if [ "$(stat -c %s "$tmp" 2>/dev/null || echo 0)" -lt 10240 ] || ! bash -n "$tmp" 2>/dev/null; then
            rm -f "$tmp"; msg_error "" "Arquivo baixado é inválido ou tem erros de sintaxe."; return 1
        fi
        local backup="${target}.bak-$(date +%s)"
        [ -f "$target" ] && cp -p "$target" "$backup"
        mv -f "$tmp" "$target" && chmod 755 "$target"
        msg_ok "Painel atualizado! Feche e abra novamente (sudo options.sh)." 8 60
        exit 0
    else
        rm -f "$tmp"; msg_error "" "Falha no download."
    fi
}

