    echo "y" | ufw enable >/dev/null 2>&1
    for job in $(atq 2>/dev/null | cut -f1); do atrm "$job" 2>/dev/null || true; done

    IP_REAL=$(hostname -I | awk '{print $1}')
    [ -z "$IP_REAL" ] && IP_REAL="ipdoservidor"

    # ======================================================================
    # PERSISTÊNCIA DO DASHBOARD / DASHBOARD SYSTEM INSTALLATION
    # ======================================================================
    if [ -f "$0" ]; then
        cp "$0" /usr/local/bin/options.sh 2>/dev/null || true
        chmod +x /usr/local/bin/options.sh 2>/dev/null || true
    else
        curl -fsSL https://raw.githubusercontent.com/PauloFBaldiFH/Tutorial-Koha/main/koha-easy-install -o /usr/local/bin/options.sh 2>/dev/null || true
