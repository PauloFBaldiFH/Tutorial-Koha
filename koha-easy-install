choose_timezone() {
    local current choice
    current=$(timedatectl show -p Timezone --value 2>/dev/null)
    choice=$(dialog --title "$(t "Fuso Horário" "Timezone" "Zona Horaria")" --no-tags --cancel-button "$(t "Manter" "Keep" "Mantener")" \
        --menu "$(t "Atual:" "Current:" "Actual:") ${current:-UTC}\n\n$(t "Escolha o fuso do servidor:" "Choose the server timezone:" "Elija la zona horaria del servidor:")" 20 72 9 \
        "America/Sao_Paulo"  " Brasil - Brasilia/SP/RJ/PR/SC/RS/MG" \
        "America/Manaus"     " Brasil - Amazonas / MT" \
        "America/Belem"      " Brasil - Para / Amapa" \
        "America/Fortaleza"  " Brasil - Nordeste" \
        "America/Rio_Branco" " Brasil - Acre" \
        "Europe/Lisbon"      " Portugal" \
        "UTC"                " UTC" \
        "OUTRO"              " $(t "Outro (lista completa)" "Other (full list)" "Otro (lista completa)")" 3>&1 1>&2 2>&3) || return 1
    [ -z "$choice" ] && return 1
    if [ "$choice" = "OUTRO" ]; then clear; dpkg-reconfigure tzdata; return 1; fi
    printf '%s' "$choice"
}

