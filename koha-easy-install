validate_network_and_system() {
    local ram free_disk
    validate_command curl "Internet"
    getent hosts debian.koha-community.org >/dev/null 2>&1 && v_ok "DNS: debian.koha-community.org OK." || v_fail "DNS: debian.koha-community.org falhou."
    
    ram=$(awk '/MemTotal:/ {printf "%.1f", $2/1024/1024}' /proc/meminfo 2>/dev/null)
    v_info "RAM: ${ram:-?} GB."
    
    free_disk=$(get_free_space_mb /)
    if [ "${free_disk:-0}" -ge 5120 ] 2>/dev/null; then v_ok "Disco: ${free_disk} MB $(t "livres" "free" "libres")."
    elif [ "${free_disk:-0}" -ge 2048 ] 2>/dev/null; then v_warn "Disco: ${free_disk} MB $(t "livres" "free" "libres")."
    else v_fail "Disco: ${free_disk:-0} MB $(t "livres" "free" "libres") (< 2 GB)."; fi
    
    swapon --show 2>/dev/null | grep -q '/' && v_ok "SWAP: $(t "ativa" "active" "activa")." || v_warn "SWAP: $(t "inexistente" "none" "inexistente")."
    timedatectl show -p NTPSynchronized --value 2>/dev/null | grep -q '^yes$' && v_ok "NTP: $(t "sincronizado" "synchronized" "sincronizado")." || v_warn "NTP: $(t "não confirmado" "unconfirmed" "no confirmado")."
}

validate_pre_installation() {
    v_reset "pré-instalação"
    [ "$EUID" -eq 0 ] && v_ok "Root OK." || v_fail "Root: $(t "privilégios insuficientes" "insufficient privileges" "privilegios insuficientes")."
    
    if [ -r /etc/os-release ] && grep -qiE '^(ID|ID_LIKE)=.*(debian|ubuntu)' /etc/os-release; then
        v_ok "SO: Debian/Ubuntu ($(. /etc/os-release; echo "$PRETTY_NAME"))."
    else
        v_fail "SO: $(t "este instalador só suporta Debian/Ubuntu" "this installer only supports Debian/Ubuntu" "este instalador solo admite Debian/Ubuntu")."
    fi

    validate_command apt-get "APT"
    validate_command dpkg "DPKG"
    validate_command systemctl "Systemd"

    curl -fsSI --max-time 10 https://debian.koha-community.org/koha/ >/dev/null 2>&1 && \
        v_ok "HTTPS: $(t "repositório Koha respondeu" "Koha repo responded" "repositorio Koha respondió")." || v_fail "HTTPS: $(t "repositório Koha não respondeu" "Koha repo did not respond" "repositorio Koha no respondió")."

    for p in 80 8080; do
        if ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "([.:]$p)\$"; then
            v_warn "TCP $p $(t "já está em uso (outro servidor web?)" "already in use (another web server?)" "ya está en uso (¿otro servidor web?)")."
        else
            v_ok "TCP $p $(t "livre" "free" "libre")."
        fi
    done

    if [ "$V_FAIL" -ne 0 ]; then
        msg_error "" "$(t "A pré-validação encontrou $V_FAIL erro(s) crítico(s).\nAvisos: $V_WARN\n\nLog: $VALIDATION_LOG" "Pre-validation found $V_FAIL critical error(s).\nWarnings: $V_WARN\n\nLog: $VALIDATION_LOG" "La prevalidación encontró $V_FAIL error(es) crítico(s).\nAvisos: $V_WARN\n\nLog: $VALIDATION_LOG")" 12 74
        return 1
    fi
    prompt_yes_no "$(t "Pré-validação OK" "Pre-validation OK" "Prevalidación OK")" "$(t "Nenhum erro crítico.\n\nIniciar a instalação agora?" "No critical errors.\n\nStart the installation now?" "Sin errores críticos.\n\n¿Iniciar la instalación ahora?")" 10 70
}

