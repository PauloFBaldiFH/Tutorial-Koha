#!/bin/bash
# ======================================================================
# KOHA EASY INSTALL - ADVANCED MANAGEMENT SUITE
# Suíte completa de implantação, manutenção, tuning e backups.
# ======================================================================

set -e
set -o pipefail

# ======================================================================
# DETECÇÃO AUTOMÁTICA DE IDIOMA / AUTO LANGUAGE DETECTION
# ======================================================================
if echo "${LANG:-}" | grep -qiE "^pt"; then
    SYS_LANG="pt"
else
    SYS_LANG="en"
fi

t() {
    if [ "$SYS_LANG" = "pt" ]; then
        echo -e "$1"
    else
        echo -e "$2"
    fi
}

# ======================================================================
# ELEVAÇÃO AUTOMÁTICA DE PRIVILÉGIOS
# ======================================================================
if [ "$EUID" -ne 0 ]; then
  echo -e "\n+-----------------------------------------------------------------------------------------+"
  echo -e "| $(t "Privilégios de administrador (root) necessários. Digite sua senha:" "Root privileges required. Please enter your password:")"
  echo -e "+-----------------------------------------------------------------------------------------+\n"
  
  if [ -f "$0" ]; then
    exec sudo bash "$0" "$@"
  else
    echo "$(t "ERRO: Execute como root: 'sudo bash ...'" "ERROR: Run with root privileges: 'sudo bash ...'")"
    exit 1
  fi
fi

REAL_USER="${SUDO_USER:-$USER}"
REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
[ -z "$REAL_HOME" ] && REAL_HOME="/home/$REAL_USER"

# ======================================================================
# FUNÇÕES DE INTERFACE E EXPLORADOR
# ======================================================================
caixa_explicacao() {
    local msg="$(t "$1" "$2")"
    echo -e "\n+-----------------------------------------------------------------------------------------+"
    echo -e "| $msg"
    echo -e "+-----------------------------------------------------------------------------------------+\n"
}

selecionar_arquivo() {
    local atual="${1:-/}"
    while true; do
        local itens=()
        if [ "$atual" != "/" ]; then
            itens+=(".." "$(t "[Voltar para o diretorio anterior]" "[Back to previous directory]")")
        fi
        
        while IFS= read -r d; do
            [ -z "$d" ] && continue
            itens+=("$d" "$(t "[Pasta]" "[Folder]")")
        done <<< "$(find "$atual" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)"
        
        while IFS= read -r f; do
            [ -z "$f" ] && continue
            itens+=("$f" "Backup Database")
        done <<< "$(find "$atual" -mindepth 1 -maxdepth 1 -type f \( -name "*.sql" -o -name "*.sql.gz" \) -printf '%f\n' 2>/dev/null | sort)"

        if [ ${#itens[@]} -eq 0 ]; then
            itens+=(".." "$(t "[Diretório Vazio - Voltar]" "[Empty Directory - Go back]")")
        fi

        escolha=$(whiptail --title "$(t "Explorador de Arquivos" "File Explorer")" --menu "$(t "Navegando em:\n$atual\n\nSelecione o arquivo de backup (.sql ou .sql.gz):" "Browsing:\n$atual\n\nSelect the backup file:")" 22 76 12 "${itens[@]}" 3>&1 1>&2 2>&3)

        if [ $? -ne 0 ]; then return 1; fi

        if [ "$escolha" = ".." ]; then
            atual=$(dirname "$atual")
        elif [ -d "$atual/$escolha" ]; then
            atual="$atual/$escolha"
        elif [ -f "$atual/$escolha" ]; then
            echo "$atual/$escolha"
            return 0
        fi
    done
}

selecionar_diretorio() {
    local atual="${1:-/}"
    while true; do
        local dirs=( ">>> $(t "SALVAR NESTA PASTA" "SAVE IN THIS FOLDER") <<<" "$(t "Destino:" "Target:") $atual" )
        if [ "$atual" != "/" ]; then
            dirs+=( ".." "$(t "[Voltar para o diretorio anterior]" "[Back to previous directory]")" )
        fi
        
        while IFS= read -r d; do
            [ -z "$d" ] && continue
            dirs+=("$d" "$(t "[Pasta]" "[Folder]")")
        done <<< "$(find "$atual" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)"

        escolha=$(whiptail --title "$(t "Seletor de Diretório" "Directory Picker")" --menu "$(t "Navegando em:\n$atual\n\nEntre numa pasta ou escolha salvar aqui:" "Browsing:\n$atual\n\nEnter a folder or save here:")" 22 76 12 "${dirs[@]}" 3>&1 1>&2 2>&3)

        if [ $? -ne 0 ]; then return 1; fi

        if [ "$escolha" = ">>> $(t "SALVAR NESTA PASTA" "SAVE IN THIS FOLDER") <<<" ]; then
            echo "$atual"
            return 0
        elif [ "$escolha" = ".." ]; then
            atual=$(dirname "$atual")
        elif [ -d "$atual/$escolha" ]; then
            atual="$atual/$escolha"
        fi
    done
}

# ======================================================================
# ROTINAS DE BLINDAGEM DO APT E RECURSOS CORE
# ======================================================================
aguardar_travas_apt() {
    caixa_explicacao "Verificando travas do APT/DPKG e bloqueando atualizacoes ocultas..." "Checking APT/DPKG locks and blocking hidden background updates..."
    systemctl stop apt-daily.timer apt-daily-upgrade.timer unattended-upgrades apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
    while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 || \
          fuser /var/lib/apt/lists/lock >/dev/null 2>&1 || \
          fuser /var/lib/dpkg/lock >/dev/null 2>&1; do
        echo "$(t "[INFO] Processos do APT ativos. Aguardando 3 segundos..." "[INFO] APT background processes active. Waiting 3 seconds...")"
        sleep 3
    done
    dpkg --configure -a 2>/dev/null || true
}

apt_instalar_com_retry() {
    local pacotes=("$@")
    local tentativas=1
    local max_tentativas=3

    set +e
    until DEBIAN_FRONTEND=noninteractive apt-get install -y "${pacotes[@]}"; do
        if [ "$tentativas" -ge "$max_tentativas" ]; then
            whiptail --title "$(t "Falha no APT" "APT Failure")" --msgbox "$(t "Falha crônica ao baixar pacotes após $max_tentativas tentativas. Verifique sua rede." "Failed to download packages after $max_tentativas attempts. Check your network.")" 12 70
            set -e
            return 1
        fi
        echo -e "\n\e[1;33m$(t "[AVISO] Falha na tentativa $tentativas de $max_tentativas. Curando índices do Ubuntu e tentando novamente em 3s..." "[WARNING] Failure on attempt $tentativas of $max_tentativas. Fixing Ubuntu indices and retrying in 3s...")\e[0m\n"
        apt-get update --fix-missing -y >/dev/null 2>&1 || true
        dpkg --configure -a >/dev/null 2>&1 || true
        sleep 3
        tentativas=$((tentativas + 1))
    done
    set -e
    return 0
}

# ======================================================================
# FUNÇÕES AUXILIARES DE MOTOR DE BUSCA (XML E SYSTEMD)
# ======================================================================
INSTANCIA_KOHA="library"
KOHA_CONF="/etc/koha/sites/${INSTANCIA_KOHA}/koha-conf.xml"

xml_set_elasticsearch() {
    local ACAO="$1"
    local CONF="$KOHA_CONF"

    python3 - "$ACAO" "$CONF" << 'PYEOF'
import re
import sys

acao, path = sys.argv[1], sys.argv[2]

with open(path, "r") as f:
    text = f.read()

partes = re.split(r"(<!--.*?-->)", text, flags=re.DOTALL)
for i, p in enumerate(partes):
    if not p.startswith("<!--"):
        partes[i] = re.sub(
            r"[ \t]*<elasticsearch>.*?</elasticsearch>[ \t]*\n?",
            "",
            p,
            flags=re.DOTALL,
        )
text = "".join(partes)

if acao == "inserir":
    es_block = (
        "  <elasticsearch>\n"
        "    <server>127.0.0.1:9200</server>\n"
        "    <index_name>koha_library</index_name>\n"
        "  </elasticsearch>\n"
    )
    if "</config>" not in text:
        sys.exit("ERRO: tag </config> nao encontrada em koha-conf.xml")
    text = text.replace("</config>", es_block + "</config>", 1)

with open(path, "w") as f:
    f.write(text)
PYEOF
}

koha_es_ativo_no_xml() {
    grep -q "<elasticsearch>" "$KOHA_CONF" 2>/dev/null
}

koha_broker_preparar() {
    if ! dpkg -s rabbitmq-server >/dev/null 2>&1; then
        apt_instalar_com_retry rabbitmq-server || return 1
    fi
    rabbitmq-plugins enable rabbitmq_stomp >/dev/null 2>&1 || true
    systemctl enable --now rabbitmq-server >/dev/null 2>&1 || true
    return 0
}

koha_es_worker_path() {
    local p
    for p in /usr/share/koha/bin/workers/es_indexer_daemon.pl \
             /usr/share/koha/bin/workers/background_jobs_worker.pl; do
        [ -f "$p" ] && { echo "$p"; return 0; }
    done
    p=$(find /usr/share/koha -name 'es_indexer_daemon.pl' 2>/dev/null | head -n 1)
    [ -n "$p" ] && { echo "$p"; return 0; }
    return 1
}

koha_instalar_servico_indexador() {
    local inst="${1:-$INSTANCIA_KOHA}"
    local db="koha_${inst}"
    local worker cmd
    local unit_file="/etc/systemd/system/koha-es-indexer@.service"
    local watchdog="/usr/local/bin/koha-es-watchdog.sh"
    local cron_watchdog="/etc/cron.d/koha_es_watchdog"

    worker=$(koha_es_worker_path) || return 1

    if [[ "$worker" == *background_jobs_worker.pl ]]; then
        cmd="/usr/bin/perl ${worker} --queue elastic_index"
    else
        cmd="/usr/bin/perl ${worker}"
    fi

    cat > "$unit_file" << EOF
[Unit]
Description=Koha Elasticsearch indexer daemon (%i)
Documentation=man:koha-es-indexer(8)
After=network-online.target mariadb.service elasticsearch.service memcached.service koha-common.service
Wants=elasticsearch.service mariadb.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=-/usr/sbin/koha-es-indexer --stop --quiet %i
ExecStart=/usr/sbin/koha-shell %i -c "${cmd}"
Restart=always
RestartSec=10
TimeoutStopSec=20
SyslogIdentifier=koha-es-indexer-%i

[Install]
WantedBy=multi-user.target
EOF

    cat > "$watchdog" << EOF
#!/bin/bash
INSTANCIA="\${1:-$inst}"
DB="koha_\${INSTANCIA}"
UNIT="koha-es-indexer@\${INSTANCIA}"

grep -q "<elasticsearch>" "/etc/koha/sites/\${INSTANCIA}/koha-conf.xml" 2>/dev/null || exit 0
/usr/sbin/koha-es-indexer --stop --quiet "\$INSTANCIA" >/dev/null 2>&1

if ! systemctl is-active --quiet "\$UNIT"; then
    logger -t koha-es-watchdog "indexador parado; reiniciando \$UNIT"
    systemctl restart "\$UNIT"
    exit 0
fi

PEND=\$(mysql -Nse "SELECT COUNT(*) FROM \${DB}.background_jobs WHERE type='update_elastic_index' AND status='new' AND enqueued_on < DATE_SUB(NOW(), INTERVAL 5 MINUTE);" 2>/dev/null || echo 0)
if [ "\${PEND:-0}" -gt 0 ]; then
    logger -t koha-es-watchdog "\$PEND job(s) presos na fila; reiniciando \$UNIT"
    systemctl restart "\$UNIT"
fi
EOF
    chmod 755 "$watchdog"

    cat > "$cron_watchdog" << EOF
# Vigia do indexador Elasticsearch do Koha (a cada 5 minutos)
*/5 * * * * root ${watchdog} ${inst} >/dev/null 2>&1
EOF
    chmod 644 "$cron_watchdog"
    systemctl restart cron >/dev/null 2>&1 || true

    systemctl daemon-reload
    systemctl enable "koha-es-indexer@${inst}" >/dev/null 2>&1
    return 0
}

koha_indexadores_gerenciar() {
    local ACAO="$1"
    local inst="${INSTANCIA_KOHA:-library}"

    if [ "$ACAO" = "start" ]; then
        koha-worker --start "$inst" >/dev/null 2>&1 || true
        koha-worker --start --queue long_tasks "$inst" >/dev/null 2>&1 || true

        if dpkg -s koha-elasticsearch >/dev/null 2>&1 && koha_es_ativo_no_xml; then
            koha_instalar_servico_indexador "$inst" || return 1
            systemctl restart "koha-es-indexer@${inst}" >/dev/null 2>&1 || true
            systemctl restart memcached >/dev/null 2>&1 || true
        fi
    else
        systemctl disable --now "koha-es-indexer@${inst}" >/dev/null 2>&1 || true
        koha-es-indexer --stop --quiet "$inst" >/dev/null 2>&1 || true
        rm -f /etc/cron.d/koha_es_watchdog
        systemctl restart cron >/dev/null 2>&1 || true
    fi
    return 0
}

# ======================================================================
# 1. INSTALAÇÃO BASE
# ======================================================================
funcao_instalar_koha() {
    whiptail --title "$(t "Instalação" "Installation")" --msgbox "$(t "Iniciando o Koha Easy Install (Zebra por padrão)." "Starting Koha Easy Install (Zebra default).")" 10 75
    clear
    aguardar_travas_apt

    caixa_explicacao "Configurando Locales e Codificação UTF-8..." "Configuring Locales and UTF-8 Encoding..."
    apt-get update -o Acquire::Check-Valid-Until=false -y >/dev/null 2>&1 || true
    apt_instalar_com_retry locales
    locale-gen pt_BR.UTF-8 en_US.UTF-8
    update-locale LANG=pt_BR.UTF-8 LC_ALL=pt_BR.UTF-8
    export LANG=pt_BR.UTF-8
    export LC_ALL=pt_BR.UTF-8

    caixa_explicacao "Sincronizando relógio do sistema (NTP)..." "Synchronizing system clock (NTP)..."
    apt_instalar_com_retry systemd-timesyncd
    systemctl enable --now systemd-timesyncd
    timeout 10 bash -c 'until timedatectl | grep -q "synchronized: yes"; do sleep 1; done' || true
    dpkg-reconfigure -f noninteractive tzdata
    export DEBIAN_FRONTEND=noninteractive

    caixa_explicacao "Criando Memória Virtual (SWAP 4GB)..." "Creating Virtual Memory (SWAP 4GB)..."
    if [ "$(swapon --show | wc -l)" -le 1 ]; then
      fallocate -l 4G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=4096
      chmod 600 /swapfile
      mkswap /swapfile
      swapon /swapfile
      echo '/swapfile none swap sw 0 0' >> /etc/fstab
    fi

    aguardar_travas_apt

    caixa_explicacao "Instalando dependências essenciais..." "Installing essential dependencies..."
    apt-get update -y >/dev/null 2>&1 || true
    set +e; DEBIAN_FRONTEND=noninteractive apt-get upgrade -y; set -e
    
    apt_instalar_com_retry nano curl wget gpg ufw software-properties-common default-jre-headless \
                  libapache2-mod-security2 fail2ban libsasl2-modules glabels \
                  rclone avahi-daemon memcached python3 expect libxml2-utils

    systemctl enable --now avahi-daemon fail2ban memcached

    caixa_explicacao "Adicionando repositórios (Koha e Elasticsearch)..." "Adding repositories (Koha and Elasticsearch)..."
    mkdir -p /usr/share/keyrings
    wget -q --timeout=20 --tries=3 -O - https://debian.koha-community.org/koha/gpg.asc | gpg --dearmor --yes -o /usr/share/keyrings/koha-keyring.gpg
    echo "deb [signed-by=/usr/share/keyrings/koha-keyring.gpg] https://debian.koha-community.org/koha stable main" > /etc/apt/sources.list.d/koha.list

    wget -q --timeout=20 --tries=3 -O - https://artifacts.elastic.co/GPG-KEY-elasticsearch | gpg --dearmor --yes -o /usr/share/keyrings/elasticsearch-keyring.gpg
    echo "deb [signed-by=/usr/share/keyrings/elasticsearch-keyring.gpg] https://artifacts.elastic.co/packages/7.x/apt stable main" > /etc/apt/sources.list.d/elastic-7.x.list

    apt-get update -y >/dev/null 2>&1 || true
    apt_instalar_com_retry mariadb-server koha-common
    systemctl enable --now mariadb

    caixa_explicacao "Configurando Apache e parâmetros globais do Koha..." "Configuring Apache and Koha global templates..."
    sed -i 's/^INTRAPORT=.*/INTRAPORT="8080"/' /etc/koha/koha-sites.conf
    sed -i 's/^OPACPORT=.*/OPACPORT="80"/' /etc/koha/koha-sites.conf
    
    grep -q "^MEMCACHED_SERVERS=" /etc/koha/koha-sites.conf && \
        sed -i 's/^MEMCACHED_SERVERS=.*/MEMCACHED_SERVERS="127.0.0.1:11211"/' /etc/koha/koha-sites.conf || \
        echo 'MEMCACHED_SERVERS="127.0.0.1:11211"' >> /etc/koha/koha-sites.conf

    grep -q "^MEMCACHED_PREFIX=" /etc/koha/koha-sites.conf && \
        sed -i 's/^MEMCACHED_PREFIX=.*/MEMCACHED_PREFIX="koha_"/' /etc/koha/koha-sites.conf || \
        echo 'MEMCACHED_PREFIX="koha_"' >> /etc/koha/koha-sites.conf

    if [ -f /etc/koha/koha-conf-site.xml.in ]; then
        sed -i 's/__MEMCACHED_SERVERS__/127.0.0.1:11211/g' /etc/koha/koha-conf-site.xml.in
        sed -i 's/__MEMCACHED_PREFIX__/koha_/g' /etc/koha/koha-conf-site.xml.in
    fi

    a2enmod rewrite cgi deflate headers proxy_http
    grep -q "^Listen 8080" /etc/apache2/ports.conf || sed -i '/Listen 80/a Listen 8080' /etc/apache2/ports.conf
    systemctl restart apache2 memcached

    KOHA_INSTANCIA_EXISTE=false
    if [ -d /etc/koha/sites/library ]; then
        KOHA_INSTANCIA_EXISTE=true
    elif mysql -Nse "SELECT 1 FROM information_schema.schemata WHERE schema_name='koha_library' LIMIT 1;" 2>/dev/null | grep -q '^1$'; then
        KOHA_INSTANCIA_EXISTE=true
    fi

    if [ "$KOHA_INSTANCIA_EXISTE" = true ]; then
        CONFIRMAR_REINSTALACAO=$(whiptail --title "$(t "CONFIRMAÇÃO FINAL" "FINAL CONFIRMATION")" --inputbox \
            "$(t "A instância já existe. Para apagar a atual, digite exatamente:\n\nREINSTALAR" "Instance exists. To delete it, type exactly:\n\nREINSTALL")" 12 68 3>&1 1>&2 2>&3) || return

        if [ "$CONFIRMAR_REINSTALACAO" != "$(t "REINSTALAR" "REINSTALL")" ]; then
            whiptail --title "$(t "Cancelado" "Cancelled")" --msgbox "$(t "Confirmação incorreta. Nada apagado." "Incorrect confirmation. Nothing deleted.")" 8 62
            return
        fi

        caixa_explicacao "Removendo instalação existente..." "Removing existing installation..."
        koha-remove library 2>/dev/null || true
        mysql -e "DROP DATABASE IF EXISTS koha_library;" 2>/dev/null || true
        mysql -e "DROP USER IF EXISTS 'koha_library'@'localhost';" 2>/dev/null || true
        rm -rf /etc/koha/sites/library
    fi

    caixa_explicacao "Criando instância 'library' do Koha..." "Creating 'library' Koha instance..."
    koha-create --create-db library

    sed -i 's/__MEMCACHED_SERVERS__/127.0.0.1:11211/g' /etc/koha/sites/library/koha-conf.xml 2>/dev/null || true
    sed -i 's/__MEMCACHED_PREFIX__/koha_library:/g' /etc/koha/sites/library/koha-conf.xml 2>/dev/null || true

    DB_PASS=$(grep -oP '(?<=<pass>)[^<]+' /etc/koha/sites/library/koha-conf.xml | head -n 1)

    a2dissite 000-default 2>/dev/null || true
    a2ensite library
    systemctl restart apache2 memcached koha-common

    koha-translate --install pt-BR || true
    koha-plack --enable library
    koha-plack --start library

    systemctl enable --now koha-zebra-daemon@library 2>/dev/null || true
    koha-zebra --start library 2>/dev/null || true

    caixa_explicacao "Estruturando scripts de Backup e Credenciais..." "Structuring Backup scripts and Credentials..."
    ARQUIVO_CONF="/etc/koha/sites/library/koha-conf.xml"
    DB_PASS=$(grep -oP '(?<=<pass>)[^<]+' "$ARQUIVO_CONF" | head -n 1)
    DB_USER="koha_library"

    mkdir -p /var/backups/koha_sql /var/backups/koha_marc "$REAL_HOME/logs"

    cat << EOF > /root/credenciais_koha.txt
======================================================================
 CREDENCIAIS DE ACESSO AO KOHA (INSTÂNCIA: library) / KOHA CREDENTIALS
======================================================================
 Staff (Adm / Intranet): http://$(hostname -I | awk '{print $1}'):8080
 OPAC (Public Catalog):  http://$(hostname -I | awk '{print $1}'):80

 DB Master User: $DB_USER
 Setup Password: $DB_PASS
======================================================================
EOF
    chmod 600 /root/credenciais_koha.txt

    cat << EOF > /root/backup_sql.sh
#!/bin/bash
set -o pipefail
DATA=\$(date +%Y-%m-%d_%Hh%M)
DIR_BACKUP="/var/backups/koha_sql"
mkdir -p "\$DIR_BACKUP"
MYSQL_PWD='$DB_PASS' mysqldump -u"$DB_USER" "koha_library" | gzip > "\$DIR_BACKUP/koha_library_\$DATA.sql.gz"
if [ -f /root/.config/rclone/rclone.conf ]; then
  /usr/bin/rclone --config /root/.config/rclone/rclone.conf move "\$DIR_BACKUP/koha_library_\$DATA.sql.gz" gdrive:Backup_SQL_Koha 2>/dev/null || true
fi
find "\$DIR_BACKUP" -name "*.sql.gz" -mtime +7 -delete
EOF

    cat << 'EOF' > /root/backup_marc.sh
#!/bin/bash
set -uo pipefail
INSTANCE="library"
EXPORT_SCRIPT="/usr/share/koha/bin/export_records.pl"
BACKUP_DIR="/var/backups/koha_marc"
RCLONE_REMOTE="gdrive"
RCLONE_FOLDER="Backup_MARC_Koha"
KEEP_LOCAL_DAYS=7

DATE=$(date '+%Y-%m-%d_%H%M')
BIBLIOS_FILE="$BACKUP_DIR/biblios_${DATE}.mrc"
AUTHS_FILE="$BACKUP_DIR/authorities_${DATE}.mrc"
ARCHIVE_FILE="$BACKUP_DIR/koha_marc_${DATE}.tar.gz"

