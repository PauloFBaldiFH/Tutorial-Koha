function_configure_cloudflare() {
    msg_info "$(t "Passo 1" "Step 1")" "$(t "1. Adicione um domínio no dash.cloudflare.com\n2. Mude os Nameservers no local de registro (ex: nic.eu.org)\n3. Aguarde o DNS propagar.\n\nO restante será feito automaticamente." "1. Add a domain to dash.cloudflare.com\n2. Change Nameservers at your registrar\n3. Wait for DNS propagation.\n\nThe rest is automatic.")" 14 74
    clear
    
    if ! command -v cloudflared >/dev/null 2>&1; then
        display_explanation "Instalando o cloudflared..." "Installing cloudflared..."
        wait_for_apt_locks || return 1
        mkdir -p /etc/apt/keyrings
        curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg -o /etc/apt/keyrings/cloudflare-main.gpg || return 1
        echo "deb [signed-by=/etc/apt/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main" > /etc/apt/sources.list.d/cloudflared.list
        apt_update_indices && apt_install cloudflared || return 1
    fi

    if [ ! -f "$HOME/.cloudflared/cert.pem" ] && [ ! -f "/root/.cloudflared/cert.pem" ]; then
        msg_info "Cloudflare Tunnel" "$(t "Autorize o túnel acessando o link que aparecerá no console." "Authorize the tunnel by accessing the link in the console.")" 9 70
        clear; cloudflared tunnel login; echo ""
    fi
    [ ! -f "$HOME/.cloudflared/cert.pem" ] && [ ! -f "/root/.cloudflared/cert.pem" ] && { msg_error "" "Autorização não concluída."; return 1; }

    local tunnel_name="koha-library"
    cloudflared tunnel list 2>/dev/null | grep -q "$tunnel_name" || cloudflared tunnel create "$tunnel_name" >/dev/null 2>&1 || return 1
    local tunnel_id; tunnel_id=$(cloudflared tunnel list 2>/dev/null | awk -v n="$tunnel_name" '$0 ~ n {print $1; exit}')
    local cred_file; cred_file=$(find "$HOME/.cloudflared" /root/.cloudflared -name "${tunnel_id}.json" 2>/dev/null | head -n1)

    local dominio opac_sub staff_sub
    dominio=$(dialog --title "Domínio" --inputbox "$(t "Domínio ativo na Cloudflare (ex: bibliotecapalotina.org):" "Domain active in Cloudflare:")" 9 70 3>&1 1>&2 2>&3) || return 0
    opac_sub=$(dialog --title "OPAC" --inputbox "$(t "Subdomínio OPAC:" "OPAC Subdomain:")" 9 60 "catalogo" 3>&1 1>&2 2>&3) || return 0
    staff_sub=$(dialog --title "Staff" --inputbox "$(t "Subdomínio Staff:" "Staff Subdomain:")" 9 60 "admin" 3>&1 1>&2 2>&3) || return 0

    mkdir -p /etc/cloudflared
    cat > /etc/cloudflared/config.yml <<EOF
tunnel: ${tunnel_id}
credentials-file: ${cred_file}
ingress:
  - hostname: ${opac_sub}.${dominio}
    service: http://localhost:80
  - hostname: ${staff_sub}.${dominio}
    service: http://localhost:8080
  - service: http_status:404
EOF

    display_explanation "Registrando DNS e reiniciando serviço..." "Registering DNS and restarting service..."
    cloudflared tunnel route dns "$tunnel_name" "${opac_sub}.${dominio}" >/dev/null 2>&1 || true
    cloudflared tunnel route dns "$tunnel_name" "${staff_sub}.${dominio}" >/dev/null 2>&1 || true

    cloudflared service uninstall >/dev/null 2>&1 || true
    cloudflared --config /etc/cloudflared/config.yml service install >/dev/null 2>&1
    systemctl enable --now cloudflared >/dev/null 2>&1
    sleep 3

    if systemctl is-active --quiet cloudflared; then
        msg_ok "$(t "TÚNEL ATIVO!\n\nOPAC: https://${opac_sub}.${dominio}\nStaff: https://${staff_sub}.${dominio}" "TUNNEL ACTIVE!\n\nOPAC: https://${opac_sub}.${dominio}\nStaff: https://${staff_sub}.${dominio}")" 10 70
    else
        msg_error "" "Falha ao iniciar o serviço cloudflared." 9 60
    fi
}

mostrar_links_tailscale() {
    local ts_hostname; ts_hostname=$(tailscale status --json 2>/dev/null | grep -oP '"DNSName":\s*"\K[^"]+' | head -n 1 | sed 's/\.$//')
    [ -z "$ts_hostname" ] && { msg_error "" "Tailscale offline ou sem IP."; return 1; }
    local funnel_status; funnel_status=$(tailscale funnel status 2>&1)
    local t="DOMÍNIO TAILSCALE:\nhttps://${ts_hostname}\n\n"
    
    echo "$funnel_status" | grep -q '127\.0\.0\.1:80\b' && t+="✅ OPAC:  https://${ts_hostname}\n" || t+="⬜ OPAC:  não publicado\n"
    echo "$funnel_status" | grep -q '127\.0\.0\.1:8080\b' && t+="✅ Staff: https://${ts_hostname}:8443\n" || t+="⬜ Staff: não publicado\n"
    dialog --title "$(t "Tailscale Funnel" "Tailscale Funnel")" --msgbox "$t" 12 70
}

function_configure_tailscale() {
    if ! command -v tailscale >/dev/null 2>&1; then
        display_explanation "Instalando Tailscale..." "Installing Tailscale..."
        curl -fsSL https://tailscale.com/install.sh | sh || return 1
    fi

    if ! tailscale status >/dev/null 2>&1; then
        clear; echo "Autenticando no Tailscale..."; tailscale up; echo ""
    fi
    tailscale status >/dev/null 2>&1 || { msg_error "" "Falha de autenticação Tailscale."; return 1; }

    while true; do
        local choice; choice=$(dialog --title "Tailscale Funnel" --menu "$(t "Ações:" "Actions:")" 14 74 5 \
            "1" "Publicar Automático (OPAC + Staff)" "2" "Publicar apenas OPAC" \
            "3" "Publicar apenas Staff" "4" "Ver status atual" "5" "Desativar tudo" 3>&1 1>&2 2>&3) || break
        
        case "$choice" in
            1) clear; tailscale funnel --bg 80 >/dev/null 2>&1; tailscale funnel --bg --https=8443 8080 >/dev/null 2>&1; mostrar_links_tailscale ;;
            2) clear; tailscale funnel --bg 80 >/dev/null 2>&1; mostrar_links_tailscale ;;
            3) clear; tailscale funnel --bg --https=8443 8080 >/dev/null 2>&1; mostrar_links_tailscale ;;
            4) clear; mostrar_links_tailscale ;;
            5) clear; tailscale funnel off >/dev/null 2>&1; msg_ok "Funnels desativados." 8 60 ;;
        esac
    done
}

