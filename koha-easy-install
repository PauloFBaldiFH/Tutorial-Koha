EOF
    cp /etc/issue /etc/issue.net
    cp /etc/issue /etc/motd

    caixa_explicacao "Limpando arquivos temporários e pacotes órfãos..." "Cleaning temporary files and orphan packages..."
    apt-get clean -y
    apt-get autoclean -y
    DEBIAN_FRONTEND=noninteractive apt-get autoremove --purge -y || true
    rm -rf /tmp/koha /tmp/koha-easy-install* 2>/dev/null || true
    journalctl --vacuum-time=7d >/dev/null 2>&1 || true

    systemctl start apt-daily.timer apt-daily-upgrade.timer unattended-upgrades 2>/dev/null || true

    clear
    COR_FINAL="\e[1;32m"
    MSG_FINAL=$(t "INSTALAÇÃO CONCLUÍDA! O AMBIENTE ESTÁ PRONTO." "INSTALLATION COMPLETED! ENVIRONMENT IS READY.")

    echo -e "\n\n${COR_FINAL}======================================================================\e[0m"
