function_test_latest_backup() {
    local latest=$(find "$DIR_SQL" -type f \( -name "*.sql" -o -name "*.sql.gz" \) -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -f2- -d' ')
    [ -z "$latest" ] && { msg_error "$(t "Erro" "Error" "Error")" "$(t "Nenhum backup local encontrado em $DIR_SQL" "No local backup found in $DIR_SQL" "No se encontró copia local en $DIR_SQL")"; return 1; }

    exec 9>"/var/lock/koha_backup.lock"
    if ! flock -n 9; then msg_error "$(t "Erro" "Error" "Error")" "$(t "Operação bloqueada por tarefa em andamento." "Operation blocked by active task." "Operación bloqueada por tarea en curso.")"; return 1; fi

    clear
    display_explanation "$(t "Testando importação estrutural em base temporária...\nArquivo: $(basename "$latest")" "Testing structural import in temporary DB...\nFile: $(basename "$latest")" "Probando importación en base temporal...\nArchivo: $(basename "$latest")")"
    
    local test_db="koha_test_$$_$(date +%s)"
    mysql -e "DROP DATABASE IF EXISTS ${test_db}; CREATE DATABASE ${test_db} CHARACTER SET utf8mb4;" || { flock -u 9; return 1; }

    if [[ "$latest" =~ \.gz$ ]]; then
        gzip -dc "$latest" | mysql --default-character-set=utf8mb4 "$test_db" 2>/dev/null
    else
        mysql --default-character-set=utf8mb4 "$test_db" < "$latest" 2>/dev/null
    fi

    local tables; tables=$(mysql -N -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${test_db}';" 2>/dev/null || echo "0")
    mysql -e "DROP DATABASE IF EXISTS ${test_db};" 2>/dev/null
    flock -u 9

    if [ "$tables" -ge 100 ]; then
        msg_ok "$(t "O backup ($tables tabelas) passou no teste de importação estrutural!" "The backup ($tables tables) passed structural import test!" "¡La copia ($tables tablas) pasó la prueba de importación!")" 10 74
    else
        msg_error "$(t "Erro" "Error" "Error")" "$(t "O arquivo falhou no teste (gerou apenas $tables tabelas)." "File failed the test (generated only $tables tables)." "El archivo falló la prueba (generó solo $tables tablas).")" 9 70
    fi
}

