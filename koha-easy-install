#!/bin/bash
# ======================================================================
# KOHA EASY INSTALL & TOOLS
# Author: Paulo Fernando Baldi Filho
# Architecture: Clean, Modular, Trilingual, Failsafe
# ======================================================================

PANEL_VERSION="1.0"
UPDATE_URL="https://raw.githubusercontent.com/BibliotecaPalotina/koha-easy-install/refs/heads/main/installer"

# ======================================================================
# 1. INICIALIZAÇÃO BLINDADA (ROOT, PIPE, TELA E LOCKS)
# ======================================================================
if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    echo -e "\n[!] Privilégios de administrador (root) necessários / Root privileges required."
    if [ -f "$0" ]; then
        exec sudo -E bash "$0" "$@"
    else
        echo -e "\nERRO: Para executar via web, chame com sudo:\n  curl -fsSL \"$UPDATE_URL\" | sudo bash\n"
        exit 1
    fi
fi

if [ ! -t 0 ]; then
    echo "[AVISO] Execução via pipe detectada. Isolando o processo no disco local..."
    TMP_SCRIPT="/tmp/koha_installer_temp.sh"
    curl -fsSL "$UPDATE_URL" -o "$TMP_SCRIPT" || { echo "ERRO: Falha no download."; exit 1; }
    chmod +x "$TMP_SCRIPT"
    exec bash "$TMP_SCRIPT" "$@" < /dev/tty
    exit 0
fi

COLS=$(tput cols 2>/dev/null || echo 80)
LINES=$(tput lines 2>/dev/null || echo 24)
if [ "$COLS" -lt 98 ] || [ "$LINES" -lt 28 ]; then
    clear
    echo "=================================================================="
    echo " ERRO: O SEU TERMINAL É MUITO PEQUENO PARA ABRIR O PAINEL"
    echo "=================================================================="
    echo "Tamanho atual: ${COLS} colunas x ${LINES} linhas."
    echo "O instalador precisa de pelo menos 98 colunas e 28 linhas."
    echo ""
    echo "-> MAXIMIZE A JANELA DO SEU TERMINAL (ou diminua a fonte com Ctrl + -)"
    echo "   e tente rodar o comando novamente."
    echo "=================================================================="
    exit 1
fi

PANEL_LOCK_FILE="/var/lock/koha_easy_install.lock"
exec 8>"$PANEL_LOCK_FILE"
if ! flock -n 8; then
    echo -e "\n[ERRO] O Koha Easy Install & Tools já está aberto em outro terminal.\n"
    exit 1
fi

# ======================================================================
# 2. VARIÁVEIS GLOBAIS E AMBIENTE
# ======================================================================
REAL_USER="${SUDO_USER:-${USER:-root}}"
REAL_HOME="$(getent passwd "$REAL_USER" 2>/dev/null | cut -d: -f6)"
[ -z "$REAL_HOME" ] || [ ! -d "$REAL_HOME" ] && REAL_HOME="/root"

INSTANCE="library"
DB_NAME="koha_${INSTANCE}"
KOHA_CONF="/etc/koha/sites/${INSTANCE}/koha-conf.xml"
CONF_DIR="/etc/koha-easy-install"
LOG_DIR="/var/log/koha-easy-install"
RUN_LOG="${LOG_DIR}/painel-$(date '+%Y%m%d').log"

CRON_TASKS="/etc/cron.d/koha_tasks"
CRON_ZEBRA="/etc/cron.d/koha_zebra_queue"
CRON_ES="/etc/cron.d/koha_es_watchdog"
CRON_PATH='PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'

BACKUP_CONF="${CONF_DIR}/backup.conf"
SCP_BACKUP_CONF="${CONF_DIR}/scp_backup.conf"
DIR_SQL="/var/backups/koha_sql"
DIR_MARC="/var/backups/koha_marc"

mkdir -p "$LOG_DIR" "$CONF_DIR" "$DIR_SQL" "$DIR_MARC" 2>/dev/null
log() { printf '%s | %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$RUN_LOG" 2>/dev/null; }
log "===== Painel iniciado (v$PANEL_VERSION, user=$REAL_USER) ====="

# ======================================================================
# 3. SISTEMA DE IDIOMAS (I18N)
# ======================================================================
SYS_LANG=$(echo "${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}" | cut -d'_' -f1 | tr '[:upper:]' '[:lower:]')
t() {
    case "$SYS_LANG" in
        pt) printf '%b' "${1:-}" ;;
        es) printf '%b' "${3:-${2:-}}" ;;
        *)  printf '%b' "${2:-}" ;;
    esac
}

# ======================================================================
# 4. GERENCIADOR DO APT E DEPENDÊNCIAS DO PAINEL
# ======================================================================
APT_OPTS=(-y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -o Acquire::ForceIPv4=true -o Acquire::Check-Valid-Until=false)

wait_for_apt_locks() {
    local wait_time=0
    while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 || fuser /var/lib/dpkg/lock >/dev/null 2>&1; do
        echo "$(t "[INFO] Aguardando liberação do APT/DPKG..." "[INFO] Waiting for APT/DPKG lock..." "[INFO] Esperando liberación de APT/DPKG...")"
        sleep 3
        wait_time=$((wait_time + 3))
        if [ "$wait_time" -ge 120 ]; then
            echo "$(t "[ERRO] APT travado há mais de 2 minutos. Abortando." "[ERROR] APT locked for over 2 minutes. Aborting." "[ERROR] APT bloqueado por más de 2 minutos. Abortando.")"
            return 1
        fi
    done
    dpkg --configure -a >/dev/null 2>&1 || true
    return 0
}

apt_update_indices() {
    wait_for_apt_locks || return 1
    apt-get update -y -o Acquire::ForceIPv4=true >/dev/null 2>&1 || \
    apt-get update -y --fix-missing -o Acquire::ForceIPv4=true >/dev/null 2>&1 || return 1
}

apt_install() {
    wait_for_apt_locks || return 1
    if ! DEBIAN_FRONTEND=noninteractive apt-get install "${APT_OPTS[@]}" "$@" >/dev/null 2>&1; then
        apt_update_indices
        apt-get --fix-broken install "${APT_OPTS[@]}" >/dev/null 2>&1
        DEBIAN_FRONTEND=noninteractive apt-get install "${APT_OPTS[@]}" "$@" >/dev/null 2>&1 || return 1
    fi
}

if ! command -v dialog >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1; then
    echo "$(t "Instalando dependências essenciais do painel..." "Installing essential panel dependencies..." "Instalando dependencias esenciales del panel...")"
    timedatectl set-ntp true >/dev/null 2>&1 || true
    apt_update_indices
    apt_install dialog curl python3 unzip psmisc || exit 1
fi

# ======================================================================
# 5. HELPERS DE INTERFACE VISUAL (DIALOG)
# ======================================================================
msg_info()  { dialog --title "$1" --msgbox "$2" "${3:-12}" "${4:-74}" 2>/dev/null || true; }
msg_error() { log "ERRO: $2"; dialog --title "$(t "Erro" "Error" "Error")" --msgbox "$2" "${3:-14}" "${4:-78}" 2>/dev/null || true; }
msg_ok()    { dialog --title "$(t "Sucesso" "Success" "Éxito")" --msgbox "$1" "${2:-10}" "${3:-74}" 2>/dev/null || true; }
prompt_yes_no() { dialog --title "$1" --yesno "$2" "${3:-12}" "${4:-74}" 2>/dev/null; }

display_explanation() {
    local msg; msg="$(t "$1" "$2" "${3:-}")"
    echo -e "\n+---------------------------------------------------------------------------+"
    echo "| $msg"
    echo "+---------------------------------------------------------------------------+\n"
    log "ETAPA: $msg"
}

run_with_dialog() {
    local title="$1" desc="$2" log_temp="/tmp/koha_action_err.log" rc err_msg
    shift 2
    "$@" >"$log_temp" 2>&1
    rc=$?
    if [ "$rc" -ne 0 ]; then
        err_msg=$(tail -n 15 "$log_temp" 2>/dev/null)
        msg_error "$title" "$(t "Falha em: $desc\n\nCódigo: $rc\nDetalhes:\n$err_msg" "Failed during: $desc\n\nCode: $rc\nDetails:\n$err_msg" "Fallo en: $desc\n\nCódigo: $rc\nDetalles:\n$err_msg")" 20 82
        log "FALHA: $desc (rc=$rc)"
    fi
    rm -f "$log_temp"
    return "$rc"
}

# ======================================================================
# 6. UTILITÁRIOS DE REDE, SISTEMA E BANCO DE DADOS
# ======================================================================
get_server_ip() {
    ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}' || hostname -I | awk '{print $1}'
}

get_ssh_ports() {
    grep -shoriE '^[[:space:]]*Port[[:space:]]+[0-9]+' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null | grep -oE '[0-9]+' | sort -u || echo "22"
}

get_free_space_mb() { df -Pm "${1:-/}" 2>/dev/null | awk 'NR==2{print $4}'; }

is_koha_installed() { [ -f "$KOHA_CONF" ]; }

run_sql() { mysql -N -B -e "$1" 2>/dev/null; }

run_sql_checked() {
    local result rc
    result=$(mysql -N -B -e "$1" 2>/dev/null)
    rc=$?
    [ "$rc" -eq 0 ] && printf '%s' "$result"
    return "$rc"
}

get_database_password() {
    [ -f "$KOHA_CONF" ] && grep -oP '(?<=<pass>)[^<]+' "$KOHA_CONF" 2>/dev/null | head -n 1
}

require_koha() {
    is_koha_installed || { msg_error "" "$(t "O Koha ainda não foi instalado." "Koha is not installed yet." "Koha aún no está instalado.")" 10 72; return 1; }
}

require_database() {
    require_koha || return 1
    run_sql "SELECT 1 FROM information_schema.tables WHERE table_schema='${DB_NAME}' AND table_name='systempreferences' LIMIT 1;" | grep -q 1 || \
    { msg_error "" "$(t "O banco ainda está vazio. Conclua o Web Installer ou restaure um backup." "Database is empty. Finish Web Installer or restore a backup." "La base de datos está vacía. Termine el Web Installer o restaure una copia.")" 11 72; return 1; }
}

sql_escape_literal() {
    printf '%s' "${1:-}" | sed -e 's/\\/\\\\/g' -e "s/'/''/g"
}

# ======================================================================
# 7. MANIPULAÇÃO DE ARQUIVOS AVANÇADA
# ======================================================================
edit_xml() {
    python3 - "$1" "$2" "$KOHA_CONF" "${3:-}" << 'PYEOF'
import re, sys, os
action, tag, path, body = sys.argv[1:5]
with open(path, "r", encoding="utf-8") as f: text = f.read()
parts = re.split(r"(<!--.*?-->)", text, flags=re.DOTALL)
pat = re.compile(r"[ \t]*<%s>.*?</%s>[ \t]*\n?" % (tag, tag), re.DOTALL)
for i, p in enumerate(parts):
    if not p.startswith("<!--"): parts[i] = pat.sub("", p)
text = "".join(parts)
if action == "inserir": text = text.replace("</config>", body + "</config>", 1)
with open(path, "w", encoding="utf-8") as f: f.write(text)
PYEOF
}

set_shell_config_value() {
    local file="$1" key="$2" value="$3"
    touch "$file"
    if grep -q "^[[:space:]]*${key}=" "$file"; then
        sed -i "s|^[[:space:]]*${key}=.*|${key}=\"${value}\"|" "$file"
    else
        echo "${key}=\"${value}\"" >> "$file"
    fi
}

# ======================================================================
# 8. EXPLORADORES DE ARQUIVOS (DIALOG)
# ======================================================================
select_file() {
    local current="${1:-/}" choice items=()
    [ -d "$current" ] || current="/"
    while true; do
        items=()
        [ "$current" != "/" ] && items+=(".." " $(t "[Voltar]" "[Back]" "[Volver]")")
        while IFS= read -r d; do
            [ -n "$d" ] && items+=("$d" " $(t "[Pasta]" "[Folder]" "[Carpeta]")")
        done < <(find "$current" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)
        while IFS= read -r f; do
            [ -n "$f" ] && items+=("$f" " $(t "Backup" "Backup" "Copia")")
        done < <(find "$current" -mindepth 1 -maxdepth 1 -type f \( -name '*.sql' -o -name '*.sql.gz' \) -printf '%f\n' 2>/dev/null | sort)

        [ ${#items[@]} -eq 0 ] && items+=(".." " $(t "[Vazio - Voltar]" "[Empty - Back]" "[Vacío - Volver]")")

        choice=$(dialog --title "$(t "Explorador de Arquivos" "File Explorer" "Explorador de Archivos")" \
            --no-tags --cancel-button "$(t "Voltar" "Back" "Volver")" \
            --menu "$(t "Pasta atual:" "Current folder:" "Carpeta actual:") $current\n\n$(t "Escolha o backup:" "Pick the backup:" "Elija la copia:")" \
            22 76 12 "${items[@]}" 3>&1 1>&2 2>&3) || return 1
        [ -z "$choice" ] && return 1

        if [ "$choice" = ".." ]; then current=$(dirname "$current")
        elif [ -d "$current/$choice" ]; then current="${current%/}/$choice"
        elif [ -f "$current/$choice" ]; then printf '%s' "${current%/}/$choice"; return 0; fi
    done
}

select_directory() {
    local current="${1:-/}" choice dirs=() marker=">>> $(t "SALVAR AQUI" "SAVE HERE" "GUARDAR AQUÍ") <<<"
    [ -d "$current" ] || current="/"
    while true; do
        dirs=("$marker" " $current")
        [ "$current" != "/" ] && dirs+=(".." " $(t "[Voltar]" "[Back]" "[Volver]")")
        while IFS= read -r d; do
            [ -n "$d" ] && dirs+=("$d" " $(t "[Pasta]" "[Folder]" "[Carpeta]")")
        done < <(find "$current" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort)

        choice=$(dialog --title "$(t "Seletor de Pasta" "Folder Picker" "Selector de Carpeta")" \
            --no-tags --cancel-button "$(t "Voltar" "Back" "Volver")" \
            --menu "$(t "Pasta atual:" "Current folder:" "Carpeta actual:") $current" 22 76 12 "${dirs[@]}" 3>&1 1>&2 2>&3) || return 1
        [ -z "$choice" ] && return 1

        if [ "$choice" = "$marker" ]; then printf '%s' "$current"; return 0
        elif [ "$choice" = ".." ]; then current=$(dirname "$current")
        elif [ -d "$current/$choice" ]; then current="${current%/}/$choice"; fi
    done
}

# ======================================================================
# 9. SISTEMA DE VALIDAÇÃO DE INTEGRIDADE (CHECKLIST)
# ======================================================================
VALIDATION_LOG="${LOG_DIR}/validacao-$(date '+%Y%m%d-%H%M%S').log"
V_OK=0; V_WARN=0; V_FAIL=0

v_reset() {
    V_OK=0; V_WARN=0; V_FAIL=0
    VALIDATION_LOG="${LOG_DIR}/validacao-$(date '+%Y%m%d-%H%M%S').log"
    {
        echo "======================================================================"
        echo "KOHA EASY INSTALL & Tools - RELATÓRIO DE VALIDAÇÃO"
        echo "Contexto: ${1:-geral} | Data: $(date '+%Y-%m-%d %H:%M:%S')"
        echo "======================================================================"
    } > "$VALIDATION_LOG"
}

v_ok()   { V_OK=$((V_OK+1));      printf '[ OK ] %s\n' "$1" | tee -a "$VALIDATION_LOG"; }
v_warn() { V_WARN=$((V_WARN+1));  printf '[AVISO] %s\n' "$1" | tee -a "$VALIDATION_LOG"; }
v_fail() { V_FAIL=$((V_FAIL+1));  printf '[FALHA] %s\n' "$1" | tee -a "$VALIDATION_LOG"; }
v_info() { printf '[INFO] %s\n' "$1" | tee -a "$VALIDATION_LOG"; }

validate_service() {
    local s="$1" d="$2"
    if ! systemctl cat "$s" >/dev/null 2>&1; then v_fail "$d: $(t "serviço não instalado" "service not installed" "servicio no instalado") ($s)."; return 1; fi
    systemctl is-active --quiet "$s" && v_ok "$d: $(t "ativo" "active" "activo") ($s)." || { v_fail "$d: INATIVO ($s)."; return 1; }
}

validate_http() {
    local code; code=$(curl -sS -L --max-time 5 -o /dev/null -w '%{http_code}' "$1" 2>/dev/null)
    if [[ "$code" =~ ^[23][0-9][0-9]$ ]]; then v_ok "$2: HTTP $code."; return 0; fi
    v_fail "$2: HTTP ${code:-$(t "sem resposta" "no response" "sin respuesta")} ($1)."; return 1
}

validate_mariadb() {
    if ! mysql -Nse 'SELECT 1;' >/dev/null 2>&1; then v_fail "MariaDB: $(t "conexão falhou" "connection failed" "conexión fallida")."; return 1; fi
    local c; c=$(run_sql_checked "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${DB_NAME}';") || return 1
    [ "$c" -ge 150 ] 2>/dev/null && v_ok "${DB_NAME}: $c $(t "tabelas" "tables" "tablas")." || v_warn "${DB_NAME}: $(t "apenas" "only" "solo") $c $(t "tabelas" "tables" "tablas")."
}

show_validation_report() {
    [ -f "$VALIDATION_LOG" ] && dialog --title "$(t "Relatório" "Report" "Informe")" --scrolltext --textbox "$VALIDATION_LOG" 30 100 2>/dev/null || true
}

# ======================================================================
# 10. INFRAESTRUTURA DE MOTOR DE BUSCA (ZEBRA E ELASTICSEARCH)
# ======================================================================
get_search_engine() { run_sql "SELECT value FROM ${DB_NAME}.systempreferences WHERE variable='SearchEngine' LIMIT 1;"; }
set_search_engine() { mysql -e "UPDATE ${DB_NAME}.systempreferences SET value='${1}' WHERE variable='SearchEngine';" >/dev/null 2>&1; }

set_xml_elasticsearch() {
    local action="$1" body="" xml_backup
    [ -f "$KOHA_CONF" ] || return 1
    xml_backup="${KOHA_CONF}.bak-es-$$"
    cp -p "$KOHA_CONF" "$xml_backup" || return 1

    [ "$action" = "inserir" ] && body=$(printf '  <elasticsearch>\n    <server>127.0.0.1:9200</server>\n    <index_name>%s</index_name>\n  </elasticsearch>\n' "${DB_NAME}")
    
    if ! edit_xml "$action" "elasticsearch" "$body"; then
        cp -p "$xml_backup" "$KOHA_CONF"; rm -f "$xml_backup"; return 1
    fi

    if command -v xmllint >/dev/null 2>&1 && ! xmllint --noout "$KOHA_CONF" >/dev/null 2>&1; then
        cp -p "$xml_backup" "$KOHA_CONF"; rm -f "$xml_backup"
        log "FALHA: Edição do Elasticsearch corrompeu o XML. Rollback automático."
        return 1
    fi
    rm -f "$xml_backup"; return 0
}

is_koha_es_active_in_xml() {
    [ -f "$KOHA_CONF" ] || return 1
    grep -q "<elasticsearch>" "$KOHA_CONF" 2>/dev/null && return 0
    return 1
}

prepare_koha_broker() {
    if dpkg -s rabbitmq-server >/dev/null 2>&1 && rabbitmq-plugins enable rabbitmq_stomp >/dev/null 2>&1 && systemctl start rabbitmq-server >/dev/null 2>&1; then
        mysql -e "UPDATE ${DB_NAME}.systempreferences SET value='STOMP' WHERE variable='JobsNotificationMethod';" >/dev/null 2>&1
        return 0
    fi
    mysql -e "UPDATE ${DB_NAME}.systempreferences SET value='polling' WHERE variable='JobsNotificationMethod';" >/dev/null 2>&1
    return 0
}

is_koha_indexer_running() {
    systemctl is-active --quiet "koha-es-indexer@${INSTANCE}" && return 0
    pgrep -af '[e]s_indexer_daemon' | grep -Fq "$INSTANCE" && return 0
    return 1
}

manage_koha_indexers() {
    if [ "$1" = "start" ]; then
        koha-worker --start "$INSTANCE" >/dev/null 2>&1 || true
        koha-worker --start --queue long_tasks "$INSTANCE" >/dev/null 2>&1 || true
        if is_koha_es_active_in_xml; then
            install_koha_indexer_service || return 1
            systemctl restart "koha-es-indexer@${INSTANCE}" >/dev/null 2>&1 || \
            /usr/sbin/koha-es-indexer --start --quiet "$INSTANCE" >/dev/null 2>&1 || true
        fi
        return 0
    fi
    systemctl disable --now "koha-es-indexer@${INSTANCE}" >/dev/null 2>&1 || true
    koha-es-indexer --stop --quiet "$INSTANCE" >/dev/null 2>&1 || true
    rm -f "$CRON_ES"; systemctl restart cron >/dev/null 2>&1 || true
}

install_koha_indexer_service() {
    local unit="/etc/systemd/system/koha-es-indexer@.service"
    if [ ! -f "$unit" ]; then
        cat > "$unit" << 'EOF'
[Unit]
Description=Koha Elasticsearch indexer supervisor (%i)
After=network-online.target mariadb.service elasticsearch.service memcached.service
[Service]
Type=simple
ExecStart=/bin/bash -c 'set -u; inst="$1"; /usr/sbin/koha-es-indexer --start --quiet "$inst" || exit 1; while pgrep -af "es_indexer_daemon" | grep -q "$inst"; do sleep 5; done; exit 1' _ %i
ExecStop=/usr/sbin/koha-es-indexer --stop --quiet %i
Restart=always
RestartSec=10
[Install]
WantedBy=multi-user.target
EOF
        systemctl daemon-reload
    fi

    cat > /usr/local/bin/koha-es-watchdog.sh << EOF
#!/bin/bash
if ! curl -sS --max-time 5 http://127.0.0.1:9200/ >/dev/null 2>&1; then exit 0; fi
PEND=\$(mysql -Nse "SELECT COUNT(*) FROM ${DB_NAME}.background_jobs WHERE type='update_elastic_index' AND status IN ('new','started') AND enqueued_on < DATE_SUB(NOW(), INTERVAL 5 MINUTE);" 2>/dev/null)
if [[ "\$PEND" =~ ^[0-9]+$ ]] && [ "\$PEND" -gt 0 ]; then
    systemctl restart koha-es-indexer@${INSTANCE} >/dev/null 2>&1 || /usr/sbin/koha-es-indexer --restart --quiet ${INSTANCE} >/dev/null 2>&1
fi
EOF
    chmod 755 /usr/local/bin/koha-es-watchdog.sh
    echo -e "$CRON_PATH\n*/5 * * * * root /usr/local/bin/koha-es-watchdog.sh >/dev/null 2>&1" > "$CRON_ES"
    chmod 644 "$CRON_ES"; systemctl restart cron >/dev/null 2>&1
}

force_stop_koha_zebra() {
    local pidfile="/var/run/koha/${INSTANCE}/zebrasrv.pid" pid
    [ -r "$pidfile" ] && pid=$(cat "$pidfile" 2>/dev/null)
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" >/dev/null 2>&1 || kill -9 "$pid" >/dev/null 2>&1 || true
    fi
}

clear_orphan_jobs() {
    mysql -e "UPDATE ${DB_NAME}.background_jobs SET status='cancelled' WHERE type='update_elastic_index' AND status IN ('new','started') AND enqueued_on < '${1}';" >/dev/null 2>&1
}

ES_REBUILD_LOCK_FILE="/var/lock/koha_es_rebuild.lock"
rebuild_koha_elasticsearch() {
    local cut_time="${1:-$(date '+%Y-%m-%d %H:%M:%S')}" rc
    (
        exec 7>"$ES_REBUILD_LOCK_FILE"
        flock -n 7 || exit 75
        command -v koha-elasticsearch >/dev/null 2>&1 || exit 1
        koha-elasticsearch --rebuild -d "$INSTANCE"
    )
    rc=$?
    if [ "$rc" -eq 0 ]; then clear_orphan_jobs "$cut_time"
    elif [ "$rc" -eq 75 ]; then msg_info "$(t "Em andamento" "Running" "En curso")" "$(t "Reindexação em andamento." "Reindex in progress." "Reindexación en curso.")" 9 72; fi
    return "$rc"
}

ensure_elasticsearch_repository() {
    local arch candidate
    arch=$(dpkg --print-architecture 2>/dev/null || true)
    case "$arch" in amd64|arm64) ;; *) return 1 ;; esac
    
    mkdir -p /usr/share/keyrings || return 1
    if [ ! -s /usr/share/keyrings/elasticsearch-keyring.gpg ]; then
        curl -fsSL --retry 3 --max-time 60 https://artifacts.elastic.co/GPG-KEY-elasticsearch | gpg --dearmor --yes -o /usr/share/keyrings/elasticsearch-keyring.gpg 2>/dev/null || return 1
        chmod 644 /usr/share/keyrings/elasticsearch-keyring.gpg
    fi
    
    echo "deb [signed-by=/usr/share/keyrings/elasticsearch-keyring.gpg] https://artifacts.elastic.co/packages/7.x/apt stable main" > /etc/apt/sources.list.d/elastic-7.x.list
    apt_update_indices || { rm -f /etc/apt/sources.list.d/elastic-7.x.list; return 1; }
    
    candidate=$(apt-cache policy elasticsearch 2>/dev/null | awk '/Candidate:/ {print $2; exit}')
    local koha_candidate; koha_candidate=$(apt-cache policy koha-elasticsearch 2>/dev/null | awk '/Candidate:/ {print $2; exit}')
    
    if [ -z "$candidate" ] || [ "$candidate" = "(none)" ] || [ -z "$koha_candidate" ] || [ "$koha_candidate" = "(none)" ]; then return 1; fi
    return 0
}

adjust_elasticsearch_heap() {
    local ram_mb heap cfg tmp
    ram_mb=$(awk '/MemTotal:/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null)
    if   [ "${ram_mb:-0}" -ge 16384 ]; then heap="4g"
    elif [ "${ram_mb:-0}" -ge 8192 ];  then heap="2g"
    elif [ "${ram_mb:-0}" -ge 4096 ];  then heap="1g"
    else heap="512m"; fi
    
    mkdir -p /etc/elasticsearch/jvm.options.d || return 1
    cfg="/etc/elasticsearch/jvm.options.d/koha.options"
    tmp=$(mktemp "${cfg}.tmp.XXXXXX") || return 1
    
    printf -- '-Xms%s\n-Xmx%s\n' "$heap" "$heap" > "$tmp" || { rm -f "$tmp"; return 1; }
    chmod 644 "$tmp"; mv -f "$tmp" "$cfg" || { rm -f "$tmp"; return 1; }
    log "ES heap ajustado = $heap (RAM Livre: ${ram_mb}MB)"
}

