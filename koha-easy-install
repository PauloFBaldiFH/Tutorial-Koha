            "2" " 2. $(t "Publicar apenas OPAC" "Publish only OPAC" "Publicar solo OPAC")" \
            "3" " 3. $(t "Publicar apenas Staff" "Publish only Staff" "Publicar solo Staff")" \
            "4" " 4. $(t "Ver status atual" "View current status" "Ver estado actual")" \
            "5" " 5. $(t "Desativar tudo" "Disable all" "Desactivar todo")" 3>&1 1>&2 2>&3) || break
        
        case "$choice" in
            1) clear; tailscale funnel --bg 80 >/dev/null 2>&1; tailscale funnel --bg --https=8443 8080 >/dev/null 2>&1; mostrar_links_tailscale ;;
            2) clear; tailscale funnel --bg 80 >/dev/null 2>&1; mostrar_links_tailscale ;;
            3) clear; tailscale funnel --bg --https=8443 8080 >/dev/null 2>&1; mostrar_links_tailscale ;;
            4) clear; mostrar_links_tailscale ;;
            5) clear; tailscale funnel off >/dev/null 2>&1; msg_ok "$(t "Funnels desativados." "Funnels disabled." "Funnels desactivados.")" 8 60 ;;
        esac
